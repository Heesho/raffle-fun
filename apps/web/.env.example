# Base Sepolia by default. Every supplied value is validated at startup.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Leave unset until a network-specific subgraph has been deployed.
NEXT_PUBLIC_SUBGRAPH_URL=

# Optional. The default wallet experience uses injected EIP-1193 wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Sample raffles for design review: "auto" (default) shows them only while no
# subgraph is configured, "on" forces them, "off" never substitutes sample data.
NEXT_PUBLIC_DEMO_MODE=auto
