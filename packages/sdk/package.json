{
  "name": "@raffle-fun/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sync": "tsx scripts/sync-artifacts.ts",
    "sync:check": "tsx scripts/sync-artifacts.ts --check",
    "build": "pnpm sync:check && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@raffle-fun/config": "workspace:*",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
