{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raffle Fun deployment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chainId",
    "networkName",
    "deployedAt",
    "validationBlock",
    "validationBlockHash",
    "deploymentTransactions",
    "runtimeCodeHashes",
    "deployer",
    "finalFactoryOwner",
    "quoteToken",
    "vrfWrapper",
    "raffleFactory",
    "raffleImplementation",
    "protocolTreasury",
    "callbackGasLimit",
    "requestConfirmations",
    "sourceCommit",
    "verificationStatus"
  ],
  "properties": {
    "chainId": { "type": "integer", "enum": [1, 11155111] },
    "networkName": {
      "type": "string",
      "enum": ["mainnet", "sepolia"]
    },
    "deployedAt": { "type": "string", "format": "date-time" },
    "validationBlock": { "type": "integer", "minimum": 1 },
    "validationBlockHash": { "$ref": "#/$defs/bytes32" },
    "deploymentTransactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raffleFactory"],
      "properties": {
        "raffleFactory": { "$ref": "#/$defs/deploymentTransaction" }
      }
    },
    "runtimeCodeHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quoteToken",
        "vrfWrapper",
        "raffleFactory",
        "raffleImplementation"
      ],
      "properties": {
        "quoteToken": { "$ref": "#/$defs/bytes32" },
        "vrfWrapper": { "$ref": "#/$defs/bytes32" },
        "raffleFactory": { "$ref": "#/$defs/bytes32" },
        "raffleImplementation": { "$ref": "#/$defs/bytes32" }
      }
    },
    "deployer": { "$ref": "#/$defs/address" },
    "finalFactoryOwner": { "$ref": "#/$defs/address" },
    "quoteToken": { "$ref": "#/$defs/address" },
    "vrfWrapper": { "$ref": "#/$defs/address" },
    "raffleFactory": { "$ref": "#/$defs/address" },
    "raffleImplementation": { "$ref": "#/$defs/address" },
    "protocolTreasury": { "$ref": "#/$defs/address" },
    "callbackGasLimit": {
      "type": "integer",
      "const": 300000
    },
    "requestConfirmations": {
      "type": "integer",
      "const": 30
    },
    "sourceCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "verificationStatus": {
      "type": "string",
      "const": "verified"
    }
  },
  "$defs": {
    "deploymentTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "blockNumber"],
      "properties": {
        "hash": { "$ref": "#/$defs/bytes32" },
        "blockNumber": { "type": "integer", "minimum": 1 }
      }
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "not": { "const": "0x0000000000000000000000000000000000000000" }
    }
  }
}
