digraph "vars_and_auth_map" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, ranksep=2.2, nodesep=0.12,
         label="raffle.fun Raffle — Slither vars-and-auth: which entry point writes which state variable (incl. internal calls)\nedge colour = writer · node note = msg.sender condition reported by the printer (none = permissionless)"];
  node [fontname="Helvetica", fontsize=10];
  edge [arrowsize=0.6];
  subgraph "cluster_f" { label="Raffle entry points (and constructor)"; style=rounded; color="#6b7280";
    "F_initialize" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#1f77b4", penwidth=2, label="initialize()\nmsg.sender != factory → revert"];
    "F_onERC721Received" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#d62728", penwidth=2, label="onERC721Received()\nstatus/msg.sender/tokenId/from/operator exact match"];
    "F_buyEntries" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#2ca02c", penwidth=2, label="buyEntries()\nno msg.sender condition (permissionless)"];
    "F_requestDraw" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#9467bd", penwidth=2, label="requestDraw()\nno msg.sender condition (permissionless)"];
    "F_rawFulfillRandomWords" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#8c564b", penwidth=2, label="rawFulfillRandomWords()\nmsg.sender != vrfWrapperAddr → revert"];
    "F_enableRefunds" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#e377c2", penwidth=2, label="enableRefunds()\nmsg.sender != sponsor && now < deadline → revert"];
    "F_settleWinningTicket" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#7f7f7f", penwidth=2, label="settleWinningTicket()\nno msg.sender condition (permissionless)"];
    "F_redeemWinningTicket" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#bcbd22", penwidth=2, label="redeemWinningTicket()\nmsg.sender != winner → revert"];
    "F_refundTickets" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#17becf", penwidth=2, label="refundTickets()\nmsg.sender != owner → revert"];
    "F_releaseSponsorProceeds" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#ff7f0e", penwidth=2, label="releaseSponsorProceeds()\nno msg.sender condition (permissionless)"];
    "F_releaseProtocolFees" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#393b79", penwidth=2, label="releaseProtocolFees()\nno msg.sender condition (permissionless)"];
    "F_releaseSponsorPrize" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#637939", penwidth=2, label="releaseSponsorPrize()\nno msg.sender condition (permissionless)"];
    "F_transferFrom" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#8c6d31", penwidth=2, label="transferFrom()\nERC-721 auth via _checkAuthorized/_approve (not a msg.sender == X test)"];
    "F_safeTransferFrom" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#843c39", penwidth=2, label="safeTransferFrom()\nERC-721 auth via _checkAuthorized/_approve (not a msg.sender == X test)"];
    "F_approve" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#7b4173", penwidth=2, label="approve()\nERC-721 auth via _checkAuthorized/_approve (not a msg.sender == X test)"];
    "F_setApprovalForAll" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#3182bd", penwidth=2, label="setApprovalForAll()\nERC-721 auth via _checkAuthorized/_approve (not a msg.sender == X test)"];
    "F_constructor" [shape=box, style="rounded,filled", fillcolor="#f9fafb", color="#636363", penwidth=2, label="constructor()\nimplementation only (clones never run it)"];
  }
  subgraph "cluster_g0" { label="Per-raffle configuration (write-once in initialize)"; style=filled; fillcolor="#f3f4f6"; color="#9ca3af";
    "V_sponsor" [shape=ellipse, style=filled, fillcolor=white, label="sponsor"];
    "V_sponsorRecipient" [shape=ellipse, style=filled, fillcolor=white, label="sponsorRecipient"];
    "V_protocolTreasury" [shape=ellipse, style=filled, fillcolor=white, label="protocolTreasury"];
    "V_prizeToken" [shape=ellipse, style=filled, fillcolor=white, label="prizeToken"];
    "V_prizeTokenId" [shape=ellipse, style=filled, fillcolor=white, label="prizeTokenId"];
    "V_raffleId" [shape=ellipse, style=filled, fillcolor=white, label="raffleId"];
    "V_reserveEntries" [shape=ellipse, style=filled, fillcolor=white, label="reserveEntries"];
    "V_endTime" [shape=ellipse, style=filled, fillcolor=white, label="endTime"];
    "V_initialized" [shape=ellipse, style=filled, fillcolor=white, label="initialized"];
  }
  subgraph "cluster_g1" { label="Lifecycle and one-shot flags"; style=filled; fillcolor="#f3f4f6"; color="#9ca3af";
    "V_status" [shape=ellipse, style=filled, fillcolor=white, label="status"];
    "V_settlementComplete" [shape=ellipse, style=filled, fillcolor=white, label="settlementComplete"];
    "V_winnerRedeemed" [shape=ellipse, style=filled, fillcolor=white, label="winnerRedeemed"];
    "V_prizeClaimed" [shape=ellipse, style=filled, fillcolor=white, label="prizeClaimed"];
    "V_winnerRecipient" [shape=ellipse, style=filled, fillcolor=white, label="winnerRecipient"];
    "V_winningTicketId" [shape=ellipse, style=filled, fillcolor=white, label="winningTicketId"];
  }
  subgraph "cluster_g2" { label="USDC accounting buckets"; style=filled; fillcolor="#f3f4f6"; color="#9ca3af";
    "V_unsettledPot" [shape=ellipse, style=filled, fillcolor=white, label="unsettledPot"];
    "V_remainingRefundLiability" [shape=ellipse, style=filled, fillcolor=white, label="remainingRefundLiability"];
    "V_winnerProceeds" [shape=ellipse, style=filled, fillcolor=white, label="winnerProceeds"];
    "V_sponsorProceeds" [shape=ellipse, style=filled, fillcolor=white, label="sponsorProceeds"];
    "V_protocolFees" [shape=ellipse, style=filled, fillcolor=white, label="protocolFees"];
  }
  subgraph "cluster_g3" { label="Draw / VRF"; style=filled; fillcolor="#f3f4f6"; color="#9ca3af";
    "V_vrfRequestId" [shape=ellipse, style=filled, fillcolor=white, label="vrfRequestId"];
    "V_drawRequestedAt" [shape=ellipse, style=filled, fillcolor=white, label="drawRequestedAt"];
    "V__requestInFlight" [shape=ellipse, style=filled, fillcolor=white, label="_requestInFlight"];
    "V_resolvedAt" [shape=ellipse, style=filled, fillcolor=white, label="resolvedAt"];
    "V_winningEntry" [shape=ellipse, style=filled, fillcolor=white, label="winningEntry"];
  }
  subgraph "cluster_g4" { label="Ticket ledger (ERC-721 + ranges)"; style=filled; fillcolor="#f3f4f6"; color="#9ca3af";
    "V_totalEntries" [shape=ellipse, style=filled, fillcolor=white, label="totalEntries"];
    "V_ticketCount" [shape=ellipse, style=filled, fillcolor=white, label="ticketCount"];
    "V__ticketRanges" [shape=ellipse, style=filled, fillcolor=white, label="_ticketRanges"];
    "V__owners" [shape=ellipse, style=filled, fillcolor=white, label="_owners"];
    "V__balances" [shape=ellipse, style=filled, fillcolor=white, label="_balances"];
    "V__tokenApprovals" [shape=ellipse, style=filled, fillcolor=white, label="_tokenApprovals"];
    "V__operatorApprovals" [shape=ellipse, style=filled, fillcolor=white, label="_operatorApprovals"];
  }
  "F_initialize" -> "V_endTime" [color="#1f77b4"];
  "F_initialize" -> "V_initialized" [color="#1f77b4"];
  "F_initialize" -> "V_prizeToken" [color="#1f77b4"];
  "F_initialize" -> "V_prizeTokenId" [color="#1f77b4"];
