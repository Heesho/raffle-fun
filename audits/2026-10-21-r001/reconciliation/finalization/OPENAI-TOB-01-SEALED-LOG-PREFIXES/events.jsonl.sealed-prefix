h per-function depth, most important first.\",\n          \"items\": {\n            \"type\": \"object\",\n            \"required\": [\n              \"name\",\n              \"file\",\n              \"why\"\n            ],\n            \"properties\": {\n              \"name\": {\n                \"type\": \"string\"\n              },\n              \"file\": {\n                \"type\": \"string\"\n              },\n              \"why\": {\n                \"type\": \"string\",\n                \"description\": \"why this one needs depth, in one line\"\n              }\n            }\n          }\n        },\n        \"language\": {\n          \"type\": \"string\",\n          \"description\": \"primary language of the codebase\"\n        }\n      }\n    },\n    \"label\": \"orient\",\n    \"phase\": \"Orient\"\n  },\n  \"accepted_model\": \"gpt-6-astra\",\n  \"accepted_effort\": \"ultra\",\n  \"provider_returned_model\": \"unknown\",\n  \"provider_returned_effort\": \"unknown\",\n  \"fallback_enabled\": false\n}","exit_code":0,"status":"completed"}}
