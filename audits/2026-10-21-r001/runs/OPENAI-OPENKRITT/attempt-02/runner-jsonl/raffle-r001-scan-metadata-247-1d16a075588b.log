ess because the constructor\npackages/contracts/src/RaffleFactory.sol-61-    ///      cannot prove token identity from metadata.\npackages/contracts/src/RaffleFactory.sol-62-    /// @param quoteToken_ Target chain's official six-decimal USDC contract trusted by every raffle.\npackages/contracts/src/RaffleFactory.sol-63-    /// @param vrfWrapper_ Official Chainlink VRF v2.5 native direct-funding wrapper for the target chain.\n--\npackages/contracts/src/RaffleFactory.sol-84-\npackages/contracts/src/RaffleFactory.sol-85-        quoteToken = quoteToken_;\npackages/contracts/src/RaffleFactory.sol-86-        vrfWrapper = vrfWrapper_;\npackages/contracts/src/RaffleFactory.sol-87-        protocolTreasury = protocolTreasury_;\npackages/contracts/src/RaffleFactory.sol-88-\npackages/contracts/src/RaffleFactory.sol:89:        address implementation = address(new Raffle(quoteToken_, vrfWrapper_));\npackages/contracts/src/RaffleFactory.sol:90:        if (protocolTreasury_ == implementation) revert UnsafeProtocolDestination(protocolTreasury_);\npackages/contracts/src/RaffleFactory.sol:91:        raffleImplementation = implementation;\npackages/contracts/src/RaffleFactory.sol-92-    }\npackages/contracts/src/RaffleFactory.sol-93-\npackages/contracts/src/RaffleFactory.sol-94-    // External state-changing functions\npackages/contracts/src/RaffleFactory.sol-95-\npackages/contracts/src/RaffleFactory.sol-96-    /// @inheritdoc IRaffleFactory\n--\npackages/contracts/src/RaffleFactory.sol-101-        uint256 saleDuration = uint256(params.endTime) - currentTime;\npackages/contracts/src/RaffleFactory.sol-102-        if (saleDuration > RaffleConstants.MAX_SALE_DURATION) {\npackages/contracts/src/RaffleFactory.sol-103-            revert SaleDurationTooLong(saleDuration, RaffleConstants.MAX_SALE_DURATION);\npackages/contracts/src/RaffleFactory.sol-104-        }\npackages/contracts/src/RaffleFactory.sol-105-        uint256 raffleId = ++raffleCount;\npackages/contracts/src/RaffleFactory.sol:106