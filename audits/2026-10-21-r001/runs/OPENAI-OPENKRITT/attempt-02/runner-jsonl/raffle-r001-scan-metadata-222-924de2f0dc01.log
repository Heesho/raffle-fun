les/@openzeppelin/contracts/utils/introspection/IERC165.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/StorageSlot.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/math/SignedMath.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/math/Math.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/math/SafeCast.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Bytes.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Create2.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Context.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Strings.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/LowLevelCall.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC20.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/draft-IERC6093.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC1363.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC165.sol\npackages/contracts/package.json\npackages/contracts/remappings.txt\npackages/contracts/hardhat.config.ts\npackages/contracts/src/libraries/RaffleConstants.sol\npackages/contracts/src/RaffleFactory.sol\npackages/contracts/src/interfaces/IRaffle.sol\npackages/contracts/src/interfaces/IRaffleFactory.sol\npackages/contracts/src/Raffle.sol\nDESIGN.md\n[profile.default]\nsrc = \"src\"\ntest = \"test/foundry\"\nscript = \"script\"\nout = \"out\"\nlibs = [\"lib\", \"node_modules\"]\nsolc_version = \"0.8.36\"\nevm_version = \"cancun\"\noptimizer = true\noptimizer_runs = 200\nvia_ir = false\nfuzz = { runs = 1_000, seed = \"0x524146464c45\" }\ninvariant = { runs = 256, depth = 64, fail_on_revert = false }\ngas_reports = [\"Raffle\", \"RaffleFactory\"]\n\n[profile.ci]\nfuzz = { runs = 10_000 }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit]\nfuzz = { runs = 100_000, seed = \"0x41554449545f46555a5a\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit_strict]\nfuzz = { runs = 10_000, seed = \"0x41554449545f535452494354\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = true }\n\n[profile.audit_release]\nfuzz = { runs = 100_000, seed = \"0x52454c454153455f43414d504149474e\" }\ninvariant = { runs = 5_000, depth = 512, fail_on_revert = true, timeout = 3_600 }\n\n[profile.coverage]\nvia_ir = false\noptimizer = false\n\n[profile.comparison]\nvia_ir = true\noptimizer = true\noptimizer_runs = 1_000\n\n[fmt]\nline_length = 120\ntab_width = 4\nbracket_spacing = true\nint_types = \"long\"\nquote_style = \"double\"\nnumber_underscore = \"thousands\"\nsort_imports = true\n{\n  \"name\": \"@raffle-fun/contracts\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.13 <23\"\n  },\n  \"scripts\": {\n    \"build\": \"hardhat compile && forge build\",\n    \"compile\": \"hardhat compile\",\n    \"test\": \"pnpm test:foundry && pnpm test:hardhat\",\n    \"test:foundry\": \"forge test\",\n    \"test:hardhat\": \"hardhat test nodejs\",\n    \"coverage\": \"forge coverage --report lcov --no-match-coverage '^(script/|src/mocks/|test/)' && node scripts/check-coverage.mjs\",\n    \"gas\": \"forge snapshot --check -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"gas:update\": \"forge snapshot -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"fmt\": \"forge fmt\",\n    \"fmt:check\": \"forge fmt --check\",\n    \"lint\": \"solhint 'src/**/*.sol' 'test/**/*.sol'\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"slither\": \"slither . --config-file slither.config.json\",\n    \"deploy:sepolia\": \"hardhat ignition deploy ignition/modules/RaffleFun.ts --network sepolia\",\n    \"verify:sepolia\": \"hardhat ignition verify chain-11155111\",\n    \"deployment:write\": \"tsx scripts/write-deployment.ts\"\n  },\n  \"dependencies\": {\n    \"@chainlink/contracts\": \"1.5.0\",\n    \"@openzeppelin/contracts\": \"5.6.1\"\n  },\n  \"devDependencies\": {\n    \"@nomicfoundation/hardhat-ignition\": \"3.1.8\",\n    \"@nomicfoundation/hardhat-ignition-viem\": \"3.1.6\",\n    \"@nomicfoundation/hardhat-toolbox-viem\": \"5.0.7\",\n    \"@types/node\": \"26.1.2\",\n    \"dotenv\": \"17.4.2\",\n    \"hardhat\": \"3.11.1\",\n    \"solhint\": \"6.2.3\",\n    \"tsx\": \"4.23.1\",\n    \"typescript\": \"6.0.3\",\n    \"viem\": \"2.55.10\",\n    \"zod\": \"4.4.3\"\n  }\n}\n","exit_code":0,"status":"completed"}}
