   33\t        return clone(implementation, 0);\n    34\t    }\n    35\t\n    36\t    /**\n    37\t     * @dev Same as {xref-Clones-clone-address-}[clone], but with a `value` parameter to send native currency\n    38\t     * to the new contract.\n    39\t     *\n    40\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    41\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    42\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    43\t     *\n    44\t     * NOTE: Using a non-zero value at creation will require the contract using this function (e.g. a factory)\n    45\t     * to always have enough balance for new deployments. Consider exposing this function under a payable method.\n    46\t     */\n    47\t    function clone(address implementation, uint256 value) internal returns (address instance) {\n    48\t        if (address(this).balance < value) {\n    49\t            revert Errors.InsufficientBalance(address(this).balance, value);\n    50\t        }\n    51\t        assembly (\"memory-safe\") {\n    52\t            // Cleans the upper 96 bits of the `implementation` word, then packs the first 3 bytes\n    53\t            // of the `implementation` address with the bytecode before the address.\n    54\t            mstore(0x00, or(shr(232, shl(96, implementation)), 0x3d602d80600a3d3981f3363d3d373d3d3d363d73000000))\n    55\t            // Packs the remaining 17 bytes of `implementation` with the bytecode after the address.\n    56\t            mstore(0x20, or(shl(120, implementation), 0x5af43d82803e903d91602b57fd5bf3))\n    57\t            instance := create(value, 0x09, 0x37)\n    58\t        }\n    59\t        if (instance == address(0)) {\n    60\t            revert Errors.FailedDeployment();\n    61\t        }\n    62\t    }\n    63\t\n    64\t    /**\n    65\t     * @dev De