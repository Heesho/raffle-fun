es/IRaffle.sol:173:    /// @notice Emitted when the escrowed prize is returned after a cash result or refund transition.\npackages/contracts/src/interfaces/IRaffle.sol:220:    /// @notice Raised when a refund batch is empty or exceeds the bounded ticket limit.\npackages/contracts/src/interfaces/IRaffle.sol:222:    /// @param maximum Maximum ticket IDs accepted per refund transaction.\npackages/contracts/src/interfaces/IRaffle.sol:242:    /// @notice Raised when refunds are requested before the applicable liveness deadline.\npackages/contracts/src/interfaces/IRaffle.sol:243:    /// @param deadline Unix timestamp, in seconds, at which refunds become available.\npackages/contracts/src/interfaces/IRaffle.sol:253:    /// @param recipient Draw requester that was due the refund.\npackages/contracts/src/interfaces/IRaffle.sol:308:    function initialize(RaffleInitParams calldata params) external;\npackages/contracts/src/interfaces/IRaffle.sol:314:    function buyEntries(address recipient, uint128 entryCount) external returns (uint256 ticketId);\npackages/contracts/src/interfaces/IRaffle.sol:320:    function requestDraw() external payable returns (uint256 requestId);\npackages/contracts/src/interfaces/IRaffle.sol:322:    /// @notice Enables full refunds after the sold-raffle request deadline or an accepted request's callback deadline.\npackages/contracts/src/interfaces/IRaffle.sol:324:    function enableRefunds() external;\npackages/contracts/src/interfaces/IRaffle.sol:331:    function settleWinningTicket(uint256 ticketId) external returns (uint256 cashAmount);\npackages/contracts/src/interfaces/IRaffle.sol:338:    function redeemWinningTicket(uint256 ticketId) external returns (uint256 cashAmount);\npackages/contracts/src/interfaces/IRaffle.sol:342:    /// @param ticketIds Ticket IDs owned by the caller and submitted for refund.\npackages/contracts/src/interfaces/IRaffle.sol:344:    function refundTickets(uint256[] calldata ticketIds) external returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol:348:    function releaseSponsorProceeds() external returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol:352:    function releaseProtocolFees() external returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol:355:    function releaseSponsorPrize() external;\npackages/contracts/src/interfaces/IRaffle.sol:361:    function getVrfRequestPrice() external view returns (uint256 fee);\npackages/contracts/src/interfaces/IRaffle.sol:366:    function estimateVrfRequestPrice(uint256 requestGasPriceWei) external view returns (uint256 fee);\npackages/contracts/src/interfaces/IRaffle.sol:373:    function ticketRange(uint256 ticketId) external view returns (uint128 firstEntry, uint128 lastEntry);\npackages/contracts/src/interfaces/IRaffle.sol:377:    function drawRequestDeadline() external view returns (uint256 deadline);\npackages/contracts/src/interfaces/IRaffle.sol:381:    function callbackDeadline() external view returns (uint256 deadline);\npackages/contracts/src/interfaces/IRaffle.sol:384:    /// @return amount Raw six-decimal quote-token units across the unsettled pot, refunds, and allocated claims.\npackages/contracts/src/interfaces/IRaffle.sol:385:    function accountedQuoteBalance() external view returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol:390:    function grossSales() external view returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol:396:    function ENTRY_PRICE() external view returns (uint256 price);\npackages/contracts/src/interfaces/IRaffle.sol:400:    function callbackGasLimit() external view returns (uint32 gasLimit);\npackages/contracts/src/interfaces/IRaffle.sol:404:    function requestConfirmations() external view returns (uint16 confirmations);\npackages/contracts/src/interfaces/IRaffle.sol:408:    function factory() external view returns (address factoryAddress);\npackages/contracts/src/interfaces/IRaffle.sol:410:    /// @notice Retur