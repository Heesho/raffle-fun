zeppelin/contracts/utils/math/SignedMath.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/math/Math.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/math/SafeCast.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Bytes.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Create2.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Context.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Strings.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/LowLevelCall.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC20.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/draft-IERC6093.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC1363.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC165.sol\npackages/contracts/package.json\npackages/contracts/remappings.txt\npackages/contracts/hardhat.config.ts\npackages/contracts/src/libraries/RaffleConstants.sol\npackages/contracts/src/RaffleFactory.sol\npackages/contracts/src/interfaces/IRaffle.sol\npackages/contracts/src/interfaces/IRaffleFactory.sol\npackages/contracts/src/Raffle.sol\n[profile.default]\nsrc = \"src\"\ntest = \"test/foundry\"\nscript = \"script\"\nout = \"out\"\nlibs = [\"lib\", \"node_modules\"]\nsolc_version = \"0.8.36\"\nevm_version = \"cancun\"\noptimizer = true\noptimizer_runs = 200\nvia_ir = false\nfuzz = { runs = 1_000, seed = \"0x524146464c45\" }\ninvariant = { runs = 256, depth = 64, fail_on_revert = false }\ngas_reports = [\"Raffle\", \"RaffleFactory\"]\n\n[profile.ci]\nfuzz = { runs = 10_000 }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit]\nfuzz = { runs = 100_000, seed = \"0x41554449545f46555a5a\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit_strict]\nfuzz = { runs = 10_000, seed = \"0x41554449545f535452494354\" }\nin