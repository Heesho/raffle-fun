     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n   162\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n   163\t     *\n   164\t     * NOTE: Using a non-zero value at creation will require the contract using this function (e.g. a factory)\n   165\t     * to always have enough balance for new deployments. Consider exposing this function under a payable method.\n   166\t     */\n   167\t    function cloneWithImmutableArgs(\n   168\t        address implementation,\n   169\t        bytes memory args,\n   170\t        uint256 value\n   171\t    ) internal returns (address instance) {\n   172\t        if (address(this).balance < value) {\n   173\t            revert Errors.InsufficientBalance(address(this).balance, value);\n   174\t        }\n   175\t        bytes memory bytecode = _cloneCodeWithImmutableArgs(implementation, args);\n   176\t        assembly (\"memory-safe\") {\n   177\t            instance := create(value, add(bytecode, 0x20), mload(bytecode))\n   178\t        }\n   179\t        if (instance == address(0)) {\n   180\t            revert Errors.FailedDeployment();\n   181\t        }\n   182\t    }\n   183\t\n   184\t    /**\n   185\t     * @dev Deploys and returns the address of a clone that mimics the behavior of `implementation` with custom\n   186\t     * immutable arguments. These are provided through `args` and cannot be changed after deployment. To\n   187\t     * access the arguments within the implementation, use {fetchCloneArgs}.\n   188\t     *\n   189\t     * This function uses the create2 opcode and a `salt` to deterministically deploy the clone. Using the same\n   190\t     * `implementation`, `args` and `salt` multiple times will revert, since the clones cannot be deployed twice\n   191\t     * at the same address.\n   192\t     *\n   193\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n   194\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n   195\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n   196\t     */\n   197\t    function cloneDeterministicWithImmutableArgs(\n   198\t        address implementation,\n   199\t        bytes memory args,\n   200\t        bytes32 salt\n   201\t    ) internal returns (address instance) {\n   202\t        return cloneDeterministicWithImmutableArgs(implementation, args, salt, 0);\n   203\t    }\n   204\t\n   205\t    /**\n   206\t     * @dev Same as {xref-Clones-cloneDeterministicWithImmutableArgs-address-bytes-bytes32-}[cloneDeterministicWithImmutableArgs],\n   207\t     * but with a `value` parameter to send native currency to the new contract.\n   208\t     *\n   209\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n   210\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n   211\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n   212\t     *\n   213\t     * NOTE: Using a non-zero value at creation will require the contract using this function (e.g. a factory)\n   214\t     * to always have enough balance for new deployments. Consider exposing this function under a payable method.\n   215\t     */\n   216\t    function cloneDeterministicWithImmutableArgs(\n   217\t        address implementation,\n   218\t        bytes memory args,\n   219\t        bytes32 salt,\n   220\t        uint256 value\n   221\t    ) internal returns (address instance) {\n   222\t        bytes memory bytecode = _cloneCodeWithImmutableArgs(implementation, args);\n   223\t        return Create2.deploy(value, salt, bytecode);\n   224\t    }\n   225\t\n   226\t    /**\n   227\t     * @dev Computes the address of a clone deployed using {Clones-cloneDeterministicWithImmutableArgs}.\n   228\t     */\n   229\t    function predictDeterministicAddressWithImmutableArgs(\n   230\t        address implementation,\n   231\t        bytes memory args,\n   232\t        bytes32 salt,\n   233\t        address deployer\n   234\t    ) internal pure returns (address predicted) {\n   235\t        bytes memory bytecode = _cloneCodeWithImmutableArgs(implementation, args);\n   236\t        return Create2.computeAddress(salt, keccak256(bytecode), deployer);\n   237\t    }\n   238\t\n   239\t    /**\n   240\t     * @dev Computes the address of a clone deployed using {Clones-cloneDeterministicWithImmutableArgs}.\n   241\t     */\n   242\t    function predictDeterministicAddressWithImmutableArgs(\n   243\t        address implementation,\n   244\t        bytes memory args,\n   245\t        bytes32 salt\n   246\t    ) internal view returns (address predicted) {\n   247\t        return predictDeterministicAddressWithImmutableArgs(implementation, args, salt, address(this));\n   248\t    }\n   249\t\n   250\t    /**\n   251\t     * @dev Get the immutable args attached to a clone.\n   252\t     *\n   253\t     * - If `instance` is a clone that was deployed using `clone` or `cloneDeterministic`, this\n   254\t     *   function will return an empty array.\n   255\t     * - If `instance` is a clone that was deployed using `cloneWithImmutableArgs` or\n   256\t     *   `cloneDeterministicWithImmutableArgs`, this function will return the args array used at\n   257\t     *   creation.\n   258\t     * - If `instance` is NOT a clone deployed using this library, the behavior is undefined. This\n   259\t     *   function should only be used to check addresses that are known to be clones.\n   260\t     */\n   261\t    function fetchCloneArgs(address instance) internal view returns (bytes memory) {\n   262\t        bytes memory result = new bytes(instance.code.length - 0x2d); // revert if length is too short\n   263\t        assembly (\"memory-safe\") {\n   264\t            extcodecopy(instance, add(result, 0x20), 0x2d, mload(result))\n   265\t        }\n   266\t        return result;\n   267\t    }\n   268\t\n   269\t    /**\n   270\t     * @dev Helper that prepares the initcode of the proxy with immutable args.\n   271\t     *\n   272\t     * An assembly variant of this function requires copying the `args` array, which can be efficiently done using\n   273\t     * `mcopy`. Unfortunately, that opcode is not available before cancun. A pure solidity implementation using\n   274\t     * abi.encodePacked is more expensive but also more portable and easier to review.\n   275\t     *\n   276\t     * NOTE: https://eips.ethereum.org/EIPS/eip-170[EIP-170] limits the length of the contract code to 24576 bytes.\n   277\t     * With the proxy code taking 45 bytes, that limits the length of the immutable args to 24531 bytes.\n   278\t     */\n   279\t    function _cloneCodeWithImmutableArgs(\n   280\t        address implementation,\n   281\t        bytes memory args\n   282\t    ) private pure returns (bytes memory) {\n   283\t        if (args.length > 0x5fd3) revert CloneArgumentsTooLong();\n   284\t        return\n   285\t            abi.encodePacked(\n   286\t                hex\"61\",\n   287\t                uint16(args.length + 0x2d),\n   288\t                hex\"3d81600a3d39f3363d3d373d3d3d363d73\",\n   289\t                implementation,\n   290\t                hex\"5af43d82803e903d91602b57fd5bf3\",\n   291\t                args\n   292\t            );\n   293\t    }\n   294\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/src/Raffle.sol | sed -n '410,475p;620,710p'; nl -ba packages/contracts/src/RaffleFactory.sol | sed -n '20,135p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/src/Raffle.sol | sed -n '410,475p;620,710p'; nl -ba packages/contracts/src/RaffleFactory.sol | sed -n '20,135p'\"","aggregated_output":"   410\t    /// @dev Unrelated NFTs forced here with unsafe `transferFrom` remain outside protocol accounting and cannot be\n   411\t    ///      rescued.\n   412\t    /// @param operator ERC-721 transfer operator, which must be the canonical factory.\n   413\t    /// @param from Previous owner, which must be the configured sponsor.\n   414\t    /// @param tokenId Transferred token ID, which must match the configured prize.\n   415\t    /// @return selector ERC-721 receiver acceptance selector.\n   416\t    function onERC721Received(address operator, address from, uint256 tokenId, bytes calldata)\n   417\t        external\n   418\t        override\n   419\t        returns (bytes4 selector)\n   420\t    {\n   421\t        if (\n   422\t            status != Status.AwaitingPrize || msg.sender != address(prizeToken) || tokenId != prizeTokenId\n   423\t                || from != sponsor || operator != factory\n   424\t        ) {\n   425\t            revert UnexpectedPrize(msg.sender, tokenId, from, operator);\n   426\t        }\n   427\t\n   428\t        status = Status.Active;\n   429\t        emit PrizeDeposited(msg.sender, tokenId, from);\n   430\t        selector = IERC721Receiver.onERC721Received.selector;\n   431\t    }\n   432\t\n   433\t    // Public view and pure functions\n   434\t\n   435\t    /// @inheritdoc IRaffle\n   436\t    function getVrfRequestPrice() public view override returns (uint256 fee) {\n   437\t        fee = i_vrfV2PlusWrapper.calculateRequestPriceNative(callbackGasLimit, 1);\n   438\t    }\n   439\t\n   440\t    /// @inheritdoc IRaffle\n   441\t    function estimateVrfRequestPrice(uint256 requestGasPriceWei) public view override returns (uint256 fee) {\n   442\t        fee = i_vrfV2PlusWrapper.estimateRequestPriceNative(callbackGasLimit, 1, requestGasPriceWei);\n   443\t    }\n   444\t\n   445\t    /// @inheritdoc IRaffle\n   446\t    function vrfWrapper() public view override returns (IVRFV2PlusWrapper wrapper) {\n   447\t        wrapper = i_vrfV2PlusWrapper;\n   448\t    }\n   449\t\n   450\t    /// @inheritdoc IRaffle\n   451\t    function ticketRange(uint256 ticketId) public view override returns (uint128 firstEntry, uint128 lastEntry) {\n   452\t        TicketRange storage range = _ticketRanges[ticketId];\n   453\t        firstEntry = range.firstEntry;\n   454\t        lastEntry = range.lastEntry;\n   455\t    }\n   456\t\n   457\t    /// @inheritdoc IRaffle\n   458\t    function drawRequestDeadline() public view override returns (uint256 deadline) {\n   459\t        deadline = uint256(endTime) + RaffleConstants.DRAW_REQUEST_TIMEOUT;\n   460\t    }\n   461\t\n   462\t    /// @inheritdoc IRaffle\n   463\t    function callbackDeadline() public view override returns (uint256 deadline) {\n   464\t        if (drawRequestedAt != 0) deadline = uint256(drawRequestedAt) + RaffleConstants.DRAW_CALLBACK_TIMEOUT;\n   465\t    }\n   466\t\n   467\t    /// @inheritdoc IRaffle\n   468\t    function accountedQuoteBalance() public view override returns (uint256 amount) {\n   469\t        amount = unsettledPot + remainingRefundLiability + winnerProceeds + sponsorProceeds + protocolFees;\n   470\t    }\n   471\t\n   472\t    /// @inheritdoc IRaffle\n   473\t    function grossSales() public view override returns (uint256 amount) {\n   474\t        amount = uint256(totalEntries) * ENTRY_PRICE;\n   475\t    }\n    20\t/// @custom:version 1.0.0\n    21\tcontract RaffleFactory is IRaffleFactory, ReentrancyGuard {\n    22\t    // Constants\n    23\t\n    24\t    /// @inheritdoc IRaffleFactory\n    25\t    uint32 public constant override callbackGasLimit = RaffleConstants.VRF_CALLBACK_GAS_LIMIT;\n    26\t\n    27\t    /// @inheritdoc IRaffleFactory\n    28\t    uint16 public constant override requestConfirmations = RaffleConstants.VRF_REQUEST_CONFIRMATIONS;\n    29\t\n    30\t    // Immutables and state\n    31\t\n    32\t    /// @inheritdoc IRaffleFactory\n    33\t    address public immutable override quoteToken;\n    34\t\n    35\t    /// @inheritdoc IRaffleFactory\n    36\t    address public immutable override vrfWrapper;\n    37\t\n    38\t    /// @inheritdoc IRaffleFactory\n    39\t    address public immutable override protocolTreasury;\n    40\t\n    41\t    /// @inheritdoc IRaffleFactory\n    42\t    address public immutable override raffleImplementation;\n    43\t\n    44\t    /// @inheritdoc IRaffleFactory\n    45\t    uint256 public override raffleCount;\n    46\t\n    47\t    /// @inheritdoc IRaffleFactory\n    48\t    mapping(uint256 raffleId => address raffle) public override raffleById;\n    49\t\n    50\t    /// @inheritdoc IRaffleFactory\n    51\t    mapping(address raffle => uint256 raffleId) public override idByRaffle;\n    52\t\n    53\t    /// @inheritdoc IRaffleFactory\n    54\t    mapping(address raffle => bool registered) public override isRaffle;\n    55\t\n    56\t    // Constructor\n    57\t\n    58\t    /// @notice Deploys the ownerless factory and its locked raffle implementation with one immutable configuration.\n    59\t    /// @dev The quote token must report exactly six decimals; the wrapper and quote token must contain deployed code.\n    60\t    ///      Deployment tooling must supply and verify the target chain's official USDC address because the constructor\n    61\t    ///      cannot prove token identity from metadata.\n    62\t    /// @param quoteToken_ Target chain's official six-decimal USDC contract trusted by every raffle.\n    63\t    /// @param vrfWrapper_ Official Chainlink VRF v2.5 native direct-funding wrapper for the target chain.\n    64\t    /// @param protocolTreasury_ Immutable protocol-fee recipient used by every raffle.\n    65\t    constructor(address quoteToken_, address vrfWrapper_, address protocolTreasury_) {\n    66\t        _requireContract(quoteToken_);\n    67\t        _requireContract(vrfWrapper_);\n    68\t        if (protocolTreasury_ == address(0)) revert ZeroAddress();\n    69\t\n    70\t        uint8 quoteDecimals = 0;\n    71\t        try IERC20Metadata(quoteToken_).decimals() returns (uint8 decimals_) {\n    72\t            quoteDecimals = decimals_;\n    73\t        } catch {\n    74\t            revert UnsupportedQuoteToken(quoteToken_);\n    75\t        }\n    76\t        if (quoteDecimals != RaffleConstants.QUOTE_TOKEN_DECIMALS) {\n    77\t            revert InvalidQuoteTokenDecimals(quoteDecimals, RaffleConstants.QUOTE_TOKEN_DECIMALS);\n    78\t        }\n    79\t\n    80\t        if (protocolTreasury_ == address(this) || protocolTreasury_ == quoteToken_ || protocolTreasury_ == vrfWrapper_)\n    81\t        {\n    82\t            revert UnsafeProtocolDestination(protocolTreasury_);\n    83\t        }\n    84\t\n    85\t        quoteToken = quoteToken_;\n    86\t        vrfWrapper = vrfWrapper_;\n    87\t        protocolTreasury = protocolTreasury_;\n    88\t\n    89\t        address implementation = address(new Raffle(quoteToken_, vrfWrapper_));\n    90\t        if (protocolTreasury_ == implementation) revert UnsafeProtocolDestination(protocolTreasury_);\n    91\t        raffleImplementation = implementation;\n    92\t    }\n    93\t\n    94\t    // External state-changing functions\n    95\t\n    96\t    /// @inheritdoc IRaffleFactory\n    97\t    function createRaffle(CreateRaffleParams calldata params) external override nonReentrant returns (address raffle) {\n    98\t        _validateCreateParams(params);\n    99\t        uint256 currentTime = block.timestamp;\n   100\t        if (params.endTime <= currentTime) revert InvalidEndTime(currentTime, params.endTime);\n   101\t        uint256 saleDuration = uint256(params.endTime) - currentTime;\n   102\t        if (saleDuration > RaffleConstants.MAX_SALE_DURATION) {\n   103\t            revert SaleDurationTooLong(saleDuration, RaffleConstants.MAX_SALE_DURATION);\n   104\t        }\n   105\t        uint256 raffleId = ++raffleCount;\n   106\t        raffle = Clones.clone(raffleImplementation);\n   107\t        // The fresh fixed-target clone can initialize only once; this function is nonReentrant and atomic.\n   108\t        // slither-disable-next-line reentrancy-no-eth\n   109\t        IRaffle(raffle)\n   110\t            .initialize(\n   111\t                IRaffle.RaffleInitParams({\n   112\t                sponsor: msg.sender,\n   113\t                sponsorRecipient: params.sponsorRecipient,\n   114\t                protocolTreasury: protocolTreasury,\n   115\t                prizeToken: params.prizeToken,\n   116\t                prizeTokenId: params.prizeTokenId,\n   117\t                raffleId: raffleId,\n   118\t                reserveEntries: params.reserveEntries,\n   119\t                endTime: params.endTime\n   120\t            })\n   121\t            );\n   122\t\n   123\t        raffleById[raffleId] = raffle;\n   124\t        idByRaffle[raffle] = raffleId;\n   125\t        isRaffle[raffle] = true;\n   126\t\n   127\t        IERC721 prize = IERC721(params.prizeToken);\n   128\t        prize.safeTransferFrom(msg.sender, raffle, params.prizeTokenId);\n   129\t        if (prize.ownerOf(params.prizeTokenId) != raffle) {\n   130\t            revert PrizeEscrowVerificationFailed(raffle, params.prizeToken, params.prizeTokenId);\n   131\t        }\n   132\t        if (IRaffle(raffle).status() != IRaffle.Status.Active) {\n   133\t            revert PrizeEscrowVerificationFailed(raffle, params.prizeToken, params.prizeTokenId);\n   134\t        }\n   135\t\n","exit_code":0,"status":"completed"}}
