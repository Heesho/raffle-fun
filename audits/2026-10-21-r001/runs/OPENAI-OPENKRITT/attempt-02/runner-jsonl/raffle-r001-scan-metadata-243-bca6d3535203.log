{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/node_modules/@chainlink/contracts/src/v0.8/vrf/dev/VRFV2PlusWrapperConsumerBase.sol | sed -n '1,190p'; rg -n 'vrfWrapper|_validatedVrfWrapper|selfdestruct|delegatecall' packages/contracts/src\"","aggregated_output":"     1\t// SPDX-License-Identifier: MIT\n     2\tpragma solidity ^0.8.0;\n     3\t\n     4\timport {LinkTokenInterface} from \"../../shared/interfaces/LinkTokenInterface.sol\";\n     5\timport {IVRFV2PlusWrapper} from \"./interfaces/IVRFV2PlusWrapper.sol\";\n     6\t\n     7\t/**\n     8\t *\n     9\t * @notice Interface for contracts using VRF randomness through the VRF V2 wrapper\n    10\t * ********************************************************************************\n    11\t * @dev PURPOSE\n    12\t *\n    13\t * @dev Create VRF V2+ requests without the need for subscription management. Rather than creating\n    14\t * @dev and funding a VRF V2+ subscription, a user can use this wrapper to create one off requests,\n    15\t * @dev paying up front rather than at fulfillment.\n    16\t *\n    17\t * @dev Since the price is determined using the gas price of the request transaction rather than\n    18\t * @dev the fulfillment transaction, the wrapper charges an additional premium on callback gas\n    19\t * @dev usage, in addition to some extra overhead costs associated with the VRFV2Wrapper contract.\n    20\t * *****************************************************************************\n    21\t * @dev USAGE\n    22\t *\n    23\t * @dev Calling contracts must inherit from VRFV2PlusWrapperConsumerBase. The consumer must be funded\n    24\t * @dev with enough LINK or ether to make the request, otherwise requests will revert. To request randomness,\n    25\t * @dev call the 'requestRandomWords' function with the desired VRF parameters. This function handles\n    26\t * @dev paying for the request based on the current pricing.\n    27\t *\n    28\t * @dev Consumers must implement the fullfillRandomWords function, which will be called during\n    29\t * @dev fulfillment with the randomness result.\n    30\t */\n    31\tabstract contract VRFV2PlusWrapperConsumerBase {\n    32\t  error OnlyVRFWrapperCanFulfill(address have, address want);\n    33\t\n    34\t  LinkTokenInterface internal immutable i_linkToken;\n    35\t  IVRFV2PlusWrapper public immutable i_vrfV2PlusWrapper;\n    36\t\n    37\t  /**\n    38\t   * @param _vrfV2PlusWrapper is the address of the VRFV2Wrapper contract\n    39\t   */\n    40\t  constructor(\n    41\t    address _vrfV2PlusWrapper\n    42\t  ) {\n    43\t    IVRFV2PlusWrapper vrfV2PlusWrapper = IVRFV2PlusWrapper(_vrfV2PlusWrapper);\n    44\t\n    45\t    i_linkToken = LinkTokenInterface(vrfV2PlusWrapper.link());\n    46\t    i_vrfV2PlusWrapper = vrfV2PlusWrapper;\n    47\t  }\n    48\t\n    49\t  /**\n    50\t   * @dev Requests randomness from the VRF V2+ wrapper.\n    51\t   *\n    52\t   * @param _callbackGasLimit is the gas limit that should be used when calling the consumer's\n    53\t   *        fulfillRandomWords function.\n    54\t   * @param _requestConfirmations is the number of confirmations to wait before fulfilling the\n    55\t   *        request. A higher number of confirmations increases security by reducing the likelihood\n    56\t   *        that a chain re-org changes a published randomness outcome.\n    57\t   * @param _numWords is the number of random words to request.\n    58\t   *\n    59\t   * @return requestId is the VRF V2+ request ID of the newly created randomness request.\n    60\t   */\n    61\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    62\t  function requestRandomness(\n    63\t    uint32 _callbackGasLimit,\n    64\t    uint16 _requestConfirmations,\n    65\t    uint32 _numWords,\n    66\t    bytes memory extraArgs\n    67\t  ) internal returns (uint256 requestId, uint256 reqPrice) {\n    68\t    reqPrice = i_vrfV2PlusWrapper.calculateRequestPrice(_callbackGasLimit, _numWords);\n    69\t    i_linkToken.transferAndCall(\n    70\t      address(i_vrfV2PlusWrapper), reqPrice, abi.encode(_callbackGasLimit, _requestConfirmations, _numWords, extraArgs)\n    71\t    );\n    72\t    return (i_vrfV2PlusWrapper.lastRequestId(), reqPrice);\n    73\t  }\n    74\t\n    75\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    76\t  function requestRandomnessPayInNative(\n    77\t    uint32 _callbackGasLimit,\n    78\t    uint16 _requestConfirmations,\n    79\t    uint32 _numWords,\n    80\t    bytes memory extraArgs\n    81\t  ) internal returns (uint256 requestId, uint256 requestPrice) {\n    82\t    requestPrice = i_vrfV2PlusWrapper.calculateRequestPriceNative(_callbackGasLimit, _numWords);\n    83\t    return (\n    84\t      i_vrfV2PlusWrapper.requestRandomWordsInNative{value: requestPrice}(\n    85\t        _callbackGasLimit, _requestConfirmations, _numWords, extraArgs\n    86\t      ),\n    87\t      requestPrice\n    88\t    );\n    89\t  }\n    90\t\n    91\t  /**\n    92\t   * @notice fulfillRandomWords handles the VRF V2 wrapper response. The consuming contract must\n    93\t   * @notice implement it.\n    94\t   *\n    95\t   * @param _requestId is the VRF V2 request ID.\n    96\t   * @param _randomWords is the randomness result.\n    97\t   */\n    98\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    99\t  function fulfillRandomWords(uint256 _requestId, uint256[] memory _randomWords) internal virtual;\n   100\t\n   101\t  function rawFulfillRandomWords(uint256 _requestId, uint256[] memory _randomWords) external {\n   102\t    address vrfWrapperAddr = address(i_vrfV2PlusWrapper);\n   103\t    if (msg.sender != vrfWrapperAddr) {\n   104\t      revert OnlyVRFWrapperCanFulfill(msg.sender, vrfWrapperAddr);\n   105\t    }\n   106\t    fulfillRandomWords(_requestId, _randomWords);\n   107\t  }\n   108\t\n   109\t  /// @notice getBalance returns the native balance of the consumer contract\n   110\t  function getBalance() public view returns (uint256) {\n   111\t    return address(this).balance;\n   112\t  }\n   113\t\n   114\t  /// @notice getLinkToken returns the link token contract\n   115\t  function getLinkToken() public view returns (LinkTokenInterface) {\n   116\t    return i_linkToken;\n   117\t  }\n   118\t}\npackages/contracts/src/RaffleFactory.sol:36:    address public immutable override vrfWrapper;\npackages/contracts/src/RaffleFactory.sol:63:    /// @param vrfWrapper_ Official Chainlink VRF v2.5 native direct-funding wrapper for the target chain.\npackages/contracts/src/RaffleFactory.sol:65:    constructor(address quoteToken_, address vrfWrapper_, address protocolTreasury_) {\npackages/contracts/src/RaffleFactory.sol:67:        _requireContract(vrfWrapper_);\npackages/contracts/src/RaffleFactory.sol:80:        if (protocolTreasury_ == address(this) || protocolTreasury_ == quoteToken_ || protocolTreasury_ == vrfWrapper_)\npackages/contracts/src/RaffleFactory.sol:86:        vrfWrapper = vrfWrapper_;\npackages/contracts/src/RaffleFactory.sol:89:        address implementation = address(new Raffle(quoteToken_, vrfWrapper_));\npackages/contracts/src/RaffleFactory.sol:158:            params.prizeToken == address(this) || params.prizeToken == quoteToken || params.prizeToken == vrfWrapper\npackages/contracts/src/RaffleFactory.sol:165:                || params.sponsorRecipient == vrfWrapper || params.sponsorRecipient == params.prizeToken\npackages/contracts/src/interfaces/IRaffle.sol:428:    function vrfWrapper() external view returns (IVRFV2PlusWrapper wrapper);\npackages/contracts/src/interfaces/IRaffleFactory.sol:114:    function vrfWrapper() external view returns (address wrapperAddress);\npackages/contracts/src/Raffle.sol:154:    /// @param vrfWrapper_ Chainlink VRF v2.5 native direct-funding wrapper fixed for the implementation and all clones.\npackages/contracts/src/Raffle.sol:155:    constructor(address quoteToken_, address vrfWrapper_)\npackages/contracts/src/Raffle.sol:157:        VRFV2PlusWrapperConsumerBase(_validatedVrfWrapper(vrfWrapper_))\npackages/contracts/src/Raffle.sol:446:    function vrfWrapper() public view override returns (IVRFV2PlusWrapper wrapper) {\npackages/contracts/src/Raffle.sol:610:    function _validatedVrfWrapper(address wrapper) private pure returns (address validatedWrapper) {\n","exit_code":0,"status":"completed"}}
