ansferFrom(address(this), winner, deliveredPrizeTokenId);\n   335\t            if (prizeToken.ownerOf(deliveredPrizeTokenId) != winner) {\n   336\t                revert PrizeDeliveryVerificationFailed(winner);\n   337\t            }\n   338\t        } else {\n   339\t            cashAmount = winnerProceeds;\n   340\t            if (cashAmount == 0) revert NoWinnerProceeds();\n   341\t            winnerProceeds = 0;\n   342\t            _transferQuote(winner, cashAmount);\n   343\t        }\n   344\t\n   345\t        emit WinningTicketRedeemed(ticketId, winner, result, cashAmount, deliveredPrizeToken, deliveredPrizeTokenId);\n   346\t    }\n   347\t\n   348\t    /// @inheritdoc IRaffle\n   349\t    function refundTickets(uint256[] calldata ticketIds) external override nonReentrant returns (uint256 amount) {\n   350\t        _requireStatus(Status.Refunding);\n[profile.default]\nsrc = \"src\"\ntest = \"test/foundry\"\nscript = \"script\"\nout = \"out\"\nlibs = [\"lib\", \"node_modules\"]\nsolc_version = \"0.8.36\"\nevm_version = \"cancun\"\noptimizer = true\noptimizer_runs = 200\nvia_ir = false\nfuzz = { runs = 1_000, seed = \"0x524146464c45\" }\ninvariant = { runs = 256, depth = 64, fail_on_revert = false }\ngas_reports = [\"Raffle\", \"RaffleFactory\"]\n\n[profile.ci]\nfuzz = { runs = 10_000 }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit]\nfuzz = { runs = 100_000, seed = \"0x41554449545f46555a5a\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit_strict]\nfuzz = { runs = 10_000, seed = \"0x41554449545f535452494354\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = true }\n\n[profile.audit_release]\nfuzz = { runs = 100_000, seed = \"0x52454c454153455f43414d504149474e\" }\ninvariant = { runs = 5_000, depth = 512, fail_on_revert = true, timeout = 3_600 }\n\n[profile.coverage]\nvia_ir = false\noptimizer = false\n\n[profile.comparison]\nvia_ir = true\noptimizer = true\noptimizer_runs