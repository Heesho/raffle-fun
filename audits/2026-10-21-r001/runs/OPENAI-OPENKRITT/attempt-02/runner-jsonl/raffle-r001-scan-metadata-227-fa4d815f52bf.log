or, prize, accounting, identifier, reserve, and timing configuration.\npackages/contracts/src/interfaces/IRaffle.sol:333:    /// @notice Lets the current winning-ticket owner atomically burn the ticket and receive the NFT or cash prize.\npackages/contracts/src/interfaces/IRaffle.sol:336:    /// @param ticketId Winning ticket to settle if needed, burn, and redeem.\npackages/contracts/src/interfaces/IRaffle.sol:338:    function redeemWinningTicket(uint256 ticketId) external returns (uint256 cashAmount);\npackages/contracts/src/interfaces/IRaffle.sol:354:    /// @notice Returns the escrowed prize to the immutable sponsor recipient after `CashWon` or `Refunding`.\npackages/contracts/src/interfaces/IRaffle.sol:355:    function releaseSponsorPrize() external;\npackages/contracts/src/interfaces/IRaffle.sol:410:    /// @notice Returns the prize depositor and pre-end empty-raffle refund authority.\npackages/contracts/src/interfaces/IRaffle.sol:414:    /// @notice Returns the immutable recipient of sponsor quote proceeds and returned prizes.\npackages/contracts/src/interfaces/IRaffle.sol:423:    /// @return token Canonical USDC contract trusted by this factory deployment.\npackages/contracts/src/interfaces/IRaffle.sol:430:    /// @notice Returns the configured ERC-721 prize contract.\npackages/contracts/src/interfaces/IRaffle.sol:431:    /// @return token Prize-token contract.\npackages/contracts/src/interfaces/IRaffle.sol:432:    function prizeToken() external view returns (IERC721 token);\npackages/contracts/src/interfaces/IRaffle.sol:434:    /// @notice Returns the configured ERC-721 prize token ID.\npackages/contracts/src/interfaces/IRaffle.sol:435:    /// @return tokenId Escrowed prize token ID.\npackages/contracts/src/interfaces/IRaffle.sol:436:    function prizeTokenId() external view returns (uint256 tokenId);\npackages/contracts/src/interfaces/IRaffle.sol:466:    /// @notice Returns the address that burned and redeemed the winning ticket.\npackages/contracts/src/inte