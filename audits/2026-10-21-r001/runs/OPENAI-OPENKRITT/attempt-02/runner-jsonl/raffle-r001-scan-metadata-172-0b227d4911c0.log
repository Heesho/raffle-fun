{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol'","aggregated_output":"     1\t// SPDX-License-Identifier: MIT\n     2\t// OpenZeppelin Contracts (last updated v5.5.0) (utils/ReentrancyGuard.sol)\n     3\t\n     4\tpragma solidity ^0.8.20;\n     5\t\n     6\timport {StorageSlot} from \"./StorageSlot.sol\";\n     7\t\n     8\t/**\n     9\t * @dev Contract module that helps prevent reentrant calls to a function.\n    10\t *\n    11\t * Inheriting from `ReentrancyGuard` will make the {nonReentrant} modifier\n    12\t * available, which can be applied to functions to make sure there are no nested\n    13\t * (reentrant) calls to them.\n    14\t *\n    15\t * Note that because there is a single `nonReentrant` guard, functions marked as\n    16\t * `nonReentrant` may not call one another. This can be worked around by making\n    17\t * those functions `private`, and then adding `external` `nonReentrant` entry\n    18\t * points to them.\n    19\t *\n    20\t * TIP: If EIP-1153 (transient storage) is available on the chain you're deploying at,\n    21\t * consider using {ReentrancyGuardTransient} instead.\n    22\t *\n    23\t * TIP: If you would like to learn more about reentrancy and alternative ways\n    24\t * to protect against it, check out our blog post\n    25\t * https://blog.openzeppelin.com/reentrancy-after-istanbul/[Reentrancy After Istanbul].\n    26\t *\n    27\t * IMPORTANT: Deprecated. This storage-based reentrancy guard will be removed and replaced\n    28\t * by the {ReentrancyGuardTransient} variant in v6.0.\n    29\t *\n    30\t * @custom:stateless\n    31\t */\n    32\tabstract contract ReentrancyGuard {\n    33\t    using StorageSlot for bytes32;\n    34\t\n    35\t    // keccak256(abi.encode(uint256(keccak256(\"openzeppelin.storage.ReentrancyGuard\")) - 1)) & ~bytes32(uint256(0xff))\n    36\t    bytes32 private constant REENTRANCY_GUARD_STORAGE =\n    37\t        0x9b779b17422d0df92223018b32b4d1fa46e071723d6817e2486d003becc55f00;\n    38\t\n    39\t    // Booleans are more expensive than uint256 or any type that takes up a full\n    40\t    // word because each write operation emits an extra SLOAD to first read the\n    41\t    // slot's contents, replace the bits taken up by the boolean, and then write\n    42\t    // back. This is the compiler's defense against contract upgrades and\n    43\t    // pointer aliasing, and it cannot be disabled.\n    44\t\n    45\t    // The values being non-zero value makes deployment a bit more expensive,\n    46\t    // but in exchange the refund on every call to nonReentrant will be lower in\n    47\t    // amount. Since refunds are capped to a percentage of the total\n    48\t    // transaction's gas, it is best to keep them low in cases like this one, to\n    49\t    // increase the likelihood of the full refund coming into effect.\n    50\t    uint256 private constant NOT_ENTERED = 1;\n    51\t    uint256 private constant ENTERED = 2;\n    52\t\n    53\t    /**\n    54\t     * @dev Unauthorized reentrant call.\n    55\t     */\n    56\t    error ReentrancyGuardReentrantCall();\n    57\t\n    58\t    constructor() {\n    59\t        _reentrancyGuardStorageSlot().getUint256Slot().value = NOT_ENTERED;\n    60\t    }\n    61\t\n    62\t    /**\n    63\t     * @dev Prevents a contract from calling itself, directly or indirectly.\n    64\t     * Calling a `nonReentrant` function from another `nonReentrant`\n    65\t     * function is not supported. It is possible to prevent this from happening\n    66\t     * by making the `nonReentrant` function external, and making it call a\n    67\t     * `private` function that does the actual work.\n    68\t     */\n    69\t    modifier nonReentrant() {\n    70\t        _nonReentrantBefore();\n    71\t        _;\n    72\t        _nonReentrantAfter();\n    73\t    }\n    74\t\n    75\t    /**\n    76\t     * @dev A `view` only version of {nonReentrant}. Use to block view functions\n    77\t     * from being called, preventing reading from inconsistent contract state.\n    78\t     *\n    79\t     * CAUTION: This is a \"view\" modifier and does not change the reentrancy\n    80\t     * status. Use it only on view functions. For payable or non-payable functions,\n    81\t     * use the standard {nonReentrant} modifier instead.\n    82\t     */\n    83\t    modifier nonReentrantView() {\n    84\t        _nonReentrantBeforeView();\n    85\t        _;\n    86\t    }\n    87\t\n    88\t    function _nonReentrantBeforeView() private view {\n    89\t        if (_reentrancyGuardEntered()) {\n    90\t            revert ReentrancyGuardReentrantCall();\n    91\t        }\n    92\t    }\n    93\t\n    94\t    function _nonReentrantBefore() private {\n    95\t        // On the first call to nonReentrant, _status will be NOT_ENTERED\n    96\t        _nonReentrantBeforeView();\n    97\t\n    98\t        // Any calls to nonReentrant after this point will fail\n    99\t        _reentrancyGuardStorageSlot().getUint256Slot().value = ENTERED;\n   100\t    }\n   101\t\n   102\t    function _nonReentrantAfter() private {\n   103\t        // By storing the original value once again, a refund is triggered (see\n   104\t        // https://eips.ethereum.org/EIPS/eip-2200)\n   105\t        _reentrancyGuardStorageSlot().getUint256Slot().value = NOT_ENTERED;\n   106\t    }\n   107\t\n   108\t    /**\n   109\t     * @dev Returns true if the reentrancy guard is currently set to \"entered\", which indicates there is a\n   110\t     * `nonReentrant` function in the call stack.\n   111\t     */\n   112\t    function _reentrancyGuardEntered() internal view returns (bool) {\n   113\t        return _reentrancyGuardStorageSlot().getUint256Slot().value == ENTERED;\n   114\t    }\n   115\t\n   116\t    function _reentrancyGuardStorageSlot() internal pure virtual returns (bytes32) {\n   117\t        return REENTRANCY_GUARD_STORAGE;\n   118\t    }\n   119\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"rg -n -C 5 'releaseSponsorPrize|sponsorRecipient|prizeClaimed|failure|revert|malicious|trust|transferFrom|ERC-721' DESIGN.md WORKSPACE.md packages/contracts/src/interfaces/IRaffle.sol packages/contracts/src/interfaces/IRaffleFactory.sol\"","aggregated_output":"DESIGN.md-1-# Clean design specification\nDESIGN.md:2:Ethereum NFT raffle; immutable factory, ERC-1167 clones with immutable implementation. One entry costs 1,000,000 units of canonical six-decimal USDC. One purchase mints a transferable ERC721 ticket representing a contiguous inclusive range. Exactly one ERC721 prize is escrowed atomically at creation. Reserve met awards NFT and 95% sponsor / 5% treasury. Reserve missed awards 80% gross to winner, 15% sponsor, 5% treasury. Refund outcome pays 100% per entry and returns prize. Rounding is floor on aggregate protocol fee; remainder must be allocated without loss. No administrator, mutable configuration or upgrade. Request window [sale end, end+2days); callback accepted strictly before request timestamp+2days. Refunds open at deadline. Callback records result only. Settlement is permissionless, storage-only; redemption requires current ticket owner, burns claim atomically, and must revert all effects on delivery failure. Sponsor and treasury can claim independently after settlement. Never move assets between raffle clones. Quote token and Chainlink wrapper are trusted canonical dependencies; arbitrary prize contracts and ticket recipients are untrusted. Frontend discovery is advisory; transaction decisions must reread current chain state.\nDESIGN.md-3-\nDESIGN.md-4-This specification was composed before scanner results and historical findings. Source, not design prose, determines actual behavior. No tests, audit history, accepted-risk lists or scanner results are provided.\n--\npackages/contracts/src/interfaces/IRaffle.sol-5-import { IERC20 } from \"@openzeppelin/contracts/token/ERC20/IERC20.sol\";\npackages/contracts/src/interfaces/IRaffle.sol-6-import { IERC721 } from \"@openzeppelin/contracts/token/ERC721/IERC721.sol\";\npackages/contracts/src/interfaces/IRaffle.sol-7-\npackages/contracts/src/interfaces/IRaffle.sol-8-/// @title raffle.fun Raffle Interface\npackages/contracts/src/interfaces/IRaffle.sol-9-/// @author heesho\npackages/contracts/src/interfaces/IRaffle.sol:10:/// @notice Defines one autonomous NFT raffle using fixed-price USDC entries and one transferable ERC-721 ticket per\npackages/contracts/src/interfaces/IRaffle.sol-11-///         purchase.\npackages/contracts/src/interfaces/IRaffle.sol-12-/// @dev Ticket IDs are sequential. Each ticket stores one inclusive uint128 entry range and remains a transferable\npackages/contracts/src/interfaces/IRaffle.sol:13:///      bearer claim until its owner atomically burns it for redemption or refund. The immutable quote token is trusted\npackages/contracts/src/interfaces/IRaffle.sol-14-///      canonical six-decimal USDC with standard, non-rebasing, fee-free transfers. Supported prizes are honest,\npackages/contracts/src/interfaces/IRaffle.sol:15:///      standards-compliant ERC-721s.\npackages/contracts/src/interfaces/IRaffle.sol-16-/// @custom:version 1.0.0\npackages/contracts/src/interfaces/IRaffle.sol-17-interface IRaffle {\npackages/contracts/src/interfaces/IRaffle.sol-18-    // Types\npackages/contracts/src/interfaces/IRaffle.sol-19-\npackages/contracts/src/interfaces/IRaffle.sol-20-    /// @notice The single authoritative raffle lifecycle and economic result.\n--\npackages/contracts/src/interfaces/IRaffle.sol-33-        Refunding\npackages/contracts/src/interfaces/IRaffle.sol-34-    }\npackages/contracts/src/interfaces/IRaffle.sol-35-\npackages/contracts/src/interfaces/IRaffle.sol-36-    /// @notice Complete clone-specific configuration supplied once by the canonical factory.\npackages/contracts/src/interfaces/IRaffle.sol-37-    /// @param sponsor Prize depositor and empty-raffle cancellation authority.\npackages/contracts/src/interfaces/IRaffle.sol:38:    /// @param sponsorRecipient Immutable recipient of sponsor quote proceeds and any returned prize.\npackages/contracts/src/interfaces/IRaffle.sol-39-    /// @param protocolTreasury Immutable recipient of protocol fees.\npackages/contracts/src/interfaces/IRaffle.sol:40:    /// @param prizeToken Standards-compliant ERC-721 prize contract.\npackages/contracts/src/interfaces/IRaffle.sol-41-    /// @param prizeTokenId Token ID of the prize escrowed by this raffle.\npackages/contracts/src/interfaces/IRaffle.sol-42-    /// @param raffleId One-based canonical factory identifier for this raffle.\npackages/contracts/src/interfaces/IRaffle.sol-43-    /// @param reserveEntries Global raw entry-count threshold selecting the NFT outcome when met or exceeded.\npackages/contracts/src/interfaces/IRaffle.sol-44-    /// @param endTime Unix timestamp, in seconds, at which entry sales end exclusively.\npackages/contracts/src/interfaces/IRaffle.sol-45-    struct RaffleInitParams {\npackages/contracts/src/interfaces/IRaffle.sol-46-        address sponsor;\npackages/contracts/src/interfaces/IRaffle.sol:47:        address sponsorRecipient;\npackages/contracts/src/interfaces/IRaffle.sol-48-        address protocolTreasury;\npackages/contracts/src/interfaces/IRaffle.sol-49-        address prizeToken;\npackages/contracts/src/interfaces/IRaffle.sol-50-        uint256 prizeTokenId;\npackages/contracts/src/interfaces/IRaffle.sol-51-        uint256 raffleId;\npackages/contracts/src/interfaces/IRaffle.sol-52-        uint128 reserveEntries;\n--\npackages/contracts/src/interfaces/IRaffle.sol-54-    }\npackages/contracts/src/interfaces/IRaffle.sol-55-\npackages/contracts/src/interfaces/IRaffle.sol-56-    // Events\npackages/contracts/src/interfaces/IRaffle.sol-57-\npackages/contracts/src/interfaces/IRaffle.sol-58-    /// @notice Emitted when the factory deposits the configured prize and activates the raffle.\npackages/contracts/src/interfaces/IRaffle.sol:59:    /// @param prizeToken ERC-721 contract of the deposited prize.\npackages/contracts/src/interfaces/IRaffle.sol-60-    /// @param prizeTokenId Token ID of the deposited prize.\npackages/contracts/src/interfaces/IRaffle.sol-61-    /// @param sponsor Address that deposited the prize through the factory.\npackages/contracts/src/interfaces/IRaffle.sol-62-    event PrizeDeposited(address indexed prizeToken, uint256 indexed prizeTokenId, address indexed sponsor);\npackages/contracts/src/interfaces/IRaffle.sol-63-\npackages/contracts/src/interfaces/IRaffle.sol-64-    /// @notice Emitted when a buyer pays for entries and one range ticket is minted.\n--\npackages/contracts/src/interfaces/IRaffle.sol-131-    /// @notice Emitted when the winning ticket owner burns the ticket and receives the corresponding prize.\npackages/contracts/src/interfaces/IRaffle.sol-132-    /// @param ticketId Burned winning ticket ID.\npackages/contracts/src/interfaces/IRaffle.sol-133-    /// @param winner Ticket owner that received the prize at redemption time.\npackages/contracts/src/interfaces/IRaffle.sol-134-    /// @param result Final `NftWon` or `CashWon` result.\npackages/contracts/src/interfaces/IRaffle.sol-135-    /// @param cashAmount Raw six-decimal quote-token units paid for `CashWon`; zero for `NftWon`.\npackages/contracts/src/interfaces/IRaffle.sol:136:    /// @param prizeToken ERC-721 prize contract for `NftWon`; the zero address for `CashWon`.\npackages/contracts/src/interfaces/IRaffle.sol:137:    /// @param prizeTokenId ERC-721 prize token ID for `NftWon`; zero for `CashWon`.\npackages/contracts/src/interfaces/IRaffle.sol-138-    event WinningTicketRedeemed(\npackages/contracts/src/interfaces/IRaffle.sol-139-        uint256 indexed ticketId,\npackages/contracts/src/interfaces/IRaffle.sol-140-        address indexed winner,\npackages/contracts/src/interfaces/IRaffle.sol-141-        Status indexed result,\npackages/contracts/src/interfaces/IRaffle.sol-142-        uint256 cashAmount,\n--\npackages/contracts/src/interfaces/IRaffle.sol-171-    event ProtocolFeesReleased(address indexed caller, address indexed treasury, uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol-172-\npackages/contracts/src/interfaces/IRaffle.sol-173-    /// @notice Emitted when the escrowed prize is returned after a cash result or refund transition.\npackages/contracts/src/interfaces/IRaffle.sol-174-    /// @param caller Address that triggered the permissionless release.\npackages/contracts/src/interfaces/IRaffle.sol-175-    /// @param recipient Immutable sponsor recipient that received the prize.\npackages/contracts/src/interfaces/IRaffle.sol:176:    /// @param prizeToken ERC-721 contract of the returned prize.\npackages/contracts/src/interfaces/IRaffle.sol-177-    /// @param prizeTokenId Token ID of the returned prize.\npackages/contracts/src/interfaces/IRaffle.sol-178-    event SponsorPrizeReleased(\npackages/contracts/src/interfaces/IRaffle.sol-179-        address indexed caller, address indexed recipient, address indexed prizeToken, uint256 prizeTokenId\npackages/contracts/src/interfaces/IRaffle.sol-180-    );\npackages/contracts/src/interfaces/IRaffle.sol-181-\n--\npackages/contracts/src/interfaces/IRaffle.sol-192-\npackages/contracts/src/interfaces/IRaffle.sol-193-    /// @notice Raised when an operation is unavailable in the current lifecycle state.\npackages/contracts/src/interfaces/IRaffle.sol-194-    /// @param actual Current raffle status.\npackages/contracts/src/interfaces/IRaffle.sol-195-    error InvalidStatus(Status actual);\npackages/contracts/src/interfaces/IRaffle.sol-196-\npackages/contracts/src/interfaces/IRaffle.sol:197:    /// @notice Raised when an ERC-721 receiver callback does not exactly match the configured factory prize deposit.\npackages/contracts/src/interfaces/IRaffle.sol:198:    /// @param token ERC-721 contract that invoked the receiver callback.\npackages/contracts/src/interfaces/IRaffle.sol-199-    /// @param tokenId Token ID supplied by the callback.\npackages/contracts/src/interfaces/IRaffle.sol-200-    /// @param from Address identified as the previous token owner.\npackages/contracts/src/interfaces/IRaffle.sol-201-    /// @param operator Address identified as the transfer operator.\npackages/contracts/src/interfaces/IRaffle.sol-202-    error UnexpectedPrize(address token, uint256 tokenId, address from, address operator);\npackages/contracts/src/interfaces/IRaffle.sol-203-\n--\npackages/contracts/src/interfaces/IRaffle.sol-306-    /// @dev Callable exactly once and only by the immutable canonical factory. Prize escrow activates the raffle later.\npackages/contracts/src/interfaces/IRaffle.sol-307-    /// @param params Clone-specific sponsor, prize, accounting, identifier, reserve, and timing configuration.\npackages/contracts/src/interfaces/IRaffle.sol-308-    function initialize(RaffleInitParams calldata params) external;\npackages/contracts/src/interfaces/IRaffle.sol-309-\npackages/contracts/src/interfaces/IRaffle.sol-310-    /// @notice Buys any positive number of entries and mints one sequential ticket containing their inclusive range.\npackages/contracts/src/interfaces/IRaffle.sol:311:    /// @param recipient Address that receives the newly minted ERC-721 range ticket.\npackages/contracts/src/interfaces/IRaffle.sol-312-    /// @param entryCount Prospective number of entries to buy for this ticket.\npackages/contracts/src/interfaces/IRaffle.sol-313-    /// @return ticketId Sequential ID of the newly minted ticket.\npackages/contracts/src/interfaces/IRaffle.sol-314-    function buyEntries(address recipient, uint128 entryCount) external returns (uint256 ticketId);\npackages/contracts/src/interfaces/IRaffle.sol-315-\npackages/contracts/src/interfaces/IRaffle.sol-316-    /// @notice Pays the current native Chainlink fee and requests the raffle's one random word.\n--\npackages/contracts/src/interfaces/IRaffle.sol-330-    /// @return cashAmount Raw six-decimal quote-token units allocated to the winner, or zero for an NFT result.\npackages/contracts/src/interfaces/IRaffle.sol-331-    function settleWinningTicket(uint256 ticketId) external returns (uint256 cashAmount);\npackages/contracts/src/interfaces/IRaffle.sol-332-\npackages/contracts/src/interfaces/IRaffle.sol-333-    /// @notice Lets the current winning-ticket owner atomically burn the ticket and receive the NFT or cash prize.\npackages/contracts/src/interfaces/IRaffle.sol-334-    /// @dev If necessary, this first settles the supplied winning ticket so the owner can complete both steps in one\npackages/contracts/src/interfaces/IRaffle.sol:335:    ///      transaction. Any failed delivery reverts the burn and every redemption state change.\npackages/contracts/src/interfaces/IRaffle.sol-336-    /// @param ticketId Winning ticket to settle if needed, burn, and redeem.\npackages/contracts/src/interfaces/IRaffle.sol-337-    /// @return cashAmount Raw six-decimal quote-token units paid for `CashWon`, or zero for `NftWon`.\npackages/contracts/src/interfaces/IRaffle.sol-338-    function redeemWinningTicket(uint256 ticketId) external returns (uint256 cashAmount);\npackages/contracts/src/interfaces/IRaffle.sol-339-\npackages/contracts/src/interfaces/IRaffle.sol-340-    /// @notice Burns an owner-selected batch of tickets and returns their full entry purchase value.\npackages/contracts/src/interfaces/IRaffle.sol:341:    /// @dev Accepts one to 100 tickets. Duplicate, nonexistent, or foreign-owned IDs revert the entire batch.\npackages/contracts/src/interfaces/IRaffle.sol-342-    /// @param ticketIds Ticket IDs owned by the caller and submitted for refund.\npackages/contracts/src/interfaces/IRaffle.sol-343-    /// @return amount Raw six-decimal quote-token units paid, equal to represented entries times `ENTRY_PRICE`.\npackages/contracts/src/interfaces/IRaffle.sol-344-    function refundTickets(uint256[] calldata ticketIds) external returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol-345-\npackages/contracts/src/interfaces/IRaffle.sol-346-    /// @notice Releases the complete current sponsor-proceeds balance to the immutable sponsor recipient.\n--\npackages/contracts/src/interfaces/IRaffle.sol-350-    /// @notice Releases the complete current protocol-fee balance to the immutable treasury.\npackages/contracts/src/interfaces/IRaffle.sol-351-    /// @return amount Raw six-decimal quote-token units paid in this release.\npackages/contracts/src/interfaces/IRaffle.sol-352-    function releaseProtocolFees() external returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol-353-\npackages/contracts/src/interfaces/IRaffle.sol-354-    /// @notice Returns the escrowed prize to the immutable sponsor recipient after `CashWon` or `Refunding`.\npackages/contracts/src/interfaces/IRaffle.sol:355:    function releaseSponsorPrize() external;\npackages/contracts/src/interfaces/IRaffle.sol-356-\npackages/contracts/src/interfaces/IRaffle.sol-357-    // External view functions\npackages/contracts/src/interfaces/IRaffle.sol-358-\npackages/contracts/src/interfaces/IRaffle.sol-359-    /// @notice Returns the wrapper's current native direct-funding price for the configured callback.\npackages/contracts/src/interfaces/IRaffle.sol-360-    /// @return fee Native-token wei currently quoted by the wrapper; the value may change before request inclusion.\n--\npackages/contracts/src/interfaces/IRaffle.sol-411-    /// @return sponsorAddress Immutable-per-raffle sponsor address.\npackages/contracts/src/interfaces/IRaffle.sol-412-    function sponsor() external view returns (address sponsorAddress);\npackages/contracts/src/interfaces/IRaffle.sol-413-\npackages/contracts/src/interfaces/IRaffle.sol-414-    /// @notice Returns the immutable recipient of sponsor quote proceeds and returned prizes.\npackages/contracts/src/interfaces/IRaffle.sol-415-    /// @return recipient Sponsor recipient address.\npackages/contracts/s