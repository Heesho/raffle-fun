{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"rg --files -g '\"'!node_modules'\"' -g '\"'!packages/contracts/node_modules'\"' -g '\"'!*lock*'\"' -g '\"'!*.sol'\"'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/proxy/Clones.sol | sed -n '1,105p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol | sed -n '1,170p'\"","aggregated_output":"WORKSPACE.json\nWORKSPACE.md\ndependency-hashes.json\npackages/contracts/foundry.toml\npackages/contracts/package.json\npackages/contracts/remappings.txt\npackages/contracts/hardhat.config.ts\nDESIGN.md\n     1\t// SPDX-License-Identifier: MIT\n     2\t// OpenZeppelin Contracts (last updated v5.5.0) (proxy/Clones.sol)\n     3\t\n     4\tpragma solidity ^0.8.20;\n     5\t\n     6\timport {Create2} from \"../utils/Create2.sol\";\n     7\timport {Errors} from \"../utils/Errors.sol\";\n     8\t\n     9\t/**\n    10\t * @dev https://eips.ethereum.org/EIPS/eip-1167[ERC-1167] is a standard for\n    11\t * deploying minimal proxy contracts, also known as \"clones\".\n    12\t *\n    13\t * > To simply and cheaply clone contract functionality in an immutable way, this standard specifies\n    14\t * > a minimal bytecode implementation that delegates all calls to a known, fixed address.\n    15\t *\n    16\t * The library includes functions to deploy a proxy using either `create` (traditional deployment) or `create2`\n    17\t * (salted deterministic deployment). It also includes functions to predict the addresses of clones deployed using the\n    18\t * deterministic method.\n    19\t */\n    20\tlibrary Clones {\n    21\t    error CloneArgumentsTooLong();\n    22\t\n    23\t    /**\n    24\t     * @dev Deploys and returns the address of a clone that mimics the behavior of `implementation`.\n    25\t     *\n    26\t     * This function uses the create opcode, which should never revert.\n    27\t     *\n    28\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    29\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    30\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    31\t     */\n    32\t    function clone(address implementation) internal returns (address instance) {\n    33\t        return clone(implementation, 0);\n    34\t    }\n    35\t\n    36\t    /**\n    37\t     * @dev Same as {xref-Clones-clone-address-}[clone], but with a `value` parameter to send native currency\n    38\t     * to the new contract.\n    39\t     *\n    40\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    41\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    42\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    43\t     *\n    44\t     * NOTE: Using a non-zero value at creation will require the contract using this function (e.g. a factory)\n    45\t     * to always have enough balance for new deployments. Consider exposing this function under a payable method.\n    46\t     */\n    47\t    function clone(address implementation, uint256 value) internal returns (address instance) {\n    48\t        if (address(this).balance < value) {\n    49\t            revert Errors.InsufficientBalance(address(this).balance, value);\n    50\t        }\n    51\t        assembly (\"memory-safe\") {\n    52\t            // Cleans the upper 96 bits of the `implementation` word, then packs the first 3 bytes\n    53\t            // of the `implementation` address with the bytecode before the address.\n    54\t            mstore(0x00, or(shr(232, shl(96, implementation)), 0x3d602d80600a3d3981f3363d3d373d3d3d363d73000000))\n    55\t            // Packs the remaining 17 bytes of `implementation` with the bytecode after the address.\n    56\t            mstore(0x20, or(shl(120, implementation), 0x5af43d82803e903d91602b57fd5bf3))\n    57\t            instance := create(value, 0x09, 0x37)\n    58\t        }\n    59\t        if (instance == address(0)) {\n    60\t            revert Errors.FailedDeployment();\n    61\t        }\n    62\t    }\n    63\t\n    64\t    /**\n    65\t     * @dev Deploys and returns the address of a clone that mimics the behavior of `implementation`.\n    66\t     *\n    67\t     * This function uses the create2 opcode and a `salt` to deterministically deploy\n    68\t     * the clone. Using the same `implementation` and `salt` multiple times will revert, since\n    69\t     * the clones cannot be deployed twice at the same address.\n    70\t     *\n    71\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    72\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    73\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    74\t     */\n    75\t    function cloneDeterministic(address implementation, bytes32 salt) internal returns (address instance) {\n    76\t        return cloneDeterministic(implementation, salt, 0);\n    77\t    }\n    78\t\n    79\t    /**\n    80\t     * @dev Same as {xref-Clones-cloneDeterministic-address-bytes32-}[cloneDeterministic], but with\n    81\t     * a `value` parameter to send native currency to the new contract.\n    82\t     *\n    83\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    84\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    85\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    86\t     *\n    87\t     * NOTE: Using a non-zero value at creation will require the contract using this function (e.g. a factory)\n    88\t     * to always have enough balance for new deployments. Consider exposing this function under a payable method.\n    89\t     */\n    90\t    function cloneDeterministic(\n    91\t        address implementation,\n    92\t        bytes32 salt,\n    93\t        uint256 value\n    94\t    ) internal returns (address instance) {\n    95\t        if (address(this).balance < value) {\n    96\t            revert Errors.InsufficientBalance(address(this).balance, value);\n    97\t        }\n    98\t        assembly (\"memory-safe\") {\n    99\t            // Cleans the upper 96 bits of the `implementation` word, then packs the first 3 bytes\n   100\t            // of the `implementation` address with the bytecode before the address.\n   101\t            mstore(0x00, or(shr(232, shl(96, implementation)), 0x3d602d80600a3d3981f3363d3d373d3d3d363d73000000))\n   102\t            // Packs the remaining 17 bytes of `implementation` with the bytecode after the address.\n   103\t            mstore(0x20, or(shl(120, implementation), 0x5af43d82803e903d91602b57fd5bf3))\n   104\t            instance := create2(value, 0x09, 0x37, salt)\n   105\t        }\n     1\t// SPDX-License-Identifier: MIT\n     2\t// OpenZeppelin Contracts (last updated v5.5.0) (utils/ReentrancyGuard.sol)\n     3\t\n     4\tpragma solidity ^0.8.20;\n     5\t\n     6\timport {StorageSlot} from \"./StorageSlot.sol\";\n     7\t\n     8\t/**\n     9\t * @dev Contract module that helps prevent reentrant calls to a function.\n    10\t *\n    11\t * Inheriting from `ReentrancyGuard` will make the {nonReentrant} modifier\n    12\t * available, which can be applied to functions to make sure there are no nested\n    13\t * (reentrant) calls to them.\n    14\t *\n    15\t * Note that because there is a single `nonReentrant` guard, functions marked as\n    16\t * `nonReentrant` may not call one another. This can be worked around by making\n    17\t * those functions `private`, and then adding `external` `nonReentrant` entry\n    18\t * points to them.\n    19\t *\n    20\t * TIP: If EIP-1153 (transient storage) is available on the chain you're deploying at,\n    21\t * consider using {ReentrancyGuardTransient} instead.\n    22\t *\n    23\t * TIP: If you would like to learn more about reentrancy and alternative ways\n    24\t * to protect against it, check out our blog post\n    25\t * https://blog.openzeppelin.com/reentrancy-after-istanbul/[Reentrancy After Istanbul].\n    26\t *\n    27\t * IMPORTANT: Deprecated. This storage-based reentrancy guard will be removed and replaced\n    28\t * by the {ReentrancyGuardTransient} variant in v6.0.\n    29\t *\n    30\t * @custom:stateless\n    31\t */\n    32\tabstract contract ReentrancyGuard {\n    33\t    using StorageSlot for bytes32;\n    34\t\n    35\t    // keccak256(abi.encode(uint256(keccak256(\"openzeppelin.storage.ReentrancyGuard\")) - 1)) & ~bytes32(uint256(0xff))\n    36\t    bytes32 private constant REENTRANCY_GUARD_STORAGE =\n    37\t        0x9b779b17422d0df92223018b32b4d1fa46e071723d6817e2486d003becc55f00;\n    38\t\n    39\t    // Booleans are more expensive than uint256 or any type that takes up a full\n    40\t    // word because each write operation emits an extra SLOAD to first read the\n    41\t    // slot's contents, replace the bits taken up by the boolean, and then write\n    42\t    // back. This is the compiler's defense against contract upgrades and\n    43\t    // pointer aliasing, and it cannot be disabled.\n    44\t\n    45\t    // The values being non-zero value makes deployment a bit more expensive,\n    46\t    // but in exchange the refund on every call to nonReentrant will be lower in\n    47\t    // amount. Since refunds are capped to a percentage of the total\n    48\t    // transaction's gas, it is best to keep them low in cases like this one, to\n    49\t    // increase the likelihood of the full refund coming into effect.\n    50\t    uint256 private constant NOT_ENTERED = 1;\n    51\t    uint256 private constant ENTERED = 2;\n    52\t\n    53\t    /**\n    54\t     * @dev Unauthorized reentrant call.\n    55\t     */\n    56\t    error ReentrancyGuardReentrantCall();\n    57\t\n    58\t    constructor() {\n    59\t        _reentrancyGuardStorageSlot().getUint256Slot().value = NOT_ENTERED;\n    60\t    }\n    61\t\n    62\t    /**\n    63\t     * @dev Prevents a contract from calling itself, directly or indirectly.\n    64\t     * Calling a `nonReentrant` function from another `nonReentrant`\n    65\t     * function is not supported. It is possible to prevent this from happening\n    66\t     * by making the `nonReentrant` function external, and making it call a\n    67\t     * `private` function that does the actual work.\n    68\t     */\n    69\t    modifier nonReentrant() {\n    70\t        _nonReentrantBefore();\n    71\t        _;\n    72\t        _nonReentrantAfter();\n    73\t    }\n    74\t\n    75\t    /**\n    76\t     * @dev A `view` only version of {nonReentrant}. Use to block view functions\n    77\t     * from being called, preventing reading from inconsistent contract state.\n    78\t     *\n    79\t     * CAUTION: This is a \"view\" modifier and does not change the reentrancy\n    80\t     * status. Use it only on view functions. For payable or non-payable functions,\n    81\t     * use the standard {nonReentrant} modifier instead.\n    82\t     */\n    83\t    modifier nonReentrantView() {\n    84\t        _nonReentrantBeforeView();\n    85\t        _;\n    86\t    }\n    87\t\n    88\t    function _nonReentrantBeforeView() private view {\n    89\t        if (_reentrancyGuardEntered()) {\n    90\t            revert ReentrancyGuardReentrantCall();\n    91\t        }\n    92\t    }\n    93\t\n    94\t    function _nonReentrantBefore() private {\n    95\t        // On the first call to nonReentrant, _status will be NOT_ENTERED\n    96\t        _nonReentrantBeforeView();\n    97\t\n    98\t        // Any calls to nonReentrant after this point will fail\n    99\t        _reentrancyGuardStorageSlot().getUint256Slot().value = ENTERED;\n   100\t    }\n   101\t\n   102\t    function _nonReentrantAfter() private {\n   103\t        // By storing the original value once again, a refund is triggered (see\n   104\t        // https://eips.ethereum.org/EIPS/eip-2200)\n   105\t        _reentrancyGuardStorageSlot().getUint256Slot().value = NOT_ENTERED;\n   106\t    }\n   107\t\n   108\t    /**\n   109\t     * @dev Returns true if the reentrancy guard is currently set to \"entered\", which indicates there is a\n   110\t     * `nonReentrant` function in the call stack.\n   111\t     */\n   112\t    function _reentrancyGuardEntered() internal view returns (bool) {\n   113\t        return _reentrancyGuardStorageSlot().getUint256Slot().value == ENTERED;\n   114\t    }\n   115\t\n   116\t    function _reentrancyGuardStorageSlot() internal pure virtual returns (bytes32) {\n   117\t        return REENTRANCY_GUARD_STORAGE;\n   118\t    }\n   119\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat WORKSPACE.md packages/contracts/package.json packages/contracts/hardhat.config.ts; rg -n 'creat|escrow|callback|sponsor|register|atomic|reentran|trust|duration' DESIGN.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat WORKSPACE.md packages/contracts/package.json packages/contracts/hardhat.config.ts; rg -n 'creat|escrow|callback|sponsor|register|atomic|reentran|trust|duration' DESIGN.md\"","aggregated_output":"# Dependency Workspace\n\nCurrent working directory / primary repository root: /workspace\nWorkspace manifest: WORKSPACE.json\nDependency repositories are checked out as top-level directories inside the same workspace root.\nWhen reporting file_path for dependency code, prefix it with the dependency alias directory.\nPrimary repository: clean-context @ LOCAL_SNAPSHOT\nNo dependency checkouts are listed in WORKSPACE.json.\n\nPath guidance:\n- Reference primary repo files relative to the workspace root.\n- Reference dependency files with their dependency directory prefix, e.g. `agave/...`.\n{\n  \"name\": \"@raffle-fun/contracts\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.13 <23\"\n  },\n  \"scripts\": {\n    \"build\": \"hardhat compile && forge build\",\n    \"compile\": \"hardhat compile\",\n    \"test\": \"pnpm test:foundry && pnpm test:hardhat\",\n    \"test:foundry\": \"forge test\",\n    \"test:hardhat\": \"hardhat test nodejs\",\n    \"coverage\": \"forge coverage --report lcov --no-match-coverage '^(script/|src/mocks/|test/)' && node scripts/check-coverage.mjs\",\n    \"gas\": \"forge snapshot --check -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"gas:update\": \"forge snapshot -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"fmt\": \"forge fmt\",\n    \"fmt:check\": \"forge fmt --check\",\n    \"lint\": \"solhint 'src/**/*.sol' 'test/**/*.sol'\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"slither\": \"slither . --config-file slither.config.json\",\n    \"deploy:sepolia\": \"hardhat ignition deploy ignition/modules/RaffleFun.ts --network sepolia\",\n    \"verify:sepolia\": \"hardhat ignition verify chain-11155111\",\n    \"deployment:write\": \"tsx scripts/write-deployment.ts\"\n  },\n  \"dependencies\": {\n    \"@chainlink/contracts\": \"1.5.0\",\n    \"@openzeppelin/contracts\": \"5.6.1\"\n  },\n  \"devDependencies\": {\n    \"@nomicfoundation/hardhat-ignition\": \"3.1.8\",\n    \"@nomicfoundation/hardhat-ignition-viem\": \"3.1.6\",\n    \"@nomicfoundation/hardhat-toolbox-viem\": \"5.0.7\",\n    \"@types/node\": \"26.1.2\",\n    \"dotenv\": \"17.4.2\",\n    \"hardhat\": \"3.11.1\",\n    \"solhint\": \"6.2.3\",\n    \"tsx\": \"4.23.1\",\n    \"typescript\": \"6.0.3\",\n    \"viem\": \"2.55.10\",\n    \"zod\": \"4.4.3\"\n  }\n}\nimport hardhatToolboxViemPlugin from \"@nomicfoundation/hardhat-toolbox-viem\";\nimport { configVariable, defineConfig } from \"hardhat/config\";\n\nexport default defineConfig({\n  plugins: [hardhatToolboxViemPlugin],\n  paths: {\n    sources: \"./src\",\n    tests: {\n      nodejs: \"./test/hardhat\",\n    },\n    cache: \"./cache/hardhat\",\n    artifacts: \"./artifacts\",\n  },\n  solidity: {\n    profiles: {\n      default: {\n        version: \"0.8.36\",\n        settings: {\n          optimizer: {\n            enabled: true,\n            runs: 200,\n          },\n          evmVersion: \"cancun\",\n        },\n      },\n      production: {\n        version: \"0.8.36\",\n        settings: {\n          optimizer: {\n            enabled: true,\n            runs: 200,\n          },\n          evmVersion: \"cancun\",\n        },\n      },\n    },\n  },\n  networks: {\n    hardhatEthereum: {\n      type: \"edr-simulated\",\n      chainType: \"l1\",\n      chainId: 31_337,\n    },\n    sepolia: {\n      type: \"http\",\n      chainType: \"l1\",\n      chainId: 11_155_111,\n      url: configVariable(\"SEPOLIA_RPC_URL\"),\n      accounts: [configVariable(\"DEPLOYER_PRIVATE_KEY\")],\n    },\n    mainnet: {\n      type: \"http\",\n      chainType: \"l1\",\n      chainId: 1,\n      url: configVariable(\"ETHEREUM_RPC_URL\"),\n      accounts: [configVariable(\"DEPLOYER_PRIVATE_KEY\")],\n    },\n  },\n});\n2:Ethereum NFT raffle; immutable factory, ERC-1167 clones with immutable implementation. One entry costs 1,000,000 units of canonical six-decimal USDC. One purchase mints a transferable ERC721 ticket representing a contiguous inclusive range. Exactly one ERC721 prize is escrowed atomically at creation. Reserve met awards NFT and 95% sponsor / 5% treasury. Reserve missed awards 80% gross to winner, 15% sponsor, 5% treasury. Refund outcome pays 100% per entry and returns prize. Rounding is floor on aggregate protocol fee; remainder must be allocated without loss. No administrator, mutable configuration or upgrade. Request window [sale end, end+2days); callback accepted strictly before request timestamp+2days. Refunds open at deadline. Callback records result only. Settlement is permissionless, storage-only; redemption requires current ticket owner, burns claim atomically, and must revert all effects on delivery failure. Sponsor and treasury can claim independently after settlement. Never move assets between raffle clones. Quote token and Chainlink wrapper are trusted canonical dependencies; arbitrary prize contracts and ticket recipients are untrusted. Frontend discovery is advisory; transaction decisions must reread current chain state.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/src/interfaces/IRaffleFactory.sol | sed -n '12,130p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/ERC721.sol | sed -n '110,165p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/ERC721.sol | sed -n '230,335p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/utils/ERC721Utils.sol | sed -n '1,90p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/src/interfaces/IRaffleFactory.sol | sed -n '12,130p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/ERC721.sol | sed -n '110,165p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/ERC721.sol | sed -n '230,335p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/utils/ERC721Utils.sol | sed -n '1,90p'\"","aggregated_output":"    12\t    // Types\n    13\t\n    14\t    /// @notice Sponsor-selected configuration for one new raffle.\n    15\t    /// @param sponsorRecipient Immutable recipient of sponsor quote proceeds and any returned prize.\n    16\t    /// @param prizeToken Standards-compliant ERC-721 prize contract.\n    17\t    /// @param prizeTokenId Token ID to escrow atomically during creation.\n    18\t    /// @param reserveEntries Global raw entry-count threshold selecting the NFT outcome when met or exceeded.\n    19\t    /// @param endTime Exclusive sale-end Unix timestamp, in seconds.\n    20\t    struct CreateRaffleParams {\n    21\t        address sponsorRecipient;\n    22\t        address prizeToken;\n    23\t        uint256 prizeTokenId;\n    24\t        uint128 reserveEntries;\n    25\t        uint64 endTime;\n    26\t    }\n    27\t\n    28\t    // Events\n    29\t\n    30\t    /// @notice Emitted after a raffle clone is initialized, registered, funded, and active.\n    31\t    /// @param raffleId One-based canonical raffle identifier.\n    32\t    /// @param raffle Newly created fixed-target ERC-1167 clone.\n    33\t    /// @param sponsor Prize depositor and pre-end empty-raffle refund authority.\n    34\t    /// @param sponsorRecipient Immutable recipient of sponsor quote proceeds and any returned prize.\n    35\t    /// @param prizeToken ERC-721 contract of the escrowed prize.\n    36\t    /// @param prizeTokenId Token ID of the escrowed prize.\n    37\t    /// @param quoteToken Immutable canonical six-decimal USDC contract used by the raffle.\n    38\t    /// @param protocolTreasury Immutable recipient of protocol fees.\n    39\t    /// @param reserveEntries Global raw entry-count threshold selecting the NFT outcome when met or exceeded.\n    40\t    /// @param endTime Exclusive sale-end Unix timestamp, in seconds.\n    41\t    event RaffleCreated(\n    42\t        uint256 indexed raffleId,\n    43\t        address indexed raffle,\n    44\t        address indexed sponsor,\n    45\t        address sponsorRecipient,\n    46\t        address prizeToken,\n    47\t        uint256 prizeTokenId,\n    48\t        address quoteToken,\n    49\t        address protocolTreasury,\n    50\t        uint128 reserveEntries,\n    51\t        uint64 endTime\n    52\t    );\n    53\t\n    54\t    // Errors\n    55\t\n    56\t    /// @notice Raised when a required address is the zero address.\n    57\t    error ZeroAddress();\n    58\t\n    59\t    /// @notice Raised when an address required to contain deployed code is not a contract.\n    60\t    /// @param account Address whose code length was zero.\n    61\t    error NotContract(address account);\n    62\t\n    63\t    /// @notice Raised when the quote token cannot report its decimal precision.\n    64\t    /// @param quoteToken Rejected quote-token contract.\n    65\t    error UnsupportedQuoteToken(address quoteToken);\n    66\t\n    67\t    /// @notice Raised when the quote token does not use the required six-decimal precision.\n    68\t    /// @param actualDecimals Decimal precision reported by the quote token.\n    69\t    /// @param requiredDecimals Required decimal precision, exactly six.\n    70\t    error InvalidQuoteTokenDecimals(uint8 actualDecimals, uint8 requiredDecimals);\n    71\t\n    72\t    /// @notice Raised when the prize contract does not report ERC-721 interface support.\n    73\t    /// @param prizeToken Rejected prize-token contract.\n    74\t    error UnsupportedPrizeToken(address prizeToken);\n    75\t\n    76\t    /// @notice Raised when a raffle is configured with a zero reserve entry threshold.\n    77\t    error ZeroReserveEntries();\n    78\t\n    79\t    /// @notice Raised when the sale end is not strictly after the creation block timestamp.\n    80\t    /// @param currentTime Current block Unix timestamp, in seconds.\n    81\t    /// @param endTime Supplied exclusive sale-end Unix timestamp, in seconds.\n    82\t    error InvalidEndTime(uint256 currentTime, uint256 endTime);\n    83\t\n    84\t    /// @notice Raised when the prospective sale duration exceeds the fixed 30-day limit.\n    85\t    /// @param duration Prospective sale duration in seconds.\n    86\t    /// @param maximumDuration Maximum permitted sale duration in seconds.\n    87\t    error SaleDurationTooLong(uint256 duration, uint256 maximumDuration);\n    88\t\n    89\t    /// @notice Raised when a configured token or recipient is known protocol plumbing.\n    90\t    /// @param destination Rejected address.\n    91\t    error UnsafeProtocolDestination(address destination);\n    92\t\n    93\t    /// @notice Raised when the exact configured prize is not owned by an active clone after escrow.\n    94\t    /// @param raffle Newly created clone expected to hold the prize and report `Active`.\n    95\t    /// @param prizeToken ERC-721 prize contract.\n    96\t    /// @param prizeTokenId Configured prize token ID.\n    97\t    error PrizeEscrowVerificationFailed(address raffle, address prizeToken, uint256 prizeTokenId);\n    98\t\n    99\t    // External state-changing functions\n   100\t\n   101\t    /// @notice Creates, initializes, registers, and funds one autonomous fixed-target raffle clone atomically.\n   102\t    /// @param params Sponsor-selected recipient, prize, reserve, and timing configuration.\n   103\t    /// @return raffle Address of the newly created and activated clone.\n   104\t    function createRaffle(CreateRaffleParams calldata params) external returns (address raffle);\n   105\t\n   106\t    // Public generated getters\n   107\t\n   108\t    /// @notice Returns the immutable canonical six-decimal USDC contract used by every raffle.\n   109\t    /// @return quoteTokenAddress Canonical USDC contract address trusted by this deployment.\n   110\t    function quoteToken() external view returns (address quoteTokenAddress);\n   111\t\n   112\t    /// @notice Returns the immutable Chainlink VRF v2.5 native direct-funding wrapper used by every raffle.\n   113\t    /// @return wrapperAddress Wrapper contract address.\n   114\t    function vrfWrapper() external view returns (address wrapperAddress);\n   115\t\n   116\t    /// @notice Returns the immutable recipient of protocol fees from every raffle.\n   117\t    /// @return treasuryAddress Protocol treasury address.\n   118\t    function protocolTreasury() external view returns (address treasuryAddress);\n   119\t\n   120\t    /// @notice Returns the fixed Chainlink callback execution limit used by every raffle.\n   121\t    /// @return gasLimit Callback gas units requested from the wrapper.\n   122\t    function callbackGasLimit() external view returns (uint32 gasLimit);\n   123\t\n   124\t    /// @notice Returns the fixed Chainlink confirmation count used by every raffle.\n   125\t    /// @return confirmations Blocks requested before callback fulfillment.\n   126\t    function requestConfirmations() external view returns (uint16 confirmations);\n   127\t\n   128\t    /// @notice Returns the immutable implementation targeted by every registered ERC-1167 clone.\n   129\t    /// @return implementation Locked raffle implementation address.\n   130\t    function raffleImplementation() external view returns (address implementation);\n   110\t    function isApprovedForAll(address owner, address operator) public view virtual returns (bool) {\n   111\t        return _operatorApprovals[owner][operator];\n   112\t    }\n   113\t\n   114\t    /// @i