per } from \"@chainlink/contracts/src/v0.8/vrf/dev/interfaces/IVRFV2PlusWrapper.sol\";\n./packages/contracts/src/interfaces/IRaffle.sol:361:    function getVrfRequestPrice() external view returns (uint256 fee);\n./packages/contracts/src/interfaces/IRaffle.sol:428:    function vrfWrapper() external view returns (IVRFV2PlusWrapper wrapper);\n./packages/contracts/src/interfaces/IRaffleFactory.sol:114:    function vrfWrapper() external view returns (address wrapperAddress);\n./packages/contracts/src/Raffle.sol:4:import { VRFV2PlusWrapperConsumerBase } from \"@chainlink/contracts/src/v0.8/vrf/dev/VRFV2PlusWrapperConsumerBase.sol\";\n./packages/contracts/src/Raffle.sol:5:import { IVRFV2PlusWrapper } from \"@chainlink/contracts/src/v0.8/vrf/dev/interfaces/IVRFV2PlusWrapper.sol\";\n./packages/contracts/src/Raffle.sol:28:contract Raffle is IRaffle, ERC721, ReentrancyGuard, IERC721Receiver, VRFV2PlusWrapperConsumerBase {\n./packages/contracts/src/Raffle.sol:154:    /// @param vrfWrapper_ Chainlink VRF v2.5 native direct-funding wrapper fixed for the implementation and all clones.\n./packages/contracts/src/Raffle.sol:155:    constructor(address quoteToken_, address vrfWrapper_)\n./packages/contracts/src/Raffle.sol:157:        VRFV2PlusWrapperConsumerBase(_validatedVrfWrapper(vrfWrapper_))\n./packages/contracts/src/Raffle.sol:249:        uint256 quotedFee = getVrfRequestPrice();\n./packages/contracts/src/Raffle.sol:436:    function getVrfRequestPrice() public view override returns (uint256 fee) {\n./packages/contracts/src/Raffle.sol:437:        fee = i_vrfV2PlusWrapper.calculateRequestPriceNative(callbackGasLimit, 1);\n./packages/contracts/src/Raffle.sol:446:    function vrfWrapper() public view override returns (IVRFV2PlusWrapper wrapper) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat WORKSPACE.md; rg -n -i 'wrapper|gas.price|quote|estimate|chainlink|trust|deploy' DESIGN.md; nl -ba packages/contracts/src/interfaces/IRaffle.sol | sed -n '345,375p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat WORKSPACE.md; rg -n -i 'wrapper|gas.price|quote|estimate|chainlink|trust|deploy' DESIGN.md; nl -ba packages/contracts/src/interfaces/IRaffle.sol | sed -n '345,375p'\"","aggregated_output":"# Dependency Workspace\n\nCurrent working directory / primary repository root: /workspace\nWorkspace manifest: WORKSPACE.json\nDependency repositories are checked out as top-level directories inside the same workspace root.\nWhen reporting file_path for dependency code, prefix it with the dependency alias directory.\nPrimary repository: clean-context @ LOCAL_SNAPSHOT\nNo dependency checkouts are listed in WORKSPACE.json.\n\nPath guidance:\n- Reference primary repo files relative to the workspace root.\n- Reference dependency files with their dependency directory prefix, e.g. `agave/...`.\n2:Ethereum NFT raffle; immutable factory, ERC-1167 clones with immutable implementation. One entry costs 1,000,000 units of canonical six-decimal USDC. One purchase mints a transferable ERC721 ticket representing a contiguous inclusive range. Exactly one ERC721 prize is escrowed atomically at creation. Reserve met awards NFT and 95% sponsor / 5% treasury. Reserve missed awards 80% gross to winner, 15% sponsor, 5% treasury. Refund outcome pays 100% per entry and returns prize. Rounding is floor on aggregate protocol fee; remainder must be allocated without loss. No administrator, mutable configuration or upgrade. Request window [sale end, end+2days); callback accepted strictly before request timestamp+2days. Refunds open at deadline. Callback records result only. Settlement is permissionless, storage-only; redemption requires current ticket owner, burns claim atomically, and must revert all effects on delivery failure. Sponsor and treasury can claim independently after settlement. Never move assets between raffle clones. Quote token and Chainlink wrapper are trusted canonical dependencies; arbitrary prize contracts and ticket recipients are untrusted. Frontend discovery is advisory; transaction decisions must reread current chain state.\n   345\t\n   346\t    /// @notice Releases the complete current sponsor-proceeds balance to the immutable sponsor recipient.\n   347\t    /// @return amount Raw six-decimal quote-token units paid in this release.\n   348\t    function releaseSponsorProceeds() external returns (uint256 amount);\n   349\t\n   350\t    /// @notice Releases the complete current protocol-fee balance to the immutable treasury.\n   351\t    /// @return amount Raw six-decimal quote-token units paid in this release.\n   352\t    function releaseProtocolFees() external returns (uint256 amount);\n   353\t\n   354\t    /// @notice Returns the escrowed prize to the immutable sponsor recipient after `CashWon` or `Refunding`.\n   355\t    function releaseSponsorPrize() external;\n   356\t\n   357\t    // External view functions\n   358\t\n   359\t    /// @notice Returns the wrapper's current native direct-funding price for the configured callback.\n   360\t    /// @return fee Native-token wei currently quoted by the wrapper; the value may change before request inclusion.\n   361\t    function getVrfRequestPrice() external view returns (uint256 fee);\n   362\t\n   363\t    /// @notice Estimates the native direct-funding price at a caller-selected gas price.\n   364\t    /// @param requestGasPriceWei Prospective transaction gas price in wei per gas.\n   365\t    /// @return fee Estimated native-token wei for the configured callback and one random word.\n   366\t    function estimateVrfRequestPrice(uint256 requestGasPriceWei) external view returns (uint256 fee);\n   367\t\n   368\t    /// @notice Returns the inclusive global entry range represented by a ticket ID.\n   369\t    /// @dev Returns zeros for an ID that has never been minted; ranges remain historical after ticket burns.\n   370\t    /// @param ticketId Sequential ticket ID to inspect.\n   371\t    /// @return firstEntry First represented one-based global entry, inclusive.\n   372\t    /// @return lastEntry Last represented one-based global entry, inclusive.\n   373\t    function ticketRange(uint256 ticketId) external view returns (uint128 firstEntry, uint128 lastEntry);\n   374\t\n   375\t    /// @notice Returns the exclusive deadline for initiating the draw.\n","exit_code":0,"status":"completed"}}
