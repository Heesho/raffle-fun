@openzeppelin/contracts/utils/math/Math.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/math/SafeCast.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Bytes.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Create2.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Context.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/Strings.sol\npackages/contracts/node_modules/@openzeppelin/contracts/utils/LowLevelCall.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC20.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/draft-IERC6093.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC1363.sol\npackages/contracts/node_modules/@openzeppelin/contracts/interfaces/IERC165.sol\npackages/contracts/package.json\npackages/contracts/remappings.txt\npackages/contracts/hardhat.config.ts\npackages/contracts/src/libraries/RaffleConstants.sol\npackages/contracts/src/RaffleFactory.sol\npackages/contracts/src/interfaces/IRaffle.sol\npackages/contracts/src/interfaces/IRaffleFactory.sol\npackages/contracts/src/Raffle.sol\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/contracts/node_modules/@chainlink/contracts/src/v0.8/vrf/dev/VRFV2PlusWrapperConsumerBase.sol; nl -ba packages/contracts/node_modules/@chainlink/contracts/src/v0.8/vrf/dev/interfaces/IVRFV2PlusWrapper.sol; nl -ba packages/contracts/src/libraries/RaffleConstants.sol'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/contracts/node_modules/@chainlink/contracts/src/v0.8/vrf/dev/VRFV2PlusWrapperConsumerBase.sol; nl -ba packages/contracts/node_modules/@chainlink/contracts/src/v0.8/vrf/dev/interfaces/IVRFV2PlusWrapper.sol; nl -ba packages/contracts/src/libraries/RaffleConstants.sol'","aggregated_output":"     1\t// SPDX-License-Identifier: MIT\n     2\tpragma solidity ^0.8.0;\n     3\t\n     4\timport {LinkTokenInterface} from \"../../shared/interfaces/LinkTokenInterface.sol\";\n     5\timport {IVRFV2PlusWrapper} from \"./interfaces/IVRFV2PlusWrapper.sol\";\n     6\t\n     7\t/**\n     8\t *\n     9\t * @notice Interface for contracts using VRF randomness through the VRF V2 wrapper\n    10\t * ********************************************************************************\n    11\t * @dev PURPOSE\n    12\t *\n    13\t * @dev Create VRF V2+ requests without the need for subscription management. Rather than creating\n    14\t * @dev and funding a VRF V2+ subscription, a user can use this wrapper to create one off requests,\n    15\t * @dev paying up front rather than at fulfillment.\n    16\t *\n    17\t * @dev Since the price is determined using the gas price of the request transaction rather than\n    18\t * @dev the fulfillment transaction, the wrapper charges an additional premium on callback gas\n    19\t * @dev usage, in addition to some extra overhead costs associated with the VRFV2Wrapper contract.\n    20\t * *****************************************************************************\n    21\t * @dev USAGE\n    22\t *\n    23\t * @dev Calling contracts must inherit from VRFV2PlusWrapperConsumerBase. The consumer must be funded\n    24\t * @dev with enough LINK or ether to make the request, otherwise requests will revert. To request randomness,\n    25\t * @dev call the 'requestRandomWords' function with the desired VRF parameters. This function handles\n    26\t * @dev paying for the request based on the current pricing.\n    27\t *\n    28\t * @dev Consumers must implement the fullfillRandomWords function, which will be called during\n    29\t * @dev fulfillment with the randomness result.\n    30\t */\n    31\tabstract contract VRFV2PlusWrapperConsumerBase {\n    32\t  error OnlyVRFWrapperCanFulfill(address have, address want);\n    33\t\n    34\t  LinkTokenInterface internal immutable i_linkToken;\n    35\t  IVRFV2PlusWrapper public immutable i_vrfV2PlusWrapper;\n    36\t\n    37\t  /**\n    38\t   * @param _vrfV2PlusWrapper is the address of the VRFV2Wrapper contract\n    39\t   */\n    40\t  constructor(\n    41\t    address _vrfV2PlusWrapper\n    42\t  ) {\n    43\t    IVRFV2PlusWrapper vrfV2PlusWrapper = IVRFV2PlusWrapper(_vrfV2PlusWrapper);\n    44\t\n    45\t    i_linkToken = LinkTokenInterface(vrfV2PlusWrapper.link());\n    46\t    i_vrfV2PlusWrapper = vrfV2PlusWrapper;\n    47\t  }\n    48\t\n    49\t  /**\n    50\t   * @dev Requests randomness from the VRF V2+ wrapper.\n    51\t   *\n    52\t   * @param _callbackGasLimit is the gas limit that should be used when calling the consumer's\n    53\t   *        fulfillRandomWords function.\n    54\t   * @param _requestConfirmations is the number of confirmations to wait before fulfilling the\n    55\t   *        request. A higher number of confirmations increases security by reducing the likelihood\n    56\t   *        that a chain re-org changes a published randomness outcome.\n    57\t   * @param _numWords is the number of random words to request.\n    58\t   *\n    59\t   * @return requestId is the VRF V2+ request ID of the newly created randomness request.\n    60\t   */\n    61\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    62\t  function requestRandomness(\n    63\t    uint32 _callbackGasLimit,\n    64\t    uint16 _requestConfirmations,\n    65\t    uint32 _numWords,\n    66\t    bytes memory extraArgs\n    67\t  ) internal returns (uint256 requestId, uint256 reqPrice) {\n    68\t    reqPrice = i_vrfV2PlusWrapper.calculateRequestPrice(_callbackGasLimit, _numWords);\n    69\t    i_linkToken.transferAndCall(\n    70\t      address(i_vrfV2PlusWrapper), reqPrice, abi.encode(_callbackGasLimit, _requestConfirmations, _numWords, extraArgs)\n    71\t    );\n    72\t    return (i_vrfV2PlusWrapper.lastRequestId(), reqPrice);\n    73\t  }\n    74\t\n    75\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    76\t  function requestRandomnessPayInNative(\n    77\t    uint32 _callbackGasLimit,\n    78\t    uint16 _requestConfirmations,\n    79\t    uint32 _numWords,\n    80\t    bytes memory extraArgs\n    81\t  ) internal returns (uint256 requestId, uint256 requestPrice) {\n    82\t    requestPrice = i_vrfV2PlusWrapper.calculateRequestPriceNative(_callbackGasLimit, _numWords);\n    83\t    return (\n    84\t      i_vrfV2PlusWrapper.requestRandomWordsInNative{value: requestPrice}(\n    85\t        _callbackGasLimit, _requestConfirmations, _numWords, extraArgs\n    86\t      ),\n    87\t      requestPrice\n    88\t    );\n    89\t  }\n    90\t\n    91\t  /**\n    92\t   * @notice fulfillRandomWords handles the VRF V2 wrapper response. The consuming contract must\n    93\t   * @notice implement it.\n    94\t   *\n    95\t   * @param _requestId is the VRF V2 request ID.\n    96\t   * @param _randomWords is the randomness result.\n    97\t   */\n    98\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    99\t  function fulfillRandomWords(uint256 _requestId, uint256[] memory _randomWords) internal virtual;\n   100\t\n   101\t  function rawFulfillRandomWords(uint256 _requestId, uint256[] memory _randomWords) external {\n   102\t    address vrfWrapperAddr = address(i_vrfV2PlusWrapper);\n   103\t    if (msg.sender != vrfWrapperAddr) {\n   104\t      revert OnlyVRFWrapperCanFulfill(msg.sender, vrfWrapperAddr);\n   105\t    }\n   106\t    fulfillRandomWords(_requestId, _randomWords);\n   107\t  }\n   108\t\n   109\t  /// @notice getBalance returns the native balance of the consumer contract\n   110\t  function getBalance() public view returns (uint256) {\n   111\t    return address(this).balance;\n   112\t  }\n   113\t\n   114\t  /// @notice getLinkToken returns the link token contract\n   115\t  function getLinkToken() public view returns (LinkTokenInterface) {\n   116\t    return i_linkToken;\n   117\t  }\n   118\t}\n     1\t// SPDX-License-Identifier: MIT\n     2\tpragma solidity ^0.8.0;\n     3\t\n     4\tinterface IVRFV2PlusWrapper {\n     5\t  /**\n     6\t   * @return the request ID of the most recent VRF V2 request made by this wrapper. This should only\n     7\t   * be relied option within the same transaction that the request was made.\n     8\t   */\n     9\t  function lastRequestId() external view returns (uint256);\n    10\t\n    11\t  /**\n    12\t   * @notice Calculates the price of a VRF request with the given callbackGasLimit at the current\n    13\t   * @notice block.\n    14\t   *\n    15\t   * @dev This function relies on the transaction gas price which is not automatically set during\n    16\t   * @dev simulation. To estimate the price at a specific gas price, use the estimatePrice function.\n    17\t   *\n    18\t   * @param _callbackGasLimit is the gas limit used to estimate the price.\n    19\t   * @param _numWords is the number of words to request.\n    20\t   */\n    21\t  function calculateRequestPrice(uint32 _callbackGasLimit, uint32 _numWords) external view returns (uint256);\n    22\t\n    23\t  /**\n    24\t   * @notice Calculates the price of a VRF request in native with the given callbackGasLimit at the current\n    25\t   * @notice block.\n    26\t   *\n    27\t   * @dev This function relies on the transaction gas price which is not automatically set during\n    28\t   * @dev simulation. To estimate the price at a specific gas price, use the estimatePrice function.\n    29\t   *\n    30\t   * @param _callbackGasLimit is the gas limit used to estimate the price.\n    31\t   * @param _numWords is the number of words to request.\n    32\t   */\n    33\t  function calculateRequestPriceNative(uint32 _callbackGasLimit, uint32 _numWords) external view returns (uint256);\n    34\t\n    35\t  /**\n    36\t   * @notice Estimates the price of a VRF request with a specific gas limit and gas price.\n    37\t   *\n    38\t   * @dev This is a convenience function that can be called in simulation to better understand\n    39\t   * @dev pricing.\n    40\t   *\n    41\t   * @param _callbackGasLimit is the gas limit used to estimate the price.\n    42\t   * @param _numWords is the number of words to request.\n    43\t   * @param _requestGasPriceWei is the gas price in wei used for the estimation.\n    44\t   */\n    45\t  function estimateRequestPrice(\n    46\t    uint32 _callbackGasLimit,\n    47\t    uint32 _numWords,\n    48\t    uint256 _requestGasPriceWei\n    49\t  ) external view returns (uint256);\n    50\t\n    51\t  /**\n    52\t   * @notice Estimates the price of a VRF request in native with a specific gas limit and gas price.\n    53\t   *\n    54\t   * @dev This is a convenience function that can be called in simulation to better understand\n    55\t   * @dev pricing.\n    56\t   *\n    57\t   * @param _callbackGasLimit is the gas limit used to estimate the price.\n    58\t   * @param _numWords is the number of words to request.\n    59\t   * @param _requestGasPriceWei is the gas price in wei used for the estimation.\n    60\t   */\n    61\t  function estimateRequestPriceNative(\n    62\t    uint32 _callbackGasLimit,\n    63\t    uint32 _numWords,\n    64\t    uint256 _requestGasPriceWei\n    65\t  ) external view returns (uint256);\n    66\t\n    67\t  /**\n    68\t   * @notice Requests randomness from the VRF V2 wrapper, paying in native token.\n    69\t   *\n    70\t   * @param _callbackGasLimit is the gas limit for the request.\n    71\t   * @param _requestConfirmations number of request confirmations to wait before serving a request.\n    72\t   * @param _numWords is the number of words to request.\n    73\t   */\n    74\t  function requestRandomWordsInNative(\n    75\t    uint32 _callbackGasLimit,\n    76\t    uint16 _requestConfirmations,\n    77\t    uint32 _numWords,\n    78\t    bytes calldata extraArgs\n    79\t  ) external payable returns (uint256 requestId);\n    80\t\n    81\t  function link() external view returns (address);\n    82\t  function linkNativeFeed() external view returns (address);\n    83\t}\n     1\t// SPDX-License-Identifier: MIT\n     2\tpragma solidity 0.8.36;\n     3\t\n     4\t/// @title raffle.fun Protocol Constants\n     5\t/// @author heesho\n     6\t/// @notice Defines the fixed v1 economics, timing, and bounded-execution limits shared by the factory and raffles.\n     7\t/// @dev Quote-token amounts use raw six-decimal units. Basis-point calculations round down through `Math.mulDiv`, and\n     8\t///      the sponsor receives the remaining raw units after winner and protocol allocations.\n     9\t/// @custom:version 1.0.0\n    10\tlibrary RaffleConstants {\n    11\t    /// @notice Denominator used for every global protocol basis-point rate.\n    12\t    uint256 internal constant BPS = 10_000;\n    13\t\n    14\t    /// @notice Global protocol fee rate: 500 basis points, or 5% of gross sales.\n    15\t    uint256 internal constant PROTOCOL_FEE_BPS = 500;\n    16\t\n    17\t    /// @notice Cash-result winner rate: 8,000 basis points, or 80% of gross sales.\n    18\t    uint256 internal constant CASH_WINNER_BPS = 8000;\n    19\t\n    20\t    /// @notice Global entry price: exactly 1,000,000 raw six-decimal quote-token units, or one USDC.\n    21\t    uint256 internal constant ENTRY_PRICE = 1_000_000;\n    22\t\n    23\t    /// @notice Decimal precision required from the immutable quote token.\n    24\t    uint8 internal constant QUOTE_TOKEN_DECIMALS = 6;\n    25\t\n    26\t    /// @notice Refund execution is bounded by tickets, while each ticket may represent any uint128 entry count.\n    27\t    uint256 internal constant MAX_REFUND_TICKET_BATCH_SIZE = 100;\n    28\t\n    29\t    /// @notice Maximum prospective raffle sale duration, measured from creation to the exclusive sale end.\n    30\t    uint256 internal constant MAX_SALE_DURATION = 30 days;\n    31\t\n    32\t    /// @notice Duration after sale end during which a sold raffle may initiate its draw, in seconds.\n    33\t    uint256 internal constant DRAW_REQUEST_TIMEOUT = 2 days;\n    34\t\n    35\t    /// @notice Duration after an accepted request during which its authenticated callback may resolve, in seconds.\n    36\t    uint256 internal constant DRAW_CALLBACK_TIMEOUT = 2 days;\n    37\t\n    38\t    /// @notice Gas-unit limit requested for the single-word Chainlink callback.\n    39\t    uint32 internal constant VRF_CALLBACK_GAS_LIMIT = 300_000;\n    40\t\n    41\t    /// @notice Block confirmations requested from Chainlink before callback fulfillment.\n    42\t    uint16 internal constant VRF_REQUEST_CONFIRMATIONS = 30;\n    43\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/contracts/src/RaffleFactory.sol; cat packages/contracts/package.json; cat packages/contracts/foundry.toml; cat packages/contracts/hardhat.config.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/contracts/src/RaffleFactory.sol; cat packages/contracts/package.json; cat packages/contracts/foundry.toml; cat packages/contracts/hardhat.config.ts'","aggregated_output":"     1\t// SPDX-License-Identifier: MIT\n     2\tpragma solidity 0.8.36;\n     3\t\n     4\timport { Clones } from \"@openzeppelin/contracts/proxy/Clones.sol\";\n     5\timport { IERC20Metadata } from \"@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol\";\n     6\timport { IERC721 } from \"@openzeppelin/contracts/token/ERC721/IERC721.sol\";\n     7\timport { ReentrancyGuard } from \"@openzeppelin/contracts/utils/ReentrancyGuard.sol\";\n     8\timport { IERC165 } from \"@openzeppelin/contracts/utils/introspection/IERC165.sol\";\n     9\t\n    10\timport { Raffle } from \"./Raffle.sol\";\n    11\timport { IRaffle } from \"./interfaces/IRaffle.sol\";\n    12\timport { IRaffleFactory } from \"./interfaces/IRaffleFactory.sol\";\n    13\timport { RaffleConstants } from \"./libraries/RaffleConstants.sol\";\n    14\t\n    15\t/// @title raffle.fun Canonical USDC Raffle Factory\n    16\t/// @author heesho\n    17\t/// @notice Atomically creates, funds, and registers autonomous fixed-implementation raffle clones.\n    18\t/// @dev The implementation, canonical six-decimal USDC, treasury, fee, and Chainlink configuration are immutable. The\n    19\t///      factory has no owner, pause, upgrade, rescue, or mutable protocol configuration.\n    20\t/// @custom:version 1.0.0\n    21\tcontract RaffleFactory is IRaffleFactory, ReentrancyGuard {\n    22\t    // Constants\n    23\t\n    24\t    /// @inheritdoc IRaffleFactory\n    25\t    uint32 public constant override callbackGasLimit = RaffleConstants.VRF_CALLBACK_GAS_LIMIT;\n    26\t\n    27\t    /// @inheritdoc IRaffleFactory\n    28\t    uint16 public constant override requestConfirmations = RaffleConstants.VRF_REQUEST_CONFIRMATIONS;\n    29\t\n    30\t    // Immutables and state\n    31\t\n    32\t    /// @inheritdoc IRaffleFactory\n    33\t    address public immutable override quoteToken;\n    34\t\n    35\t    /// @inheritdoc IRaffleFactory\n    36\t    address public immutable override vrfWrapper;\n    37\t\n    38\t    /// @inheritdoc IRaffleFactory\n    39\t    address public immutable override protocolTreasury;\n    40\t\n    41\t    /// @inheritdoc IRaffleFactory\n    42\t    address public immutable override raffleImplementation;\n    43\t\n    44\t    /// @inheritdoc IRaffleFactory\n    45\t    uint256 public override raffleCount;\n    46\t\n    47\t    /// @inheritdoc IRaffleFactory\n    48\t    mapping(uint256 raffleId => address raffle) public override raffleById;\n    49\t\n    50\t    /// @inheritdoc IRaffleFactory\n    51\t    mapping(address raffle => uint256 raffleId) public override idByRaffle;\n    52\t\n    53\t    /// @inheritdoc IRaffleFactory\n    54\t    mapping(address raffle => bool registered) public override isRaffle;\n    55\t\n    56\t    // Constructor\n    57\t\n    58\t    /// @notice Deploys the ownerless factory and its locked raffle implementation with one immutable configuration.\n    59\t    /// @dev The quote token must report exactly six decimals; the wrapper and quote token must contain deployed code.\n    60\t    ///      Deployment tooling must supply and verify the target chain's official USDC address because the constructor\n    61\t    ///      cannot prove token identity from metadata.\n    62\t    /// @param quoteToken_ Target chain's official six-decimal USDC contract trusted by every raffle.\n    63\t    /// @param vrfWrapper_ Official Chainlink VRF v2.5 native direct-funding wrapper for the target chain.\n    64\t    /// @param protocolTreasury_ Immutable protocol-fee recipient used by every raffle.\n    65\t    constructor(address quoteToken_, address vrfWrapper_, address protocolTreasury_) {\n    66\t        _requireContract(quoteToken_);\n    67\t        _requireContract(vrfWrapper_);\n    68\t        if (protocolTreasury_ == address(0)) revert ZeroAddress();\n    69\t\n    70\t        uint8 quoteDecimals = 0;\n    71\t        try IERC20Metadata(quoteToken_).decimals() returns (uint8 decimals_) {\n    72\t            quoteDecimals = decimals_;\n    73\t        } catch {\n    74\t            revert UnsupportedQuoteToken(quoteToken_);\n    75\t        }\n    76\t        if (quoteDecimals != RaffleConstants.QUOTE_TOKEN_DECIMALS) {\n    77\t            revert InvalidQuoteTokenDecimals(quoteDecimals, RaffleConstants.QUOTE_TOKEN_DECIMALS);\n    78\t        }\n    79\t\n    80\t        if (protocolTreasury_ == address(this) || protocolTreasury_ == quoteToken_ || protocolTreasury_ == vrfWrapper_)\n    81\t        {\n    82\t            revert UnsafeProtocolDestination(protocolTreasury_);\n    83\t        }\n    84\t\n    85\t        quoteToken = quoteToken_;\n    86\t        vrfWrapper = vrfWrapper_;\n    87\t        protocolTreasury = protocolTreasury_;\n    88\t\n    89\t        address implementation = address(new Raffle(quoteToken_, vrfWrapper_));\n    90\t        if (protocolTreasury_ == implementation) revert UnsafeProtocolDestination(protocolTreasury_);\n    91\t        raffleImplementation = implementation;\n    92\t    }\n    93\t\n    94\t    // External state-changing functions\n    95\t\n    96\t    /// @inheritdoc IRaffleFactory\n    97\t    function createRaffle(CreateRaffleParams calldata params) external override nonReentrant returns (address raffle) {\n    98\t        _validateCreateParams(params);\n    99\t        uint256 currentTime = block.timestamp;\n   100\t        if (params.endTime <= currentTime) revert InvalidEndTime(currentTime, params.endTime);\n   101\t        uint256 saleDuration = uint256(params.endTime) - currentTime;\n   102\t        if (saleDuration > RaffleConstants.MAX_SALE_DURATION) {\n   103\t            revert SaleDurationTooLong(saleDuration, RaffleConstants.MAX_SALE_DURATION);\n   104\t        }\n   105\t        uint256 raffleId = ++raffleCount;\n   106\t        raffle = Clones.clone(raffleImplementation);\n   107\t        // The fresh fixed-target clone can initialize only once; this function is nonReentrant and atomic.\n   108\t        // slither-disable-next-line reentrancy-no-eth\n   109\t        IRaffle(raffle)\n   110\t            .initialize(\n   111\t                IRaffle.RaffleInitParams({\n   112\t                sponsor: msg.sender,\n   113\t                sponsorRecipient: params.sponsorRecipient,\n   114\t                protocolTreasury: protocolTreasury,\n   115\t                prizeToken: params.prizeToken,\n   116\t                prizeTokenId: params.prizeTokenId,\n   117\t                raffleId: raffleId,\n   118\t                reserveEntries: params.reserveEntries,\n   119\t                endTime: params.endTime\n   120\t            })\n   121\t            );\n   122\t\n   123\t        raffleById[raffleId] = raffle;\n   124\t        idByRaffle[raffle] = raffleId;\n   125\t        isRaffle[raffle] = true;\n   126\t\n   127\t        IERC721 prize = IERC721(params.prizeToken);\n   128\t        prize.safeTransferFrom(msg.sender, raffle, params.prizeTokenId);\n   129\t        if (prize.ownerOf(params.prizeTokenId) != raffle) {\n   130\t            revert PrizeEscrowVerificationFailed(raffle, params.prizeToken, params.prizeTokenId);\n   131\t        }\n   132\t        if (IRaffle(raffle).status() != IRaffle.Status.Active) {\n   133\t            revert PrizeEscrowVerificationFailed(raffle, params.prizeToken, params.prizeTokenId);\n   134\t        }\n   135\t\n   136\t        emit RaffleCreated(\n   137\t            raffleId,\n   138\t            raffle,\n   139\t            msg.sender,\n   140\t            params.sponsorRecipient,\n   141\t            params.prizeToken,\n   142\t            params.prizeTokenId,\n   143\t            quoteToken,\n   144\t            protocolTreasury,\n   145\t            params.reserveEntries,\n   146\t            params.endTime\n   147\t        );\n   148\t    }\n   149\t\n   150\t    // Private view helpers\n   151\t\n   152\t    /// @dev Validates the sponsor-selected token, recipient, reserve, and supported ERC-721 interface before cloning.\n   153\t    /// @param params Prospective raffle configuration supplied by the sponsor.\n   154\t    function _validateCreateParams(CreateRaffleParams calldata params) private view {\n   155\t        _requireContract(params.prizeToken);\n   156\t        if (params.sponsorRecipient == address(0)) revert ZeroAddress();\n   157\t        if (\n   158\t            params.prizeToken == address(this) || params.prizeToken == quoteToken || params.prizeToken == vrfWrapper\n   159\t                || params.prizeToken == raffleImplementation || isRaffle[params.prizeToken]\n   160\t        ) {\n   161\t            revert UnsafeProtocolDestination(params.prizeToken);\n   162\t        }\n   163\t        if (\n   164\t            params.sponsorRecipient == address(this) || params.sponsorRecipient == quoteToken\n   165\t                || params.sponsorRecipient == vrfWrapper || params.sponsorRecipient == params.prizeToken\n   166\t                || params.sponsorRecipient == raffleImplementation || isRaffle[params.sponsorRecipient]\n   167\t        ) {\n   168\t            revert UnsafeProtocolDestination(params.sponsorRecipient);\n   169\t        }\n   170\t\n   171\t        bool supports721 = false;\n   172\t        try IERC165(params.prizeToken).supportsInterface(type(IERC721).interfaceId) returns (bool supported) {\n   173\t            supports721 = supported;\n   174\t        } catch {\n   175\t            revert UnsupportedPrizeToken(params.prizeToken);\n   176\t        }\n   177\t        if (!supports721) revert UnsupportedPrizeToken(params.prizeToken);\n   178\t        if (params.reserveEntries == 0) revert ZeroReserveEntries();\n   179\t    }\n   180\t\n   181\t    /// @dev Reverts unless an address contains deployed code.\n   182\t    /// @param account Address required to be a contract.\n   183\t    function _requireContract(address account) private view {\n   184\t        if (account.code.length == 0) revert NotContract(account);\n   185\t    }\n   186\t}\n{\n  \"name\": \"@raffle-fun/contracts\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.13 <23\"\n  },\n  \"scripts\": {\n    \"build\": \"hardhat compile && forge build\",\n    \"compile\": \"hardhat compile\",\n    \"test\": \"pnpm test:foundry && pnpm test:hardhat\",\n    \"test:foundry\": \"forge test\",\n    \"test:hardhat\": \"hardhat test nodejs\",\n    \"coverage\": \"forge coverage --report lcov --no-match-coverage '^(script/|src/mocks/|test/)' && node scripts/check-coverage.mjs\",\n    \"gas\": \"forge snapshot --check -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"gas:update\": \"forge snapshot -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"fmt\": \"forge fmt\",\n    \"fmt:check\": \"forge fmt --check\",\n    \"lint\": \"solhint 'src/**/*.sol' 'test/**/*.sol'\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"slither\": \"slither . --config-file slither.config.json\",\n    \"deploy:sepolia\": \"hardhat ignition deploy ignition/modules/RaffleFun.ts --network sepolia\",\n    \"verify:sepolia\": \"hardhat ignition verify chain-11155111\",\n    \"deployment:write\": \"tsx scripts/write-deployment.ts\"\n  },\n  \"dependencies\": {\n    \"@chainlink/contracts\": \"1.5.0\",\n    \"@openzeppelin/contracts\": \"5.6.1\"\n  },\n  \"devDependencies\": {\n    \"@nomicfoundation/hardhat-ignition\": \"3.1.8\",\n    \"@nomicfoundation/hardhat-ignition-viem\": \"3.1.6\",\n    \"@nomicfoundation/hardhat-toolbox-viem\": \"5.0.7\",\n    \"@types/node\": \"26.1.2\",\n    \"dotenv\": \"17.4.2\",\n    \"hardhat\": \"3.11.1\",\n    \"solhint\": \"6.2.3\",\n    \"tsx\": \"4.23.1\",\n    \"typescript\": \"6.0.3\",\n    \"viem\": \"2.55.10\",\n    \"zod\": \"4.4.3\"\n  }\n}\n[profile.default]\nsrc = \"src\"\ntest = \"test/foundry\"\nscript = \"script\"\nout = \"out\"\nlibs = [\"lib\", \"node_modules\"]\nsolc_version = \"0.8.36\"\nevm_version = \"cancun\"\noptimizer = true\noptimizer_runs = 200\nvia_ir = false\nfuzz = { runs = 1_000, seed = \"0x524146464c45\" }\ninvariant = { runs = 256, depth = 64, fail_on_revert = false }\ngas_reports = [\"Raffle\", \"RaffleFactory\"]\n\n[profile.ci]\nfuzz = { runs = 10_000 }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit]\nfuzz = { runs = 100_000, seed = \"0x41554449545f46555a5a\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit_strict]\nfuzz = { runs = 10_000, seed = \"0x41554449545f535452494354\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = true }\n\n[profile.audit_release]\nfuzz = { runs = 100_000, seed = \"0x52454c454153455f43414d504149474e\" }\ninvariant = { runs = 5_000, depth = 512, fail_on_revert = true, timeout = 3_600 }\n\n[profile.coverage]\nvia_ir = false\noptimizer = false\n\n[profile.comparison]\nvia_ir = true\noptimizer = true\noptimizer_runs = 1_000\n\n[fmt]\nline_length = 120\ntab_width = 4\nbracket_spacing = true\nint_types = \"long\"\nquote_style = \"double\"\nnumber_underscore = \"thousands\"\nsort_imports = true\nimport hardhatToolboxViemPlugin from \"@nomicfoundation/hardhat-toolbox-viem\";\nimport { configVariable, defineConfig } from \"hardhat/config\";\n\nexport default defineConfig({\n  plugins: [hardhatToolboxViemPlugin],\n  paths: {\n    sources: \"./src\",\n    tests: {\n      nodejs: \"./test/hardhat\",\n    },\n    cache: \"./cache/hardhat\",\n    artifacts: \"./artifacts\",\n  },\n  solidity: {\n    profiles: {\n      default: {\n        version: \"0.8.36\",\n        settings: {\n          optimizer: {\n            enabled: true,\n            runs: 200,\n          },\n          evmVersion: \"cancun\",\n        },\n      },\n      production: {\n        version: \"0.8.36\",\n        settings: {\n          optimizer: {\n            enabled: true,\n            runs: 200,\n          },\n          evmVersion: \"cancun\",\n        },\n      },\n    },\n  },\n  networks: {\n    hardhatEthereum: {\n      type: \"edr-simulated\",\n      chainType: \"l1\",\n      chainId: 31_337,\n    },\n    sepolia: {\n      type: \"http\",\n      chainType: \"l1\",\n      chainId: 11_155_111,\n      url: configVariable(\"SEPOLIA_RPC_URL\"),\n      accounts: [configVariable(\"DEPLOYER_PRIVATE_KEY\")],\n    },\n    mainnet: {\n      type: \"http\",\n      chainType: \"l1\",\n      chainId: 1,\n      url: configVariable(\"ETHEREUM_RPC_URL\"),\n      accounts: [configVariable(\"DEPLOYER_PRIVATE_KEY\")],\n    },\n  },\n});\n","exit_code":0,"status":"completed"}}
