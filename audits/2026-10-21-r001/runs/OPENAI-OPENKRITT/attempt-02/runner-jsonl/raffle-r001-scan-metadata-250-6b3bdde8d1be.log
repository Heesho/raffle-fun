v Since the price is determined using the gas price of the request transaction rather than\n    18\t * @dev the fulfillment transaction, the wrapper charges an additional premium on callback gas\n    19\t * @dev usage, in addition to some extra overhead costs associated with the VRFV2Wrapper contract.\n    20\t * *****************************************************************************\n    21\t * @dev USAGE\n    22\t *\n    23\t * @dev Calling contracts must inherit from VRFV2PlusWrapperConsumerBase. The consumer must be funded\n    24\t * @dev with enough LINK or ether to make the request, otherwise requests will revert. To request randomness,\n    25\t * @dev call the 'requestRandomWords' function with the desired VRF parameters. This function handles\n    26\t * @dev paying for the request based on the current pricing.\n    27\t *\n    28\t * @dev Consumers must implement the fullfillRandomWords function, which will be called during\n    29\t * @dev fulfillment with the randomness result.\n    30\t */\n    31\tabstract contract VRFV2PlusWrapperConsumerBase {\n    32\t  error OnlyVRFWrapperCanFulfill(address have, address want);\n    33\t\n    34\t  LinkTokenInterface internal immutable i_linkToken;\n    35\t  IVRFV2PlusWrapper public immutable i_vrfV2PlusWrapper;\n    36\t\n    37\t  /**\n    38\t   * @param _vrfV2PlusWrapper is the address of the VRFV2Wrapper contract\n    39\t   */\n    40\t  constructor(\n    41\t    address _vrfV2PlusWrapper\n    42\t  ) {\n    43\t    IVRFV2PlusWrapper vrfV2PlusWrapper = IVRFV2PlusWrapper(_vrfV2PlusWrapper);\n    44\t\n    45\t    i_linkToken = LinkTokenInterface(vrfV2PlusWrapper.link());\n    46\t    i_vrfV2PlusWrapper = vrfV2PlusWrapper;\n    47\t  }\n    48\t\n    49\t  /**\n    50\t   * @dev Requests randomness from the VRF V2+ wrapper.\n    51\t   *\n    52\t   * @param _callbackGasLimit is the gas limit that should be used when calling the consumer's\n    53\t   *        fulfillRandomWords function.\n    54\t   * @param _requestConfirmations is the number of confirmations to wait before fulfilling the\n    55\t   *        request. A higher number of confirmations increases security by reducing the likelihood\n    56\t   *        that a chain re-org changes a published randomness outcome.\n    57\t   * @param _numWords is the number of random words to request.\n    58\t   *\n    59\t   * @return requestId is the VRF V2+ request ID of the newly created randomness request.\n    60\t   */\n    61\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    62\t  function requestRandomness(\n    63\t    uint32 _callbackGasLimit,\n    64\t    uint16 _requestConfirmations,\n    65\t    uint32 _numWords,\n    66\t    bytes memory extraArgs\n    67\t  ) internal returns (uint256 requestId, uint256 reqPrice) {\n    68\t    reqPrice = i_vrfV2PlusWrapper.calculateRequestPrice(_callbackGasLimit, _numWords);\n    69\t    i_linkToken.transferAndCall(\n    70\t      address(i_vrfV2PlusWrapper), reqPrice, abi.encode(_callbackGasLimit, _requestConfirmations, _numWords, extraArgs)\n    71\t    );\n    72\t    return (i_vrfV2PlusWrapper.lastRequestId(), reqPrice);\n    73\t  }\n    74\t\n    75\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    76\t  function requestRandomnessPayInNative(\n    77\t    uint32 _callbackGasLimit,\n    78\t    uint16 _requestConfirmations,\n    79\t    uint32 _numWords,\n    80\t    bytes memory extraArgs\n    81\t  ) internal returns (uint256 requestId, uint256 requestPrice) {\n    82\t    requestPrice = i_vrfV2PlusWrapper.calculateRequestPriceNative(_callbackGasLimit, _numWords);\n    83\t    return (\n    84\t      i_vrfV2PlusWrapper.requestRandomWordsInNative{value: requestPrice}(\n    85\t        _callbackGasLimit, _requestConfirmations, _numWords, extraArgs\n    86\t      ),\n    87\t      requestPrice\n    88\t    );\n    89\t  }\n    90\t\n    91\t  /**\n    92\t   * @notice