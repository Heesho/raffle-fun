  "properties": [
    {
      "id": "P01",
      "property": "Fixed configuration and initialization",
      "source": "Raffle.sol 151-206; RaffleFactory.sol 65-92,97-125",
      "conclusion": "Reviewed: implementation initialized/Refunding; factory immutable; clone storage initialized once by that factory; no mutable configuration or upgrade path.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P02",
      "property": "Atomic prize escrow / registry",
      "source": "RaffleFactory.sol 97-147,154-178; Raffle.sol 416-430",
      "conclusion": "Reviewed: create, init, registry, safe transfer, ownership and Active checks are one transaction. Receiver matches token/id/from/operator. Honest asset semantics remain a trust limit (L-01).",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P03",
      "property": "Entry price / contiguous ranges / bounds",
      "source": "Raffle.sol 209-237; RaffleConstants.sol 20-27",
      "conclusion": "Reviewed: positive uint128 entry count, bounded sum, one ticket per purchase, exact entryCount*1,000,000. ticketCount cannot exceed totalEntries; pot multiplication is within uint256.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P04",
      "property": "Purchase callback / ticket transfer",
      "source": "Raffle.sol 209-237,497-502; ERC721.sol 115-136,216-307",
      "conclusion": "Reviewed: payment and range/liability effects precede safe-mint callback; guarded economic methods cannot be reentered; ordinary authorized ERC721 transfers preserve range claims.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P05",
      "property": "Request window and fee handling",
      "source": "Raffle.sol 240-273,458-465; VRFV2PlusWrapperConsumerBase.sol 76-88",
      "conclusion": "Reviewed: [end,end+2days), requires positive entries, native fee paid once, request ID persisted, excess refund failure reverts transaction. No repeated accepted request.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P06",
      "property": "Randomness authentication and callback bounds",
      "source": "Raffle.sol 509-524; VRFV2PlusWrapperConsumerBase.sol 101-107",
      "conclusion": "Reviewed: wrapper-only entry, Drawing/request-ID/one-word/in-flight/deadline guards; winner in [1,totalEntries]; no asset transfer or unbounded search in callback. Gas not measured.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P07",
      "property": "Refund eligibility and boundary races",
      "source": "Raffle.sol 276-301,458-465",
      "conclusion": "Reviewed: refunds at request/callback deadline inclusive, callbacks strictly before; empty raffle early sponsor cancellation or post-end permissionless cancellation; terminal branches do not revert to Drawing.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P08",
      "property": "Permissionless storage-only settlement",
      "source": "Raffle.sol 304-306,533-558,579-585",
      "conclusion": "Reviewed: winning range proven without owner call, unknown IDs yield zero range and cannot contain positive winning entry, one-time allocation with no external asset transfer. Burned-refund ticket cannot enter win branch.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P09",
      "property": "Conservation / fee rounding",
      "source": "Raffle.sol 223-234,296-299,468-474,539-555; Math.sol 206-277",
      "conclusion": "Reviewed: settled liabilities sum to gross pot; fee floor(5% gross), cash winner floor(80%), sponsor residual. At fixed price all percentage amounts are integral raw units. Donations stay outside accounting.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P10",
      "property": "Winner authority and atomic delivery",
      "source": "Raffle.sol 309-346; ERC721.sol 303-307",
      "conclusion": "Reviewed: current owner only, implicit settlement rollback on unauthorized call, burn and flags before transfer, transfer failure or ownership-check mismatch reverts all effects. L-01 limits permanent delivery liveness.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P11",
      "property": "Refund exactness / duplicates / bounded batch",
      "source": "Raffle.sol 349-372; RaffleConstants.sol 26-27",
      "conclusion": "Reviewed: 1..100 tickets, owner checks, historical inclusive ranges, burn then exact liability deduction and transfer. Duplicate/foreign/burned IDs revert atomically.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P12",
      "property": "Independent sponsor / treasury exits",
      "source": "Raffle.sol 375-407",
      "conclusion": "Reviewed: independently zeroed liabilities before safe transfer; sponsor prize return in CashWon/Refunding only; no need for winning owner to participate in settlement.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P13",
      "property": "Clone isolation and destination screening",
      "source": "Raffle.sol 187-195,497-502,564-567,593-604; RaffleFactory.sol 154-168",
      "conclusion": "Reviewed for same-factory known addresses; clone delegatecall storage independent and no shared pot. Universal cross-factory/future-address interpretation unresolved (L-02).",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P14",
      "property": "Dependencies and configuration",
      "source": "Context files plus native diagnosis",
      "conclusion": "Reviewed selected reachable dependency behavior; pinned package declarations/lockfile; zero-initialized clone reentrancy slot still locks because only ENTERED is rejected. Compilation and complete library audit unavailable.",
      "status": "MANUAL_SOURCE_REVIEWED",
      "execution": "NOT_RUN"
    },
    {
      "id": "P15",
