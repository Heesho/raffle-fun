{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["requirementId", "analysisFile", "verdict", "confidence", "evidence", "searched", "reasoning", "documentProblem"],
  "additionalProperties": false,
  "properties": {
    "requirementId": {"type": "string"},
    "analysisFile": {"type": "string"},
    "verdict": {"type": "string", "enum": ["implemented", "partial", "contradicted", "absent", "stronger-than-spec", "undecidable"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "lines", "quote", "role"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string"},
          "lines": {"type": "string"},
          "quote": {"type": "string"},
          "role": {"type": "string"}
        }
      }
    },
    "searched": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["where", "result"],
        "additionalProperties": false,
        "properties": {"where": {"type": "string"}, "result": {"type": "string"}}
      }
    },
    "reasoning": {"type": "string"},
    "documentProblem": {"type": ["string", "null"]}
  }
}
