{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["behaviors"],
  "additionalProperties": false,
  "properties": {
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "file", "lines", "whyItMatters", "reachableBy"],
        "additionalProperties": false,
        "properties": {
          "what": {"type": "string"},
          "file": {"type": "string"},
          "lines": {"type": "string"},
          "whyItMatters": {"type": "string"},
          "reachableBy": {"type": "string"}
        }
      }
    }
  }
}
