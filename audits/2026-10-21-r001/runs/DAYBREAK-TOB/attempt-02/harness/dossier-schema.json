{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["dossierFile", "dossierMarkdown", "trustBoundaries", "fragilityClusters", "unenforcedAssumptions", "unresolved", "filesReviewed"],
  "properties": {
    "dossierFile": {"type": "string"},
    "dossierMarkdown": {"type": "string"},
    "trustBoundaries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["actor", "entrypoint", "reaches"], "properties": {"actor": {"type": "string"}, "entrypoint": {"type": "string"}, "reaches": {"type": "string"}}}},
    "fragilityClusters": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["area", "why"], "properties": {"area": {"type": "string"}, "why": {"type": "string"}}}},
    "unenforcedAssumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "filesReviewed": {"type": "array", "items": {"type": "string"}}
  }
}
