nt256 cashAmount) {\npackages/contracts/src/Raffle.sol:310:        if (winnerRedeemed) revert WinningTicketAlreadyRedeemed();\npackages/contracts/src/Raffle.sol:315:            _settleWinningTicket(ticketId);\npackages/contracts/src/Raffle.sol:316:        } else if (ticketId != winningTicketId) {\npackages/contracts/src/Raffle.sol:317:            revert WinningTicketMismatch(ticketId, winningTicketId);\npackages/contracts/src/Raffle.sol:321:        if (msg.sender != winner) revert NotTicketOwner(ticketId, msg.sender, winner);\npackages/contracts/src/Raffle.sol:325:        _burn(ticketId);\npackages/contracts/src/Raffle.sol:334:            prizeToken.transferFrom(address(this), winner, deliveredPrizeTokenId);\npackages/contracts/src/Raffle.sol:342:            _transferQuote(winner, cashAmount);\npackages/contracts/src/Raffle.sol:345:        emit WinningTicketRedeemed(ticketId, winner, result, cashAmount, deliveredPrizeToken, deliveredPrizeTokenId);\npackages/contracts/src/Raffle.sol:349:    function refundTickets(uint256[] calldata ticketIds) external override nonReentrant returns (uint256 amount) {\npackages/contracts/src/Raffle.sol:350:        _requireStatus(Status.Refunding);\npackages/contracts/src/Raffle.sol:353:            revert InvalidTicketBatchSize(ticketQuantity, RaffleConstants.MAX_REFUND_TICKET_BATCH_SIZE);\npackages/contracts/src/Raffle.sol:360:            if (msg.sender != owner) revert NotTicketOwner(ticketId, msg.sender, owner);\npackages/contracts/src/Raffle.sol:364:            _burn(ticketId);\npackages/contracts/src/Raffle.sol:369:        _transferQuote(msg.sender, amount);\npackages/contracts/src/Raffle.sol:371:        emit TicketsRefunded(msg.sender, ticketQuantity, aggregateEntries, amount, liabilityAfter);\npackages/contracts/src/Raffle.sol:380:        _transferQuote(recipient, amount);\npackages/contracts/src/Raffle.sol:390:        _transferQuote(treasury, amount);\npackages/contracts/src/Raffle.sol:397:        if (currentStatus != Status.Cas