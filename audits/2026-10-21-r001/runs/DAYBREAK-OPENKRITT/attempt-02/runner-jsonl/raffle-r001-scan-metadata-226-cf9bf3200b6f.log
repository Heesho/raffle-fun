{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"rg -n \\\"releaseSponsorPrize|sponsor prize|SponsorPrize|CashWon|Refunding\\\" README.md packages --glob '\"'!packages/contracts/node_modules/**'\"' --glob '\"'!**/dist/**'\"' --glob '\"'!**/.next/**'\"'\"","aggregated_output":"rg: README.md: IO error for operation on README.md: No such file or directory (os error 2)\npackages/contracts/src/interfaces/IRaffle.sol:31:        CashWon,\npackages/contracts/src/interfaces/IRaffle.sol:33:        Refunding\npackages/contracts/src/interfaces/IRaffle.sol:107:    /// @param result Final `NftWon` or `CashWon` result.\npackages/contracts/src/interfaces/IRaffle.sol:118:    /// @param result Final `NftWon` or `CashWon` result.\npackages/contracts/src/interfaces/IRaffle.sol:134:    /// @param result Final `NftWon` or `CashWon` result.\npackages/contracts/src/interfaces/IRaffle.sol:135:    /// @param cashAmount Raw six-decimal quote-token units paid for `CashWon`; zero for `NftWon`.\npackages/contracts/src/interfaces/IRaffle.sol:136:    /// @param prizeToken ERC-721 prize contract for `NftWon`; the zero address for `CashWon`.\npackages/contracts/src/interfaces/IRaffle.sol:137:    /// @param prizeTokenId ERC-721 prize token ID for `NftWon`; zero for `CashWon`.\npackages/contracts/src/interfaces/IRaffle.sol:178:    event SponsorPrizeReleased(\npackages/contracts/src/interfaces/IRaffle.sol:292:    /// @notice Raised when the sponsor prize cannot be returned in the current result state.\npackages/contracts/src/interfaces/IRaffle.sol:294:    error SponsorPrizeUnavailable(Status status);\npackages/contracts/src/interfaces/IRaffle.sol:337:    /// @return cashAmount Raw six-decimal quote-token units paid for `CashWon`, or zero for `NftWon`.\npackages/contracts/src/interfaces/IRaffle.sol:354:    /// @notice Returns the escrowed prize to the immutable sponsor recipient after `CashWon` or `Refunding`.\npackages/contracts/src/interfaces/IRaffle.sol:355:    function releaseSponsorPrize() external;\npackages/contracts/src/Raffle.sol:165:        status = Status.Refunding;\npackages/contracts/src/Raffle.sol:299:        status = Status.Refunding;\npackages/contracts/src/Raffle.sol:312:        if (result != Status.NftWon && result != Status.CashWon) revert InvalidStatus(result);\npackages/contracts/src/Raffle.sol:350:        _requireStatus(Status.Refunding);\npackages/contracts/src/Raffle.sol:395:    function releaseSponsorPrize() external override nonReentrant {\npackages/contracts/src/Raffle.sol:397:        if (currentStatus != Status.CashWon && currentStatus != Status.Refunding) {\npackages/contracts/src/Raffle.sol:398:            revert SponsorPrizeUnavailable(currentStatus);\npackages/contracts/src/Raffle.sol:406:        emit SponsorPrizeReleased(msg.sender, recipient, address(prizeToken), prizeTokenId);\npackages/contracts/src/Raffle.sol:521:        status = totalEntries >= reserveEntries ? Status.NftWon : Status.CashWon;\npackages/contracts/src/Raffle.sol:536:        if (result != Status.NftWon && result != Status.CashWon) revert InvalidStatus(result);\n","exit_code":2,"status":"failed"}}
