{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/node_modules/@openzeppelin/contracts/proxy/Clones.sol | sed -n '1,220p'\nrg -n \\\"protocolTreasury|UnsafeProtocolDestination|clone\\\\(\\\" /workspace --glob '\"'!packages/contracts/node_modules/**'\"'\"","aggregated_output":"     1\t// SPDX-License-Identifier: MIT\n     2\t// OpenZeppelin Contracts (last updated v5.5.0) (proxy/Clones.sol)\n     3\t\n     4\tpragma solidity ^0.8.20;\n     5\t\n     6\timport {Create2} from \"../utils/Create2.sol\";\n     7\timport {Errors} from \"../utils/Errors.sol\";\n     8\t\n     9\t/**\n    10\t * @dev https://eips.ethereum.org/EIPS/eip-1167[ERC-1167] is a standard for\n    11\t * deploying minimal proxy contracts, also known as \"clones\".\n    12\t *\n    13\t * > To simply and cheaply clone contract functionality in an immutable way, this standard specifies\n    14\t * > a minimal bytecode implementation that delegates all calls to a known, fixed address.\n    15\t *\n    16\t * The library includes functions to deploy a proxy using either `create` (traditional deployment) or `create2`\n    17\t * (salted deterministic deployment). It also includes functions to predict the addresses of clones deployed using the\n    18\t * deterministic method.\n    19\t */\n    20\tlibrary Clones {\n    21\t    error CloneArgumentsTooLong();\n    22\t\n    23\t    /**\n    24\t     * @dev Deploys and returns the address of a clone that mimics the behavior of `implementation`.\n    25\t     *\n    26\t     * This function uses the create opcode, which should never revert.\n    27\t     *\n    28\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    29\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    30\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    31\t     */\n    32\t    function clone(address implementation) internal returns (address instance) {\n    33\t        return clone(implementation, 0);\n    34\t    }\n    35\t\n    36\t    /**\n    37\t     * @dev Same as {xref-Clones-clone-address-}[clone], but with a `value` parameter to send native currency\n    38\t     * to the new contract.\n    39\t     *\n    40\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    41\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    42\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    43\t     *\n    44\t     * NOTE: Using a non-zero value at creation will require the contract using this function (e.g. a factory)\n    45\t     * to always have enough balance for new deployments. Consider exposing this function under a payable method.\n    46\t     */\n    47\t    function clone(address implementation, uint256 value) internal returns (address instance) {\n    48\t        if (address(this).balance < value) {\n    49\t            revert Errors.InsufficientBalance(address(this).balance, value);\n    50\t        }\n    51\t        assembly (\"memory-safe\") {\n    52\t            // Cleans the upper 96 bits of the `implementation` word, then packs the first 3 bytes\n    53\t            // of the `implementation` address with the bytecode before the address.\n    54\t            mstore(0x00, or(shr(232, shl(96, implementation)), 0x3d602d80600a3d3981f3363d3d373d3d3d363d73000000))\n    55\t            // Packs the remaining 17 bytes of `implementation` with the bytecode after the address.\n    56\t            mstore(0x20, or(shl(120, implementation), 0x5af43d82803e903d91602b57fd5bf3))\n    57\t            instance := create(value, 0x09, 0x37)\n    58\t        }\n    59\t        if (instance == address(0)) {\n    60\t            revert Errors.FailedDeployment();\n    61\t        }\n    62\t    }\n    63\t\n    64\t    /**\n    65\t     * @dev Deploys and returns the address of a clone that mimics the behavior of `implementation`.\n    66\t     *\n    67\t     * This function uses the create2 opcode and a `salt` to deterministically deploy\n    68\t     * the clone. Using the same `implementation` and `salt` multiple times will revert, since\n    69\t     * the clones cannot be deployed twice at the same address.\n    70\t     *\n    71\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    72\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    73\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    74\t     */\n    75\t    function cloneDeterministic(address implementation, bytes32 salt) internal returns (address instance) {\n    76\t        return cloneDeterministic(implementation, salt, 0);\n    77\t    }\n    78\t\n    79\t    /**\n    80\t     * @dev Same as {xref-Clones-cloneDeterministic-address-bytes32-}[cloneDeterministic], but with\n    81\t     * a `value` parameter to send native currency to the new contract.\n    82\t     *\n    83\t     * WARNING: This function does not check if `implementation` has code. A clone that points to an address\n    84\t     * without code cannot be initialized. Initialization calls may appear to be successful when, in reality, they\n    85\t     * have no effect and leave the clone uninitialized, allowing a third party to initialize it later.\n    86\t     *\n    87\t     * NOTE: Using a non-zero value at creation will require the contract using this function (e.g. a factory)\n    88\t     * to always have enough balance for new deployments. Consider exposing this function under a payable method.\n    89\t     */\n    90\t    function cloneDeterministic(\n    91\t        address implementation,\n    92\t        bytes32 salt,\n    93\t        uint256 value\n    94\t    ) internal returns (address instance) {\n    95\t        if (address(this).balance < value) {\n    96\t            revert Errors.InsufficientBalance(address(this).balance, value);\n    97\t        }\n    98\t        assembly (\"memory-safe\") {\n    99\t            // Cleans the upper 96 bits of the `implementation` word, then packs the first 3 bytes\n   100\t            // of the `implementation` address with the bytecode before the address.\n   101\t            mstore(0x00, or(shr(232, shl(96, implementation)), 0x3d602d80600a3d3981f3363d3d373d3d3d363d73000000))\n   102\t            // Packs the remaining 17 bytes of `implementation` with the bytecode after the address.\n   103\t            mstore(0x20, or(shl(120, implementation), 0x5af43d82803e903d91602b57fd5bf3))\n   104\t            instance := create2(value, 0x09, 0x37, salt)\n   105\t        }\n   106\t        if (instance == address(0)) {\n   107\t            revert Errors.FailedDeployment();\n   108\t        }\n   109\t    }\n   110\t\n   111\t    /**\n   112\t     * @dev Computes the address of a clone deployed using {Clones-cloneDeterministic}.\n   113\t     */\n   114\t    function predictDeterministicAddress(\n   115\t        address implementation,\n   116\t        bytes32 salt,\n   117\t        address deployer\n   118\t    ) internal pure returns (address predicted) {\n   119\t        assembly (\"memory-safe\") {\n   120\t            let ptr := mload(0x40)\n   121\t            mstore(add(ptr, 0x38), deployer)\n   122\t            mstore(add(ptr, 0x24), 0x5af43d82803e903d91602b57fd5bf3ff)\n   123\t            mstore(add(ptr, 0x14), implementation)\n   124\t            mstore(ptr, 0x3d602d80600a3d3981f3363d3d373d3d3d363d73)\n   125\t            mstore(add(ptr, 0x58), salt)\n   126\t            mstore(add(ptr, 0x78), keccak256(add(ptr, 0x0c), 0x37))\n   127\t            predicted := and(k