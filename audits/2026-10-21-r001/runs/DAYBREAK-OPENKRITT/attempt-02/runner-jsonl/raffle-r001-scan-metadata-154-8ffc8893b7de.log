// Any calls to nonReentrant after this point will fail\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:99:        _reentrancyGuardStorageSlot().getUint256Slot().value = ENTERED;\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:102:    function _nonReentrantAfter() private {\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:105:        _reentrancyGuardStorageSlot().getUint256Slot().value = NOT_ENTERED;\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:109:     * @dev Returns true if the reentrancy guard is currently set to \"entered\", which indicates there is a\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:110:     * `nonReentrant` function in the call stack.\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:112:    function _reentrancyGuardEntered() internal view returns (bool) {\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:113:        return _reentrancyGuardStorageSlot().getUint256Slot().value == ENTERED;\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:116:    function _reentrancyGuardStorageSlot() internal pure virtual returns (bytes32) {\npackages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol:117:        return REENTRANCY_GUARD_STORAGE;\npackages/contracts/src/RaffleFactory.sol:7:import { ReentrancyGuard } from \"@openzeppelin/contracts/utils/ReentrancyGuard.sol\";\npackages/contracts/src/RaffleFactory.sol:21:contract RaffleFactory is IRaffleFactory, ReentrancyGuard {\npackages/contracts/src/RaffleFactory.sol:97:    function createRaffle(CreateRaffleParams calldata params) external override nonReentrant returns (address raffle) {\npackages/contracts/src/RaffleFactory.sol:107:        // The fresh fixed-target clone can initialize only once; this function is nonReentrant and atomic.\npackages/contracts/src/RaffleFactory.sol:108:        // slither-disable-next-line reentrancy-no-eth\npackages/contracts/src/interfaces/IRaffle.sol:331:    function settleWinningTicket(uint256 ticketId) external returns (uint256 cashAmount);\npackages/contracts/src/Raffle.sol:12:import { ReentrancyGuard } from \"@openzeppelin/contracts/utils/ReentrancyGuard.sol\";\npackages/contracts/src/Raffle.sol:28:contract Raffle is IRaffle, ERC721, ReentrancyGuard, IERC721Receiver, VRFV2PlusWrapperConsumerBase {\npackages/contracts/src/Raffle.sol:212:        nonReentrant\npackages/contracts/src/Raffle.sol:240:    function requestDraw() external payable override nonReentrant returns (uint256 requestId) {\npackages/contracts/src/Raffle.sol:276:    function enableRefunds() external override nonReentrant {\npackages/contracts/src/Raffle.sol:304:    function settleWinningTicket(uint256 ticketId) external override nonReentrant returns (uint256 cashAmount) {\npackages/contracts/src/Raffle.sol:305:        cashAmount = _settleWinningTicket(ticketId);\npackages/contracts/src/Raffle.sol:309:    function redeemWinningTicket(uint256 ticketId) external override nonReentrant returns (uint256 cashAmount) {\npackages/contracts/src/Raffle.sol:315:            _settleWinningTicket(ticketId);\npackages/contracts/src/Raffle.sol:349:    function refundTickets(uint256[] calldata ticketIds) external override nonReentrant returns (uint256 amount) {\npackages/contracts/src/Raffle.sol:375:    function releaseSponsorProceeds() external override nonReentrant returns (uint256 amount) {\npackages/contracts/src/Raffle.sol:385:    function releaseProtocolFees() external override nonReentrant returns (uint256 amount) {\npackages/contracts/src/Raffle.sol:395:    function releaseSponsorPrize() external override nonReentrant {\npackages/contracts/src/Raffle.sol:533:    function _settleWinningTicket(uint256 ticketId) private returns (uint256 cashAmount) {\npackages/contracts/foundry.toml\npackages/contracts/package.json\npackages/contracts/remappings.txt\nfatal: not a git repository (or any parent up to mount point /)\nStopping at filesystem boundary (GIT_DISCOVERY_ACROSS_FILESYSTEM not set).\n","exit_code":0,"status":"completed"}}
