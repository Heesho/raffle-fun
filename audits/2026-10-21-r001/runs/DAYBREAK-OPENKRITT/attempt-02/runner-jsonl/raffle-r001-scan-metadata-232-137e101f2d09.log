ts/src/v0.8/vrf/dev/VRFV2PlusWrapperConsumerBase.sol:104:      revert OnlyVRFWrapperCanFulfill(msg.sender, vrfWrapperAddr);\npackages/contracts/node_modules/@chainlink/contracts/src/v0.8/vrf/dev/interfaces/IVRFV2PlusWrapper.sol:6:   * @return the request ID of the most recent VRF V2 request made by this wrapper. This should only\npackages/contracts/node_modules/@chainlink/contracts/src/v0.8/vrf/dev/interfaces/IVRFV2PlusWrapper.sol:68:   * @notice Requests randomness from the VRF V2 wrapper, paying in native token.\npackages/contracts/src/RaffleFactory.sol:36:    address public immutable override vrfWrapper;\npackages/contracts/src/RaffleFactory.sol:59:    /// @dev The quote token must report exactly six decimals; the wrapper and quote token must contain deployed code.\npackages/contracts/src/RaffleFactory.sol:63:    /// @param vrfWrapper_ Official Chainlink VRF v2.5 native direct-funding wrapper for the target chain.\npackages/contracts/src/RaffleFactory.sol:65:    constructor(address quoteToken_, address vrfWrapper_, address protocolTreasury_) {\npackages/contracts/src/RaffleFactory.sol:67:        _requireContract(vrfWrapper_);\npackages/contracts/src/RaffleFactory.sol:80:        if (protocolTreasury_ == address(this) || protocolTreasury_ == quoteToken_ || protocolTreasury_ == vrfWrapper_)\npackages/contracts/src/RaffleFactory.sol:86:        vrfWrapper = vrfWrapper_;\npackages/contracts/src/RaffleFactory.sol:89:        address implementation = address(new Raffle(quoteToken_, vrfWrapper_));\npackages/contracts/src/RaffleFactory.sol:158:            params.prizeToken == address(this) || params.prizeToken == quoteToken || params.prizeToken == vrfWrapper\npackages/contracts/src/RaffleFactory.sol:165:                || params.sponsorRecipient == vrfWrapper || params.sponsorRecipient == params.prizeToken\npackages/contracts/src/interfaces/IRaffle.sol:85:    /// @param fee Native-token wei actually paid to the wrapper for the request.\npackages/contracts/src/interfaces/IRa