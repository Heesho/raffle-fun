{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol | sed -n '1,150p'; nl -ba packages/contracts/node_modules/@chainlink/contracts/src/v0.8/vrf/dev/VRFV2PlusWrapperConsumerBase.sol | sed -n '1,260p'; nl -ba packages/contracts/src/RaffleFactory.sol | sed -n '65,180p'; nl -ba packages/contracts/src/libraries/RaffleConstants.sol | sed -n '20,50p'\"","aggregated_output":"     1\t// SPDX-License-Identifier: MIT\n     2\t// OpenZeppelin Contracts (last updated v5.5.0) (utils/ReentrancyGuard.sol)\n     3\t\n     4\tpragma solidity ^0.8.20;\n     5\t\n     6\timport {StorageSlot} from \"./StorageSlot.sol\";\n     7\t\n     8\t/**\n     9\t * @dev Contract module that helps prevent reentrant calls to a function.\n    10\t *\n    11\t * Inheriting from `ReentrancyGuard` will make the {nonReentrant} modifier\n    12\t * available, which can be applied to functions to make sure there are no nested\n    13\t * (reentrant) calls to them.\n    14\t *\n    15\t * Note that because there is a single `nonReentrant` guard, functions marked as\n    16\t * `nonReentrant` may not call one another. This can be worked around by making\n    17\t * those functions `private`, and then adding `external` `nonReentrant` entry\n    18\t * points to them.\n    19\t *\n    20\t * TIP: If EIP-1153 (transient storage) is available on the chain you're deploying at,\n    21\t * consider using {ReentrancyGuardTransient} instead.\n    22\t *\n    23\t * TIP: If you would like to learn more about reentrancy and alternative ways\n    24\t * to protect against it, check out our blog post\n    25\t * https://blog.openzeppelin.com/reentrancy-after-istanbul/[Reentrancy After Istanbul].\n    26\t *\n    27\t * IMPORTANT: Deprecated. This storage-based reentrancy guard will be removed and replaced\n    28\t * by the {ReentrancyGuardTransient} variant in v6.0.\n    29\t *\n    30\t * @custom:stateless\n    31\t */\n    32\tabstract contract ReentrancyGuard {\n    33\t    using StorageSlot for bytes32;\n    34\t\n    35\t    // keccak256(abi.encode(uint256(keccak256(\"openzeppelin.storage.ReentrancyGuard\")) - 1)) & ~bytes32(uint256(0xff))\n    36\t    bytes32 private constant REENTRANCY_GUARD_STORAGE =\n    37\t        0x9b779b17422d0df92223018b32b4d1fa46e071723d6817e2486d003becc55f00;\n    38\t\n    39\t    // Booleans are more expensive than uint256 or any type that takes up a full\n    40\t    // word because each write operation emits an extra SLOAD to first read the\n    41\t    // slot's contents, replace the bits taken up by the boolean, and then write\n    42\t    // back. This is the compiler's defense against contract upgrades and\n    43\t    // pointer aliasing, and it cannot be disabled.\n    44\t\n    45\t    // The values being non-zero value makes deployment a bit more expensive,\n    46\t    // but in exchange the refund on every call to nonReentrant will be lower in\n    47\t    // amount. Since refunds are capped to a percentage of the total\n    48\t    // transaction's gas, it is best to keep them low in cases like this one, to\n    49\t    // increase the likelihood of the full refund coming into effect.\n    50\t    uint256 private constant NOT_ENTERED = 1;\n    51\t    uint256 private constant ENTERED = 2;\n    52\t\n    53\t    /**\n    54\t     * @dev Unauthorized reentrant call.\n    55\t     */\n    56\t    error ReentrancyGuardReentrantCall();\n    57\t\n    58\t    constructor() {\n    59\t        _reentrancyGuardStorageSlot().getUint256Slot().value = NOT_ENTERED;\n    60\t    }\n    61\t\n    62\t    /**\n    63\t     * @dev Prevents a contract from calling itself, directly or indirectly.\n    64\t     * Calling a `nonReentrant` function from another `nonReentrant`\n    65\t     * function is not supported. It is possible to prevent this from happening\n    66\t     * by making the `nonReentrant` function external, and making it call a\n    67\t     * `private` function that does the actual work.\n    68\t     */\n    69\t    modifier nonReentrant() {\n    70\t        _nonReentrantBefore();\n    71\t        _;\n    72\t        _nonReentrantAfter();\n    73\t    }\n    74\t\n    75\t    /**\n    76\t     * @dev A `view` only version of {nonReentrant}. Use to block view functions\n    77\t     * from being called, preventing reading from inconsistent contract state.\n    78\t     *\n    79\t     * CAUTION: This is a \"view\" modifier and does not change the reentrancy\n    80\t     * status. Use it only on view functions. For payable or non-payable functions,\n    81\t     * use the standard {nonReentrant} modifier instead.\n    82\t     */\n    83\t    modifier nonReentrantView() {\n    84\t        _nonReentrantBeforeView();\n    85\t        _;\n    86\t    }\n    87\t\n    88\t    function _nonReentrantBeforeView() private view {\n    89\t        if (_reentrancyGuardEntered()) {\n    90\t            revert ReentrancyGuardReentrantCall();\n    91\t        }\n    92\t    }\n    93\t\n    94\t    function _nonReentrantBefore() private {\n    95\t        // On the first call to nonReentrant, _status will be NOT_ENTERED\n    96\t        _nonReentrantBeforeView();\n    97\t\n    98\t        // Any calls to nonReentrant after this point will fail\n    99\t        _reentrancyGuardStorageSlot().getUint256Slot().value = ENTERED;\n   100\t    }\n   101\t\n   102\t    function _nonReentrantAfter() private {\n   103\t        // By storing the original value once again, a refund is triggered (see\n   104\t        // https://eips.ethereum.org/EIPS/eip-2200)\n   105\t        _reentrancyGuardStorageSlot().getUint256Slot().value = NOT_ENTERED;\n   106\t    }\n   107\t\n   108\t    /**\n   109\t     * @dev Returns true if the reentrancy guard is currently set to \"entered\", which indicates there is a\n   110\t     * `nonReentrant` function in the call stack.\n   111\t     */\n   112\t    function _reentrancyGuardEntered() internal view returns (bool) {\n   113\t        return _reentrancyGuardStorageSlot().getUint256Slot().value == ENTERED;\n   114\t    }\n   115\t\n   116\t    function _reentrancyGuardStorageSlot() internal pure virtual returns (bytes32) {\n   117\t        return REENTRANCY_GUARD_STORAGE;\n   118\t    }\n   119\t}\n     1\t// SPDX-License-Identifier: MIT\n     2\tpragma solidity ^0.8.0;\n     3\t\n     4\timport {LinkTokenInterface} from \"../../shared/interfaces/LinkTokenInterface.sol\";\n     5\timport {IVRFV2PlusWrapper} from \"./interfaces/IVRFV2PlusWrapper.sol\";\n     6\t\n     7\t/**\n     8\t *\n     9\t * @notice Interface for contracts using VRF randomness through the VRF V2 wrapper\n    10\t * ********************************************************************************\n    11\t * @dev PURPOSE\n    12\t *\n    13\t * @dev Create VRF V2+ requests without the need for subscription management. Rather than creating\n    14\t * @dev and funding a VRF V2+ subscription, a user can use this wrapper to create one off requests,\n    15\t * @dev paying up front rather than at fulfillment.\n    16\t *\n    17\t * @dev Since the price is determined using the gas price of the request transaction rather than\n    18\t * @dev the fulfillment transaction, the wrapper charges an additional premium on callback gas\n    19\t * @dev usage, in addition to some extra overhead costs associated with the VRFV2Wrapper contract.\n    20\t * *****************************************************************************\n    21\t * @dev USAGE\n    22\t *\n    23\t * @dev Calling contracts must inherit from VRFV2PlusWrapperConsumerBase. The consumer must be funded\n    24\t * @dev with enough LINK or ether to make the request, otherwise requests will revert. To request randomness,\n    25\t * @dev call the 'requestRandomWords' function with the desired VRF parameters. This function handles\n    26\t * @dev paying for the request based on the current pricing.\n    27\t *\n    28\t * @dev Consumers must implement the fullfillRandomWords function, which will be called during\n    29\t * @dev fulfillment with the randomness result.\n    30\t */\n    31\tabstract contract VRFV2PlusWrapperConsumerBase {\n    32\t  error OnlyVRFWrapperCanFulfill(address have, address want);\n    33\t\n    34\t  LinkTokenInterface internal immutable i_linkToken;\n    35\t  IVRFV2PlusWrapper public immutable i_vrfV2PlusWrapper;\n    36\t\n    37\t  /**\n    38\t   * @param _vrfV2PlusWrapper is the address of the VRFV2Wrapper contract\n    39\t   */\n    40\t  constructor(\n    41\t    address _vrfV2PlusWrapper\n    42\t  ) {\n    43\t    IVRFV2PlusWrapper vrfV2PlusWrapper = IVRFV2PlusWrapper(_vrfV2PlusWrapper);\n    44\t\n    45\t    i_linkToken = LinkTokenInterface(vrfV2PlusWrapper.link());\n    46\t    i_vrfV2PlusWrapper = vrfV2PlusWrapper;\n    47\t  }\n    48\t\n    49\t  /**\n    50\t   * @dev Requests randomness from the VRF V2+ wrapper.\n    51\t   *\n    52\t   * @param _callbackGasLimit is the gas limit that should be used when calling the consumer's\n    53\t   *        fulfillRandomWords function.\n    54\t   * @param _requestConfirmations is the number of confirmations to wait before fulfilling the\n    55\t   *        request. A higher number of confirmations increases security by reducing the likelihood\n    56\t   *        that a chain re-org changes a published randomness outcome.\n    57\t   * @param _numWords is the number of random words to request.\n    58\t   *\n    59\t   * @return requestId is the VRF V2+ request ID of the newly created randomness request.\n    60\t   */\n    61\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    62\t  function requestRandomness(\n    63\t    uint32 _callbackGasLimit,\n    64\t    uint16 _requestConfirmations,\n    65\t    uint32 _numWords,\n    66\t    bytes memory extraArgs\n    67\t  ) internal returns (uint256 requestId, uint256 reqPrice) {\n    68\t    reqPrice = i_vrfV2PlusWrapper.calculateRequestPrice(_callbackGasLimit, _numWords);\n    69\t    i_linkToken.transferAndCall(\n    70\t      address(i_vrfV2PlusWrapper), reqPrice, abi.encode(_callbackGasLimit, _requestConfirmations, _numWords, extraArgs)\n    71\t    );\n    72\t    return (i_vrfV2PlusWrapper.lastRequestId(), reqPrice);\n    73\t  }\n    74\t\n    75\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    76\t  function requestRandomnessPayInNative(\n    77\t    uint32 _callbackGasLimit,\n    78\t    uint16 _requestConfirmations,\n    79\t    uint32 _numWords,\n    80\t    bytes memory extraArgs\n    81\t  ) internal returns (uint256 requestId, uint256 requestPrice) {\n    82\t    requestPrice = i_vrfV2PlusWrapper.calculateRequestPriceNative(_callbackGasLimit, _numWords);\n    83\t    return (\n    84\t      i_vrfV2PlusWrapper.requestRandomWordsInNative{value: requestPrice}(\n    85\t        _callbackGasLimit, _requestConfirmations, _numWords, extraArgs\n    86\t      ),\n    87\t      requestPrice\n    88\t    );\n    89\t  }\n    90\t\n    91\t  /**\n    92\t   * @notice fulfillRandomWords handles the VRF V2 wrapper response. The consuming contract must\n    93\t   * @notice implement it.\n    94\t   *\n    95\t   * @param _requestId is the VRF V2 request ID.\n    96\t   * @param _randomWords is the randomness result.\n    97\t   */\n    98\t  // solhint-disable-next-line chainlink-solidity/prefix-internal-functions-with-underscore\n    99\t  function fulfillRandomWords(uint256 _requestId, uint256[] memory _randomWords) internal virtual;\n   100\t\n   101\t  function rawFulfillRandomWords(uint256 _requestId, uint256[] memory _randomWords) external {\n   102\t    address vrfWrapperAddr = address(i_vrfV2PlusWrapper);\n   103\t    if (msg.sender != vrfWrapperAddr) {\n   104\t      revert OnlyVRFWrapperCanFulfill(msg.sender, vrfWrapperAddr);\n   105\t    }\n   106\t    fulfillRandomWords(_requestId, _randomWords);\n   107\t  }\n   108\t\n   109\t  /// @notice getBalance returns the native balance of the consumer contract\n   110\t  function getBalance() public view returns (uint256) {\n   111\t    return address(this).balance;\n   112\t  }\n   113\t\n   114\t  /// @notice getLinkToken returns the link token contract\n   115\t  function getLinkToken() public view returns (LinkTokenInterface) {\n   116\t    return i_linkToken;\n   117\t  }\n   118\t}\n    65\t    constructor(address quoteToken_, address vrfWrapper_, address protocolTreasury_) {\n    66\t        _requireContract(quoteToken_);\n    67\t        _requireContract(vrfWrapper_);\n    68\t        if (protocolTreasury_ == address(0)) revert ZeroAddress();\n    69\t\n    70\t        uint8 quoteDecimals = 0;\n    71\t        try IERC20Metadata(quoteToken_).decimals() returns (uint8 decimals_) {\n    72\t            quoteDecimals = decimals_;\n    73\t        } catch {\n    74\t            revert UnsupportedQuoteToken(quoteToken_);\n    75\t        }\n    76\t        if (quoteDecimals != RaffleConstants.QUOTE_TOKEN_DECIMALS) {\n    77\t            revert InvalidQuoteTokenDecimals(quoteDecimals, RaffleConstants.QUOTE_TOKEN_DECIMALS);\n    78\t        }\n    79\t\n    80\t        if (protocolTreasury_ == address(this) || protocolTreasury_ == quoteToken_ || protocolTreasury_ == vrfWrapper_)\n    81\t        {\n    82\t            revert UnsafeProtocolDestination(protocolTreasury_);\n    83\t        }\n    84\t\n    85\t        quoteToken = quoteToken_;\n    86\t        vrfWrapper = vrfWrapper_;\n    87\t        protocolTreasury = protocolTreasury_;\n    88\t\n    89\t        address implementation = address(new Raffle(quoteToken_, vrfWrapper_));\n    90\t        if (protocolTreasury_ == implementation) revert UnsafeProtocolDestination(protocolTreasury_);\n    91\t        raffleImplementation = implementation;\n    92\t    }\n    93\t\n    94\t    // External state-changing functions\n    95\t\n    96\t    /// @inheritdoc IRaffleFactory\n    97\t    function createRaffle(CreateRaffleParams calldata params) external override nonReentrant returns (address raffle) {\n    98\t        _validateCreateParams(params);\n    99\t        uint256 currentTime = block.timestamp;\n   100\t        if (params.endTime <= currentTime) revert InvalidEndTime(currentTime, params.endTime);\n   101\t        uint256 saleDuration = uint256(params.endTime) - currentTime;\n   102\t        if (saleDuration > RaffleConstants.MAX_SALE_DURATION) {\n   103\t            revert SaleDurationTooLong(saleDuration, RaffleConstants.MAX_SALE_DURATION);\n   104\t        }\n   105\t        uint256 raffleId = ++raffleCount;\n   106\t        raffle = Clones.clone(raffleImplementation);\n   107\t        // The fresh fixed-target clone can initialize only once; this function is nonReentrant and atomic.\n   108\t        // slither-disable-next-line reentrancy-no-eth\n   109\t        IRaffle(raffle)\n   110\t            .initialize(\n   111\t                IRaffle.RaffleInitParams({\n   112\t                sponsor: msg.sender,\n   113\t                sponsorRecipient: params.sponsorRecipient,\n   114\t                protocolTreasury: protocolTreasury,\n   115\t                prizeToken: params.prizeToken,\n   116\t                prizeTokenId: params.prizeTokenId,\n   117\t                raffleId: raffleId,\n   118\t                reserveEntries: params.reserveEntries,\n   119\t                endTime: params.endTime\n   120\t            })\n   121\t            );\n   122\t\n   123\t        raffleById[raffleId] = raffle;\n   124\t        idByRaffle[raffle] = raffleId;\n   125\t        isRaffle[raffle] = true;\n   126\t\n   127\t        IERC721 prize = IERC721(params.prizeToken);\n   128\t        prize.safeTransferFrom(msg.sender, raffle, params.prizeTokenId);\n   129\t        if (prize.ownerOf(params.prizeTokenId) != raffle) {\n   130\t            revert PrizeEscrowVerificationFailed(raffle, params.prizeToken, params.prizeTokenId);\n   131\t        }\n   132\t        if (IRaffle(raffle).status() != IRaffle.Status.Active) {\n   133\t            revert PrizeEscrowVerificationFailed(raffle, params.prizeToken, params.prizeTokenId);\n   134\t        }\n   135\t\n   136\t        emit RaffleCreated(\n   137\t            raffleId,\n   138\t            raffle,\n   139\t            msg.sender,\n   140\t            params.sponsorRecipient,\n   141\t            params.prizeToken,\n   142\t            params.prizeTokenId,\n   143\t            quoteToken,\n   144\t            protocolTreasury,\n   145\t            params.reserveEntries,\n   146\t            params.endTime\n   147\t        );\n   148\t    }\n   149\t\n   150\t    // Private view helpers\n   151\t\n   152\t    /// @dev Validates the sponsor-selected token, recipient, reserve, and supported ERC-721 interface before cloning.\n   153\t    /// @param params Prospective raffle configuration supplied by the sponsor.\n   154\t    function _validateCreateParams(CreateRaffleParams calldata params) private view {\n   155\t        _requireContract(params.prizeToken);\n   156\t        if (params.sponsorRecipient == address(0)) revert ZeroAddress();\n   157\t        if (\n   158\t            params.prizeToken == address(this) || params.prizeToken == quoteToken || params.prizeToken == vrfWrapper\n   159\t                || params.prizeToken == raffleImplementation || isRaffle[params.prizeToken]\n   160\t        ) {\n   161\t            revert UnsafeProtocolDestination(params.prizeToken);\n   162\t        }\n   163\t        if (\n   164\t            params.sponsorRecipient == address(this) || params.sponsorRecipient == quoteToken\n   165\t                || params.sponsorRecipient == vrfWrapper || params.sponsorRecipient == params.prizeToken\n   166\t                || params.sponsorRecipient == raffleImplementation || isRaffle[params.sponsorRecipient]\n   167\t        ) {\n   168\t            revert UnsafeProtocolDestination(params.sponsorRecipient);\n   169\t        }\n   170\t\n   171\t        bool supports721 = false;\n   172\t        try IERC165(params.prizeToken).supportsInterface(type(IERC721).interfaceId) returns (bool supported) {\n   173\t            supports721 = supported;\n   174\t        } catch {\n   175\t            revert UnsupportedPrizeToken(params.prizeToken);\n   176\t        }\n   177\t        if (!supports721) revert UnsupportedPrizeToken(params.prizeToken);\n   178\t        if (params.reserveEntries == 0) revert ZeroReserveEntries();\n   179\t    }\n   180\t\n    20\t    /// @notice Global entry price: exactly 1,000,000 raw six-decimal quote-token units, or one USDC.\n    21\t    uint256 internal constant ENTRY_PRICE = 1_000_000;\n    22\t\n    23\t    /// @notice Decimal precision required from the immutable quote token.\n    24\t    uint8 internal constant QUOTE_TOKEN_DECIMALS = 6;\n    25\t\n    26\t    /// @notice Refund execution is bounded by tickets, while each ticket may represent any uint128 entry count.\n    27\t    uint256 internal constant MAX_REFUND_TICKET_BATCH_SIZE = 100;\n    28\t\n    29\t    /// @notice Maximum prospective raffle sale duration, measured from creation to the exclusive sale end.\n    30\t    uint256 internal constant MAX_SALE_DURATION = 30 days;\n    31\t\n    32\t    /// @notice Duration after sale end during which a sold raffle may initiate its draw, in seconds.\n    33\t    uint256 internal constant DRAW_REQUEST_TIMEOUT = 2 days;\n    34\t\n    35\t    /// @notice Duration after an accepted request during which its authenticated callback may resolve, in seconds.\n    36\t    uint256 internal constant DRAW_CALLBACK_TIMEOUT = 2 days;\n    37\t\n    38\t    /// @notice Gas-unit limit requested for the single-word Chainlink callback.\n    39\t    uint32 internal constant VRF_CALLBACK_GAS_LIMIT = 300_000;\n    40\t\n    41\t    /// @notice Block confirmations requested from Chainlink before callback fulfillment.\n    42\t    uint16 internal constant VRF_REQUEST_CONFIRMATIONS = 30;\n    43\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"{\"_kritt_extractor_helper\":true,\"stub\":true,\"stub_explanation\":\"No concrete vulnerability is supported. For sold Active raffles, requestDraw is available only before endTime plus two days, while enableRefunds becomes available at or after that same deadline. The transition atomically reclassifies the stored unsettled pot, changes status to Refunding, and is nonReentrant, preventing repeat or interleaved settlement. Permissionless finalization at this boundary is the intended liveness mechanism.\",\"results\":[]}"}}
