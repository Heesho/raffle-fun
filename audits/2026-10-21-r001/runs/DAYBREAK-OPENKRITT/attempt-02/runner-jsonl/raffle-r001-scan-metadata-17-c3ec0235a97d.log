{"type":"item.started","item":{"id":"item_0","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,380p' packages/contracts/src/Raffle.sol && rg -n \\\"enableRefunds|refund|Refund|cancel|deadline|endTime\\\" packages/contracts/src -g '*.sol'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_0","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,380p' packages/contracts/src/Raffle.sol && rg -n \\\"enableRefunds|refund|Refund|cancel|deadline|endTime\\\" packages/contracts/src -g '*.sol'\"","aggregated_output":"// SPDX-License-Identifier: MIT\npragma solidity 0.8.36;\n\nimport { VRFV2PlusWrapperConsumerBase } from \"@chainlink/contracts/src/v0.8/vrf/dev/VRFV2PlusWrapperConsumerBase.sol\";\nimport { IVRFV2PlusWrapper } from \"@chainlink/contracts/src/v0.8/vrf/dev/interfaces/IVRFV2PlusWrapper.sol\";\nimport { VRFV2PlusClient } from \"@chainlink/contracts/src/v0.8/vrf/dev/libraries/VRFV2PlusClient.sol\";\nimport { IERC20 } from \"@openzeppelin/contracts/token/ERC20/IERC20.sol\";\nimport { SafeERC20 } from \"@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol\";\nimport { ERC721 } from \"@openzeppelin/contracts/token/ERC721/ERC721.sol\";\nimport { IERC721 } from \"@openzeppelin/contracts/token/ERC721/IERC721.sol\";\nimport { IERC721Receiver } from \"@openzeppelin/contracts/token/ERC721/IERC721Receiver.sol\";\nimport { ReentrancyGuard } from \"@openzeppelin/contracts/utils/ReentrancyGuard.sol\";\nimport { Math } from \"@openzeppelin/contracts/utils/math/Math.sol\";\n\nimport { IRaffle } from \"./interfaces/IRaffle.sol\";\nimport { IRaffleFactory } from \"./interfaces/IRaffleFactory.sol\";\nimport { RaffleConstants } from \"./libraries/RaffleConstants.sol\";\n\n/// @title raffle.fun Raffle Escrow and Entry Ticket\n/// @author heesho\n/// @notice Escrows one NFT and sells fixed-price USDC entries through one transferable ERC-721 ticket per purchase.\n/// @dev Ticket IDs are sequential and map to one inclusive `[firstEntry,lastEntry]` uint128 range. Purchases, Chainlink\n///      callbacks, and winner proofs are O(1) in entry count. Tickets remain transferable bearer claims until their\n///      owners burn them for redemption or refund. Each raffle is a fixed, non-upgradeable ERC-1167 clone with no\n///      administrator or rescue path. Permissionless settlement only allocates liabilities; the winning-ticket owner\n///      atomically burns the ticket while receiving the NFT or cash prize.\n/// @custom:version 1.0.0\ncontract Raffle is IRaffle, ERC721, ReentrancyGuard, IERC721Receiver, VRFV2PlusWrapperConsumerBase {\n    using SafeERC20 for IERC20;\n\n    // Types\n\n    /// @notice Inclusive global entry-number range represented by one sequential ERC-721 ticket.\n    /// @param firstEntry First represented one-based global entry.\n    /// @param lastEntry Last represented one-based global entry.\n    struct TicketRange {\n        uint128 firstEntry;\n        uint128 lastEntry;\n    }\n\n    // Constants\n\n    /// @inheritdoc IRaffle\n    uint256 public constant override ENTRY_PRICE = RaffleConstants.ENTRY_PRICE;\n\n    /// @inheritdoc IRaffle\n    uint32 public constant override callbackGasLimit = RaffleConstants.VRF_CALLBACK_GAS_LIMIT;\n\n    /// @inheritdoc IRaffle\n    uint16 public constant override requestConfirmations = RaffleConstants.VRF_REQUEST_CONFIRMATIONS;\n\n    // Immutables and state\n\n    /// @inheritdoc IRaffle\n    address public immutable override factory;\n\n    /// @inheritdoc IRaffle\n    IERC20 public immutable override quoteToken;\n\n    /// @inheritdoc IRaffle\n    address public override sponsor;\n\n    /// @inheritdoc IRaffle\n    address public override sponsorRecipient;\n\n    /// @inheritdoc IRaffle\n    address public override protocolTreasury;\n\n    /// @inheritdoc IRaffle\n    IERC721 public override prizeToken;\n\n    /// @inheritdoc IRaffle\n    uint256 public override prizeTokenId;\n\n    /// @inheritdoc IRaffle\n    uint256 public override raffleId;\n\n    /// @inheritdoc IRaffle\n    uint128 public override reserveEntries;\n\n    /// @inheritdoc IRaffle\n    uint64 public override endTime;\n\n    /// @inheritdoc IRaffle\n    uint128 public override totalEntries;\n\n    /// @inheritdoc IRaffle\n    uint128 public override ticketCount;\n\n    /// @inheritdoc IRaffle\n    uint256 public override unsettledPot;\n\n    /// @inheritdoc IRaffle\n    uint256 public override remainingRefundLiability;\n\n    /// @inheritdoc IRaffle\n    address public override winnerRecipient;\n\n    /// @inheritdoc IRaffle\n    uint256 public override winnerProceeds;\n\n    /// @inheritdoc IRaffle\n    uint256 public override sponsorProceeds;\n\n    /// @inheritdoc IRaffle\n    uint256 public override protocolFees;\n\n    /// @inheritdoc IRaffle\n    uint256 public override vrfRequestId;\n\n    /// @inheritdoc IRaffle\n    uint64 public override drawRequestedAt;\n\n    /// @inheritdoc IRaffle\n    uint64 public override resolvedAt;\n\n    /// @inheritdoc IRaffle\n    uint128 public override winningEntry;\n\n    /// @inheritdoc IRaffle\n    uint256 public override winningTicketId;\n\n    /// @inheritdoc IRaffle\n    Status public override status;\n\n    /// @inheritdoc IRaffle\n    bool public override settlementComplete;\n\n    /// @inheritdoc IRaffle\n    bool public override winnerRedeemed;\n\n    /// @inheritdoc IRaffle\n    bool public override prizeClaimed;\n\n    /// @inheritdoc IRaffle\n    bool public override initialized;\n\n    /// @dev Historical ticket ranges remain stored after burns so indexers and callers can reconstruct entry coverage.\n    mapping(uint256 ticketId => TicketRange range) private _ticketRanges;\n\n    /// @dev True only while the wrapper request call is executing, so a synchronous callback cannot resolve early.\n    bool private _requestInFlight;\n\n    // Errors\n\n    /// @notice Raised when native currency is sent outside the payable draw-request path.\n    error DirectNativeTransfer();\n\n    // Constructor\n\n    /// @notice Deploys and locks the implementation shared by one factory's minimal-proxy raffles.\n    /// @dev Constructor state belongs to the implementation. Clones share these immutables but hold isolated storage.\n    /// @param quoteToken_ Canonical six-decimal USDC contract fixed for the implementation and every clone.\n    /// @param vrfWrapper_ Chainlink VRF v2.5 native direct-funding wrapper fixed for the implementation and all clones.\n    constructor(address quoteToken_, address vrfWrapper_)\n        ERC721(\"\", \"\")\n        VRFV2PlusWrapperConsumerBase(_validatedVrfWrapper(vrfWrapper_))\n    {\n        if (msg.sender == address(0) || quoteToken_ == address(0)) revert ZeroAddress();\n\n        factory = msg.sender;\n        quoteToken = IERC20(quoteToken_);\n\n        initialized = true;\n        status = Status.Refunding;\n    }\n\n    // External state-changing functions\n\n    /// @notice Rejects direct native-token transfers that are not attached to `requestDraw`.\n    receive() external payable {\n        revert DirectNativeTransfer();\n    }\n\n    /// @inheritdoc IRaffle\n    function initialize(RaffleInitParams calldata params) external override {\n        if (initialized) revert AlreadyInitialized();\n        if (msg.sender != factory) revert OnlyFactory();\n        initialized = true;\n\n        if (\n            params.sponsor == address(0) || params.sponsorRecipient == address(0)\n                || params.protocolTreasury == address(0) || params.prizeToken == address(0)\n        ) {\n            revert ZeroAddress();\n        }\n        if (_isProtocolDestination(params.sponsor, params.prizeToken)) {\n            revert UnsafeProtocolDestination(params.sponsor);\n        }\n        if (_isProtocolDestination(params.protocolTreasury, params.prizeToken)) {\n            revert UnsafeProtocolDestination(params.protocolTreasury);\n        }\n        if (_isProtocolDestination(params.sponsorRecipient, params.prizeToken)) {\n            revert UnsafeProtocolDestination(params.sponsorRecipient);\n        }\n\n        sponsor = params.sponsor;\n        sponsorRecipient = params.sponsorRecipient;\n        protocolTreasury = params.protocolTreasury;\n        prizeToken = IERC721(params.prizeToken);\n        prizeTokenId = params.prizeTokenId;\n        raffleId = params.raffleId;\n        reserveEntries = params.reserveEntries;\n        endTime = params.endTime;\n        status = Status.AwaitingPrize;\n    }\n\n    /// @inheritdoc IRaffle\n    function buyEntries(address recipient, uint128 entryCount)\n        external\n        override\n        nonReentrant\n        returns (uint256 ticketId)\n    {\n        _requireStatus(Status.Active);\n        if (block.timestamp >= endTime) revert SaleEnded(endTime, block.timestamp);\n        if (recipient == address(0)) revert InvalidRecipient();\n        if (entryCount == 0) revert ZeroEntryCount();\n        if (entryCount > type(uint128).max - totalEntries) {\n            revert TotalEntriesOverflow(totalEntries, entryCount);\n        }\n\n        uint256 grossAmount = uint256(entryCount) * ENTRY_PRICE;\n        quoteToken.safeTransferFrom(msg.sender, address(this), grossAmount);\n\n        uint128 firstEntry = totalEntries + 1;\n        uint128 lastEntry = totalEntries + entryCount;\n        ticketId = uint256(ticketCount) + 1;\n\n        totalEntries = lastEntry;\n        ++ticketCount;\n        _ticketRanges[ticketId] = TicketRange({ firstEntry: firstEntry, lastEntry: lastEntry });\n        unsettledPot += grossAmount;\n\n        _safeMint(recipient, ticketId);\n        emit TicketPurchased(msg.sender, recipient, ticketId, firstEntry, lastEntry, entryCount, grossAmount);\n    }\n\n    /// @inheritdoc IRaffle\n    function requestDraw() external payable override nonReentrant returns (uint256 requestId) {\n        _requireStatus(Status.Active);\n        if (block.timestamp < endTime) revert RaffleNotEnded(endTime, block.timestamp);\n        if (totalEntries == 0) revert NoEntriesSold();\n        uint256 requestDeadline = drawRequestDeadline();\n        if (block.timestamp >= requestDeadline) {\n            revert DrawRequestWindowExpired(requestDeadline, block.timestamp);\n        }\n\n        uint256 quotedFee = getVrfRequestPrice();\n        if (msg.value < quotedFee) revert InsufficientVrfFee(quotedFee, msg.value);\n\n        status = Status.Drawing;\n        drawRequestedAt = uint64(block.timestamp);\n        _requestInFlight = true;\n        bytes memory extraArgs = VRFV2PlusClient._argsToBytes(VRFV2PlusClient.ExtraArgsV1({ nativePayment: true }));\n        uint256 paidPrice;\n        (requestId, paidPrice) = requestRandomnessPayInNative(callbackGasLimit, requestConfirmations, 1, extraArgs);\n        if (paidPrice > msg.value) revert InsufficientVrfFee(paidPrice, msg.value);\n        vrfRequestId = requestId;\n        _requestInFlight = false;\n\n        uint256 excess = msg.value - paidPrice;\n        if (excess != 0) {\n            bool success;\n            address refundRecipient = msg.sender;\n            assembly (\"memory-safe\") {\n                success := call(gas(), refundRecipient, excess, 0, 0, 0, 0)\n            }\n            if (!success) revert NativeRefundFailed(msg.sender, excess);\n        }\n\n        emit DrawRequested(requestId, msg.sender, paidPrice, excess, drawRequestedAt, callbackDeadline());\n    }\n\n    /// @inheritdoc IRaffle\n    function enableRefunds() external override nonReentrant {\n        uint256 deadline;\n\n        if (status == Status.Active) {\n            if (totalEntries == 0) {\n                deadline = endTime;\n                if (msg.sender != sponsor && block.timestamp < deadline) {\n                    revert RefundsNotAvailable(deadline, block.timestamp);\n                }\n            } else {\n                deadline = drawRequestDeadline();\n                if (block.timestamp < deadline) revert RefundsNotAvailable(deadline, block.timestamp);\n            }\n        } else if (status == Status.Drawing) {\n            deadline = callbackDeadline();\n            if (block.timestamp < deadline) revert RefundsNotAvailable(deadline, block.timestamp);\n        } else {\n            revert InvalidStatus(status);\n        }\n\n        uint256 liability = unsettledPot;\n        unsettledPot = 0;\n        remainingRefundLiability = liability;\n        status = Status.Refunding;\n        emit RefundsEnabled(msg.sender, liability);\n    }\n\n    /// @inheritdoc IRaffle\n    function settleWinningTicket(uint256 ticketId) external override nonReentrant returns (uint256 cashAmount) {\n        cashAmount = _settleWinningTicket(ticketId);\n    }\n\n    /// @inheritdoc IRaffle\n    function redeemWinningTicket(uint256 ticketId) external override nonReentrant returns (uint256 cashAmount) {\n        if (winnerRedeemed) revert WinningTicketAlreadyRedeemed();\n        Status result = status;\n        if (result != Status.NftWon && result != Status.CashWon) revert InvalidStatus(result);\n\n        if (!settlementComplete) {\n            _settleWinningTicket(ticketId);\n        } else if (ticketId != winningTicketId) {\n            revert WinningTicketMismatch(ticketId, winningTicketId);\n        }\n\n        address winner = ownerOf(ticketId);\n        if (msg.sender != winner) revert NotTicketOwner(ticketId, msg.sender, winner);\n\n        winnerRecipient = winner;\n        winnerRedeemed = true;\n        _burn(ticketId);\n\n        address deliveredPrizeToken = address(0);\n        uint256 deliveredPrizeTokenId = 0;\n        if (result == Status.NftWon) {\n            if (prizeClaimed) revert PrizeAlreadyClaimed();\n            prizeClaimed = true;\n            deliveredPrizeToken = address(prizeToken);\n            deliveredPrizeTokenId = prizeTokenId;\n            prizeToken.transferFrom(address(this), winner, deliveredPrizeTokenId);\n            if (prizeToken.ownerOf(deliveredPrizeTokenId) != winner) {\n                revert PrizeDeliveryVerificationFailed(winner);\n            }\n        } else {\n            cashAmount = winnerProceeds;\n            if (cashAmount == 0) revert NoWinnerProceeds();\n            winnerProceeds = 0;\n            _transferQuote(winner, cashAmount);\n        }\n\n        emit WinningTicketRedeemed(ticketId, winner, result, cashAmount, deliveredPrizeToken, deliveredPrizeTokenId);\n    }\n\n    /// @inheritdoc IRaffle\n    function refundTickets(uint256[] calldata ticketIds) external override nonReentrant returns (uint256 amount) {\n        _requireStatus(Status.Refunding);\n        uint256 ticketQuantity = ticketIds.length;\n        if (ticketQuantity == 0 || ticketQuantity > RaffleConstants.MAX_REFUND_TICKET_BATCH_SIZE) {\n            revert InvalidTicketBatchSize(ticketQuantity, RaffleConstants.MAX_REFUND_TICKET_BATCH_SIZE);\n        }\n\n        uint256 aggregateEntries = 0;\n        for (uint256 index; index < ticketQuantity; ++index) {\n            uint256 ticketId = ticketIds[index];\n            address owner = ownerOf(ticketId);\n            if (msg.sender != owner) revert NotTicketOwner(ticketId, msg.sender, owner);\n\n            (uint128 firstEntry, uint128 lastEntry) = ticketRange(ticketId);\n            aggregateEntries += uint256(lastEntry) - uint256(firstEntry) + 1;\n            _burn(ticketId);\n        }\n\n        amount = aggregateEntries * ENTRY_PRICE;\n        remainingRefundLiability -= amount;\n        _transferQuote(msg.sender, amount);\n        uint256 liabilityAfter = remainingRefundLiability;\n        emit TicketsRefunded(msg.sender, ticketQuantity, aggregateEntries, amount, liabilityAfter);\n    }\n\n    /// @inheritdoc IRaffle\n    function releaseSponsorProceeds() external override nonReentrant returns (uint256 amount) {\n        amount = sponsorProceeds;\n        if (amount == 0) revert NoSponsorProceeds();\n        sponsorProceeds = 0;\n        address recipient = sponsorRecipient;\n        _transferQuote(recipient, amount);\npackages/contracts/src/libraries/RaffleConstants.sol:26:    /// @notice Refund execution is bounded by tickets, while each ticket may represent any uint128 entry count.\npackages/contracts/src/RaffleFactory.sol:100:        if (params.endTime <= currentTime) revert InvalidEndTime(currentTime, params.endTime);\npackages/contracts/src/RaffleFactory.sol:101:        uint256 saleDuration = uint256(params.endTime) - currentTime;\npackages/contracts/src/RaffleFactory.sol:119:                endTime: params.endTime\npackages/contracts/src/RaffleFactory.sol:146:            params.endTime\npackages/contracts/src/interfaces/IRaffle.sol:13:///      bearer claim until its owner atomically burns it for redemption or refund. The immutable quote token is trusted\npackages/contracts/src/interfaces/IRaffle.sol:32:        /// @notice Full ticket refunds are enabled and the sponsor may recover the prize NFT.\npackages/contracts/src/interfaces/IRaffle.sol:33:        Refunding\npackages/contracts/src/interfaces/IRaffle.sol:37:    /// @param sponsor Prize depositor and empty-raffle cancellation authority.\npackages/contracts/src/interfaces/IRaffle.sol:44:    /// @param endTime Unix timestamp, in seconds, at which entry sales end exclusively.\npackages/contracts/src/interfaces/IRaffle.sol:53:        uint64 endTime;\npackages/contracts/src/interfaces/IRaffle.sol:88:    /// @param callbackDeadline Exclusive Unix-timestamp deadline for accepting the authenticated callback.\npackages/contracts/src/interfaces/IRaffle.sol:110:    /// @notice Emitted when the raffle enters the full-refund branch.\npackages/contracts/src/interfaces/IRaffle.sol:111:    /// @param finalizer Address that enabled refunds.\npackages/contracts/src/interfaces/IRaffle.sol:112:    /// @param remainingRefundLiability Raw six-decimal quote-token units initially available for ticket refunds.\npackages/contracts/src/interfaces/IRaffle.sol:113:    event RefundsEnabled(address indexed finalizer, uint256 remainingRefundLiability);\npackages/contracts/src/interfaces/IRaffle.sol:147:    /// @notice Emitted when an owner burns one or more tickets for a full quote-token refund.\npackages/contracts/src/interfaces/IRaffle.sol:148:    /// @param owner Ticket owner that burned the tickets and received the refund.\npackages/contracts/src/interfaces/IRaffle.sol:151:    /// @param amount Raw six-decimal quote-token units refunded, equal to `entryQuantity * ENTRY_PRICE`.\npackages/contracts/src/interfaces/IRaffle.sol:152:    /// @param remainingRefundLiability Raw six-decimal quote-token units still claimable after this refund.\npackages/contracts/src/interfaces/IRaffle.sol:153:    event TicketsRefunded(\npackages/contracts/src/interfaces/IRaffle.sol:158:        uint256 remainingRefundLiability\npackages/contracts/src/interfaces/IRaffle.sol:173:    /// @notice Emitted when the escrowed prize is returned after a cash result or refund transition.\npackages/contracts/src/interfaces/IRaffle.sol:205:    /// @param endTime Exclusive sale-end Unix timestamp, in seconds.\npackages/contracts/src/interfaces/IRaffle.sol:207:    error SaleEnded(uint256 endTime, uint256 currentTime);\npackages/contracts/src/interfaces/IRaffle.sol:220:    /// @notice Raised when a refund batch is empty or exceeds the bounded ticket limit.\npackages/contracts/src/interfaces/IRaffle.sol:222:    /// @param maximum Maximum ticket IDs accepted per refund transaction.\npackages/contracts/src/interfaces/IRaffle.sol:230:    /// @param endTime Exclusive sale-end Unix timestamp, in seconds.\npackages/contracts/src/interfaces/IRaffle.sol:232:    error RaffleNotEnded(uint256 endTime, uint256 currentTime);\npackages/contracts/src/interfaces/IRaffle.sol:234:    /// @notice Raised when a draw request is submitted at or after the exclusive request deadline.\npackages/contracts/src/interfaces/IRaffle.sol:235:    /// @param deadline Exclusive draw-request Unix-timestamp deadline, in seconds.\npackages/contracts/src/interfaces/IRaffle.sol:237:    error DrawRequestWindowExpired(uint256 deadline, uint256 currentTime);\npackages/contracts/src/interfaces/IRaffle.sol:242:    /// @notice Raised when refunds are requested before the applicable liveness deadline.\npackages/contracts/src/interfaces/IRaffle.sol:243:    /// @param deadline Unix timestamp, in seconds, at which refunds become available.\npackages/contracts/src/interfaces/IRaffle.sol:245:    error RefundsNotAvailable(uint256 deadline, uint256 currentTime);\npackages/contracts/src/interfaces/IRaffle.sol:253:    /// @param recipient Draw requester that was due the refund.\npackages/contracts/src/interfaces/IRaffle.sol:255:    error NativeRefundFailed(address recipient, uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol:317:    /// @dev Callable by anyone only in `[endTime,drawRequestDeadline())` after at least one entry is sold. Any native\npackages/contracts/src/interfaces/IRaffle.sol:322:    /// @notice Enables full refunds after the sold-raffle request deadline or an accepted request's callback deadline.\npackages/contracts/src/interfaces/IRaffle.sol:324:    function enableRefunds() external;\npackages/contracts/src/interfaces/IRaffle.sol:342:    /// @param ticketIds Ticket IDs owned by the caller and submitted for refund.\npackages/contracts/src/interfaces/IRaffle.sol:344:    function refundTickets(uint256[] calldata ticketIds) external returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffle.sol:354:    /// @notice Returns the escrowed prize to the immutable sponsor recipient after `CashWon` or `Refunding`.\npackages/contracts/src/interfaces/IRaffle.sol:375:    /// @notice Returns the exclusive deadline for initiating the draw.\npackages/contracts/src/interfaces/IRaffle.sol:376:    /// @return deadline Unix timestamp, in seconds, equal to `endTime + 2 days`.\npackages/contracts/src/interfaces/IRaffle.sol:377:    function drawRequestDeadline() external view returns (uint256 deadline);\npackages/contracts/src/interfaces/IRaffle.sol:379:    /// @notice Returns the exclusive deadline for accepting the authenticated callback.\npackages/contracts/src/interfaces/IRaffle.sol:380:    /// @return deadline Unix timestamp, in seconds, equal to `drawRequestedAt + 2 days`, or zero before a request.\npackages/contracts/src/interfaces/IRaffle.sol:381:    function callbackDeadline() external view returns (uint256 deadline);\npackages/contracts/src/interfaces/IRaffle.sol:384:    /// @return amount Raw six-decimal quote-token units across the unsettled pot, refunds, and allocated claims.\npackages/contracts/src/interfaces/IRaffle.sol:410:    /// @notice Returns the prize depositor and pre-end empty-raffle refund authority.\npackages/contracts/src/interfaces/IRaffle.sol:448:    function endTime() external view returns (uint64 timestamp);\npackages/contracts/src/interfaces/IRaffle.sol:459:    /// @return amount Raw six-decimal quote-token units collected before settlement or refund activation.\npackages/contracts/src/interfaces/IRaffle.sol:462:    /// @notice Returns the current aggregate full-refund liability.\npackages/contracts/src/interfaces/IRaffle.sol:463:    /// @return amount Raw six-decimal quote-token units still claimable by unrefunded tickets.\npackages/contracts/src/interfaces/IRaffle.sol:464:    function remainingRefundLiability() external view returns (uint256 amount);\npackages/contracts/src/interfaces/IRaffleFactory.sol:19:    /// @param endTime Exclusive sale-end Unix timestamp, in seconds.\npackages/contracts/src/interfaces/IRaffleFactory.sol:25:        uint64 endTime;\npackages/contracts/src/interfaces/IRaffleFactory.sol:33:    /// @param sponsor Prize depositor and pre-end empty-raffle refund authority.\npackages/contracts/src/interfaces/IRaffleFactory.sol:40:    /// @param endTime Exclusive sale-end Unix timestamp, in seconds.\npackages/contracts/src/interfaces/IRaffleFactory.sol:51:        uint64 endTime\npackages/contracts/src/interfaces/IRaffleFactory.sol:81:    /// @param endTime Supplied exclusive sale-end Unix timestamp, in seconds.\npackages/contracts/src/interfaces/IRaffleFactory.sol:82:    error InvalidEndTime(uint256 currentTime, uint256 endTime);\npackages/contracts/src/Raffle.sol:24:///      owners burn them for redemption or refund. Each raffle is a fixed, 