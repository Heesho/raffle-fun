 any returned prize.\n./packages/contracts/src/interfaces/IRaffleFactory.sol:21:        address sponsorRecipient;\n./packages/contracts/src/interfaces/IRaffleFactory.sol:34:    /// @param sponsorRecipient Immutable recipient of sponsor quote proceeds and any returned prize.\n./packages/contracts/src/interfaces/IRaffleFactory.sol:37:    /// @param quoteToken Immutable canonical six-decimal USDC contract used by the raffle.\n./packages/contracts/src/interfaces/IRaffleFactory.sol:45:        address sponsorRecipient,\n./packages/contracts/src/interfaces/IRaffleFactory.sol:108:    /// @notice Returns the immutable canonical six-decimal USDC contract used by every raffle.\n./packages/contracts/src/interfaces/IRaffleFactory.sol:109:    /// @return quoteTokenAddress Canonical USDC contract address trusted by this deployment.\n./packages/contracts/src/Raffle.sol:21:/// @notice Escrows one NFT and sells fixed-price USDC entries through one transferable ERC-721 ticket per purchase.\n./packages/contracts/src/Raffle.sol:64:    address public override sponsorRecipient;\n./packages/contracts/src/Raffle.sol:153:    /// @param quoteToken_ Canonical six-decimal USDC contract fixed for the implementation and every clone.\n./packages/contracts/src/Raffle.sol:182:            params.sponsor == address(0) || params.sponsorRecipient == address(0)\n./packages/contracts/src/Raffle.sol:193:        if (_isProtocolDestination(params.sponsorRecipient, params.prizeToken)) {\n./packages/contracts/src/Raffle.sol:194:            revert UnsafeProtocolDestination(params.sponsorRecipient);\n./packages/contracts/src/Raffle.sol:198:        sponsorRecipient = params.sponsorRecipient;\n./packages/contracts/src/Raffle.sol:375:    function releaseSponsorProceeds() external override nonReentrant returns (uint256 amount) {\n./packages/contracts/src/Raffle.sol:377:        if (amount == 0) revert NoSponsorProceeds();\n./packages/contracts/src/Raffle.sol:379:        address recipient = sponsorRecipient;\n./packages/contracts/src/Raffle.sol:381:        emit SponsorProceedsReleased(msg.sender, recipient, amount);\n./packages/contracts/src/Raffle.sol:402:        address recipient = sponsorRecipient;\n./packages/contracts/src/Raffle.sol:560:    /// @dev Transfers one complete current USDC claim through SafeERC20 after rejecting known protocol sinks. The\n./packages/contracts/src/Raffle.sol:561:    ///      canonical USDC trust model assumes standard, non-rebasing, fee-free transfer semantics.\n./packages/contracts/src/Raffle.sol:563:    /// @param amount Raw six-decimal USDC units transferred.\n./DESIGN.md:2:Ethereum NFT raffle; immutable factory, ERC-1167 clones with immutable implementation. One entry costs 1,000,000 units of canonical six-decimal USDC. One purchase mints a transferable ERC721 ticket representing a contiguous inclusive range. Exactly one ERC721 prize is escrowed atomically at creation. Reserve met awards NFT and 95% sponsor / 5% treasury. Reserve missed awards 80% gross to winner, 15% sponsor, 5% treasury. Refund outcome pays 100% per entry and returns prize. Rounding is floor on aggregate protocol fee; remainder must be allocated without loss. No administrator, mutable configuration or upgrade. Request window [sale end, end+2days); callback accepted strictly before request timestamp+2days. Refunds open at deadline. Callback records result only. Settlement is permissionless, storage-only; redemption requires current ticket owner, burns claim atomically, and must revert all effects on delivery failure. Sponsor and treasury can claim independently after settlement. Never move assets between raffle clones. Quote token and Chainlink wrapper are trusted canonical dependencies; arbitrary prize contracts and ticket recipients are untrusted. Frontend discovery is advisory; transaction decisions must reread current chain state.\n","exit_code":0,"status":"completed"}}
