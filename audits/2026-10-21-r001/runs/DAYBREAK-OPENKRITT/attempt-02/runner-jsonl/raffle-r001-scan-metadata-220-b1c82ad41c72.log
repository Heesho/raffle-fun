{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/src/Raffle.sol | sed -n '205,305p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/ERC721.sol | sed -n '250,340p'\"","aggregated_output":"   205\t        status = Status.AwaitingPrize;\n   206\t    }\n   207\t\n   208\t    /// @inheritdoc IRaffle\n   209\t    function buyEntries(address recipient, uint128 entryCount)\n   210\t        external\n   211\t        override\n   212\t        nonReentrant\n   213\t        returns (uint256 ticketId)\n   214\t    {\n   215\t        _requireStatus(Status.Active);\n   216\t        if (block.timestamp >= endTime) revert SaleEnded(endTime, block.timestamp);\n   217\t        if (recipient == address(0)) revert InvalidRecipient();\n   218\t        if (entryCount == 0) revert ZeroEntryCount();\n   219\t        if (entryCount > type(uint128).max - totalEntries) {\n   220\t            revert TotalEntriesOverflow(totalEntries, entryCount);\n   221\t        }\n   222\t\n   223\t        uint256 grossAmount = uint256(entryCount) * ENTRY_PRICE;\n   224\t        quoteToken.safeTransferFrom(msg.sender, address(this), grossAmount);\n   225\t\n   226\t        uint128 firstEntry = totalEntries + 1;\n   227\t        uint128 lastEntry = totalEntries + entryCount;\n   228\t        ticketId = uint256(ticketCount) + 1;\n   229\t\n   230\t        totalEntries = lastEntry;\n   231\t        ++ticketCount;\n   232\t        _ticketRanges[ticketId] = TicketRange({ firstEntry: firstEntry, lastEntry: lastEntry });\n   233\t        unsettledPot += grossAmount;\n   234\t\n   235\t        _safeMint(recipient, ticketId);\n   236\t        emit TicketPurchased(msg.sender, recipient, ticketId, firstEntry, lastEntry, entryCount, grossAmount);\n   237\t    }\n   238\t\n   239\t    /// @inheritdoc IRaffle\n   240\t    function requestDraw() external payable override nonReentrant returns (uint256 requestId) {\n   241\t        _requireStatus(Status.Active);\n   242\t        if (block.timestamp < endTime) revert RaffleNotEnded(endTime, block.timestamp);\n   243\t        if (totalEntries == 0) revert NoEntriesSold();\n   244\t        uint256 requestDeadline = drawRequestDeadline();\n   245\t        if (block.timestamp >= requestDeadline) {\n   246\t            revert DrawRequestWindowExpired(requestDeadline, block.timestamp);\n   247\t        }\n   248\t\n   249\t        uint256 quotedFee = getVrfRequestPrice();\n   250\t        if (msg.value < quotedFee) revert InsufficientVrfFee(quotedFee, msg.value);\n   251\t\n   252\t        status = Status.Drawing;\n   253\t        drawRequestedAt = uint64(block.timestamp);\n   254\t        _requestInFlight = true;\n   255\t        bytes memory extraArgs = VRFV2PlusClient._argsToBytes(VRFV2PlusClient.ExtraArgsV1({ nativePayment: true }));\n   256\t        uint256 paidPrice;\n   257\t        (requestId, paidPrice) = requestRandomnessPayInNative(callbackGasLimit, requestConfirmations, 1, extraArgs);\n   258\t        if (paidPrice > msg.value) revert InsufficientVrfFee(paidPrice, msg.value);\n   259\t        vrfRequestId = requestId;\n   260\t        _requestInFlight = false;\n   261\t\n   262\t        uint256 excess = msg.value - paidPrice;\n   263\t        if (excess != 0) {\n   264\t            bool success;\n   265\t            address refundRecipient = msg.sender;\n   266\t            assembly (\"memory-safe\") {\n   267\t                success := call(gas(), refundRecipient, excess, 0, 0, 0, 0)\n   268\t            }\n   269\t            if (!success) revert NativeRefundFailed(msg.sender, excess);\n   270\t        }\n   271\t\n   272\t        emit DrawRequested(requestId, msg.sender, paidPrice, excess, drawRequestedAt, callbackDeadline());\n   273\t    }\n   274\t\n   275\t    /// @inheritdoc IRaffle\n   276\t    function enableRefunds() external override nonReentrant {\n   277\t        uint256 deadline;\n   278\t\n   279\t        if (status == Status.Active) {\n   280\t            if (totalEntries == 0) {\n   281\t                deadline = endTime;\n   282\t                if (msg.sender != sponsor && block.timestamp < deadline) {\n   283\t                    revert RefundsNotAvailable(deadline, block.timestamp);\n   284\t                }\n   285\t            } else {\n   286\t                deadline = drawRequestDeadline();\n   287\t                if (block.timestamp < deadline) revert RefundsNotAvailable(deadline, block.timestamp);\n   288\t            }\n   289\t        } else if (status == Status.Drawing) {\n   290\t            deadline = callbackDeadline();\n   291\t            if (block.timestamp < deadline) revert RefundsNotAvailable(deadline, block.timestamp);\n   292\t        } else {\n   293\t            revert InvalidStatus(status);\n   294\t        }\n   295\t\n   296\t        uint256 liability = unsettledPot;\n   297\t        unsettledPot = 0;\n   298\t        remainingRefundLiability = liability;\n   299\t        status = Status.Refunding;\n   300\t        emit RefundsEnabled(msg.sender, liability);\n   301\t    }\n   302\t\n   303\t    /// @inheritdoc IRaffle\n   304\t    function settleWinningTicket(uint256 ticketId) external override nonReentrant returns (uint256 cashAmount) {\n   305\t        cashAmount = _settleWinningTicket(ticketId);\n   250\t     * WARNING: Usage of this method is discouraged, use {_safeMint} whenever possible\n   251\t     *\n   252\t     * Requirements:\n   253\t     *\n   254\t     * - `tokenId` must not exist.\n   255\t     * - `to` cannot be the zero address.\n   256\t     *\n   257\t     * Emits a {Transfer} event.\n   258\t     */\n   259\t    function _mint(address to, uint256 tokenId) internal {\n   260\t        if (to == address(0)) {\n   261\t            revert ERC721InvalidReceiver(address(0));\n   262\t        }\n   263\t        address previousOwner = _update(to, tokenId, address(0));\n   264\t        if (previousOwner != address(0)) {\n   265\t            revert ERC721InvalidSender(address(0));\n   266\t        }\n   267\t    }\n   268\t\n   269\t    /**\n   270\t     * @dev Mints `tokenId`, transfers it to `to` and checks for `to` acceptance.\n   271\t     *\n   272\t     * Requirements:\n   273\t     *\n   274\t     * - `tokenId` must not exist.\n   275\t     * - If `to` refers to a smart contract, it must implement {IERC721Receiver-onERC721Received}, which is called upon a safe transfer.\n   276\t     *\n   277\t     * Emits a {Transfer} event.\n   278\t     */\n   279\t    function _safeMint(address to, uint256 tokenId) internal {\n   280\t        _safeMint(to, tokenId, \"\");\n   281\t    }\n   282\t\n   283\t    /**\n   284\t     * @dev Same as {xref-ERC721-_safeMint-address-uint256-}[`_safeMint`], with an additional `data` parameter which is\n   285\t     * forwarded in {IERC721Receiver-onERC721Received} to contract recipients.\n   286\t     */\n   287\t    function _safeMint(address to, uint256 tokenId, bytes memory data) internal virtual {\n   288\t        _mint(to, tokenId);\n   289\t        ERC721Utils.checkOnERC721Received(_msgSender(), address(0), to, tokenId, data);\n   290\t    }\n   291\t\n   292\t    /**\n   293\t     * @dev Destroys `tokenId`.\n   294\t     * The approval is cleared when the token is burned.\n   295\t     * This is an internal function that does not check if the sender is authorized to operate on the token.\n   296\t     *\n   297\t     * Requirements:\n   298\t     *\n   299\t     * - `tokenId` must exist.\n   300\t     *\n   301\t     * Emits a {Transfer} event.\n   302\t     */\n   303\t    function _burn(uint256 tokenId) internal {\n   304\t        address previousOwner = _update(address(0), tokenId, address(0));\n   305\t        if (previousOwner == address(0)) {\n   306\t            revert ERC721NonexistentToken(tokenId);\n   307\t        }\n   308\t    }\n   309\t\n   310\t    /**\n   311\t     * @dev Transfers `tokenId` from `from` to `to`.\n   312\t     *  As opposed to {transferFrom}, this imposes no restrictions on msg.sender.\n   313\t     *\n   314\t     * Requirements:\n   315\t     *\n   316\t     * - `to` cannot be the zero address.\n   317\t     * - `tokenId` token must be owned by `from`.\n   318\t     *\n   319\t     * Emits a {Transfer} event.\n   320\t     */\n   321\t    function _transfer(address from, address to, uint256 tokenId) internal {\n   322\t        if (to == address(0)) {\n   323\t            revert ERC721InvalidReceiver(address(0));\n   324\t        }\n   325\t        address previousOwner = _update(to, tokenId, address(0));\n   326\t        if (previousOwner == address(0)) {\n   327\t            revert ERC721NonexistentToken(tokenId);\n   328\t        } else if (previousOwner != from) {\n   329\t            revert ERC721IncorrectOwner(from, tokenId, previousOwner);\n   330\t        }\n   331\t    }\n   332\t\n   333\t    /**\n   334\t     * @dev Safely transfers `tokenId` token from `from` to `to`, checking that contract recipients\n   335\t     * are aware of the ERC-721 standard to prevent tokens from being forever locked.\n   336\t     *\n   337\t     * `data` is additional data, it has no specified format and it is sent in call to `to`.\n   338\t     *\n   339\t     * This internal function is like {safeTransferFrom} in the sense that it invokes\n   340\t     * {IERC721Receiver-onERC721Received} on the receiver, and can be used to e.g.\n","exit_code":0,"status":"completed"}}
