-decimal units. Basis-point calculations round down through `Math.mulDiv`, and\n     8\t///      the sponsor receives the remaining raw units after winner and protocol allocations.\n     9\t/// @custom:version 1.0.0\n    10\tlibrary RaffleConstants {\n    11\t    /// @notice Denominator used for every global protocol basis-point rate.\n    12\t    uint256 internal constant BPS = 10_000;\n    13\t\n    14\t    /// @notice Global protocol fee rate: 500 basis points, or 5% of gross sales.\n    15\t    uint256 internal constant PROTOCOL_FEE_BPS = 500;\n    16\t\n    17\t    /// @notice Cash-result winner rate: 8,000 basis points, or 80% of gross sales.\n    18\t    uint256 internal constant CASH_WINNER_BPS = 8000;\n    19\t\n    20\t    /// @notice Global entry price: exactly 1,000,000 raw six-decimal quote-token units, or one USDC.\n    21\t    uint256 internal constant ENTRY_PRICE = 1_000_000;\n    22\t\n    23\t    /// @notice Decimal precision required from the immutable quote token.\n    24\t    uint8 internal constant QUOTE_TOKEN_DECIMALS = 6;\n    25\t\n    26\t    /// @notice Refund execution is bounded by tickets, while each ticket may represent any uint128 entry count.\n    27\t    uint256 internal constant MAX_REFUND_TICKET_BATCH_SIZE = 100;\n    28\t\n    29\t    /// @notice Maximum prospective raffle sale duration, measured from creation to the exclusive sale end.\n    30\t    uint256 internal constant MAX_SALE_DURATION = 30 days;\n    31\t\n    32\t    /// @notice Duration after sale end during which a sold raffle may initiate its draw, in seconds.\n    33\t    uint256 internal constant DRAW_REQUEST_TIMEOUT = 2 days;\n    34\t\n    35\t    /// @notice Duration after an accepted request during which its authenticated callback may resolve, in seconds.\n    36\t    uint256 internal constant DRAW_CALLBACK_TIMEOUT = 2 days;\n    37\t\n    38\t    /// @notice Gas-unit limit requested for the single-word Chainlink callback.\n    39\t    uint32 internal constant VRF_CALLBACK_GAS_LIMIT = 300_000;\n    40\t\n    41\t    /// @notice Block confirmations requested from Chainlink before callback fulfillment.\n    42\t    uint16 internal constant VRF_REQUEST_CONFIRMATIONS = 30;\n    43\t}\nrg: packages/contracts/test: IO error for operation on packages/contracts/test: No such file or directory (os error 2)\nrg: packages/contracts/script: IO error for operation on packages/contracts/script: No such file or directory (os error 2)\npackages/contracts/src/RaffleFactory.sol:6:import { IERC721 } from \"@openzeppelin/contracts/token/ERC721/IERC721.sol\";\npackages/contracts/src/RaffleFactory.sol:97:    function createRaffle(CreateRaffleParams calldata params) external override nonReentrant returns (address raffle) {\npackages/contracts/src/RaffleFactory.sol:127:        IERC721 prize = IERC721(params.prizeToken);\npackages/contracts/src/RaffleFactory.sol:172:        try IERC165(params.prizeToken).supportsInterface(type(IERC721).interfaceId) returns (bool supported) {\npackages/contracts/src/interfaces/IRaffle.sol:6:import { IERC721 } from \"@openzeppelin/contracts/token/ERC721/IERC721.sol\";\npackages/contracts/src/interfaces/IRaffle.sol:432:    function prizeToken() external view returns (IERC721 token);\npackages/contracts/src/interfaces/IRaffleFactory.sol:104:    function createRaffle(CreateRaffleParams calldata params) external returns (address raffle);\npackages/contracts/src/Raffle.sol:9:import { ERC721 } from \"@openzeppelin/contracts/token/ERC721/ERC721.sol\";\npackages/contracts/src/Raffle.sol:10:import { IERC721 } from \"@openzeppelin/contracts/token/ERC721/IERC721.sol\";\npackages/contracts/src/Raffle.sol:11:import { IERC721Receiver } from \"@openzeppelin/contracts/token/ERC721/IERC721Receiver.sol\";\npackages/contracts/src/Raffle.sol:28:contract Raffle is IRaffle, ERC721, ReentrancyGuard, IERC721Receiver, VRFV2PlusWrapperConsumerBase {\npackages/contracts/src/Raffle.sol:70:    IERC721 public override prizeToken;\npackages/contr