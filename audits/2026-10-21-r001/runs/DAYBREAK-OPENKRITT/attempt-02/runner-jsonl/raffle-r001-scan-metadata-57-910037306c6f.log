nal virtual {\n   288\t        _mint(to, tokenId);\n   289\t        ERC721Utils.checkOnERC721Received(_msgSender(), address(0), to, tokenId, data);\n   290\t    }\n   291\t\n   292\t    /**\n   293\t     * @dev Destroys `tokenId`.\n   294\t     * The approval is cleared when the token is burned.\n   295\t     * This is an internal function that does not check if the sender is authorized to operate on the token.\n   296\t     *\n   297\t     * Requirements:\n   298\t     *\n   299\t     * - `tokenId` must exist.\n   300\t     *\n   301\t     * Emits a {Transfer} event.\n   302\t     */\n   303\t    function _burn(uint256 tokenId) internal {\n   304\t        address previousOwner = _update(address(0), tokenId, address(0));\n   305\t        if (previousOwner == address(0)) {\n   306\t            revert ERC721NonexistentToken(tokenId);\n   307\t        }\n   308\t    }\n   309\t\n   310\t    /**\n   311\t     * @dev Transfers `tokenId` from `from` to `to`.\n   312\t     *  As opposed to {transferFrom}, this imposes no restrictions on msg.sender.\n   313\t     *\n   314\t     * Requirements:\n   315\t     *\n   316\t     * - `to` cannot be the zero address.\n   317\t     * - `tokenId` token must be owned by `from`.\n   318\t     *\n   319\t     * Emits a {Transfer} event.\n   320\t     */\n   321\t    function _transfer(address from, address to, uint256 tokenId) internal {\n   322\t        if (to == address(0)) {\n   323\t            revert ERC721InvalidReceiver(address(0));\n   324\t        }\n   325\t        address previousOwner = _update(to, tokenId, address(0));\n   326\t        if (previousOwner == address(0)) {\n   327\t            revert ERC721NonexistentToken(tokenId);\n   328\t        } else if (previousOwner != from) {\n   329\t            revert ERC721IncorrectOwner(from, tokenId, previousOwner);\n   330\t        }\n   331\t    }\n   332\t\n   333\t    /**\n   334\t     * @dev Safely transfers `tokenId` token from `from` to `to`, checking that contract recipients\n   335\t     * are aware of the ERC-721 standard to prevent tokens from being forever locked.\n   336\t     *\n   337\t     * `data` is additional data, it has no specified format and it is sent in call to `to`.\n   338\t     *\n   339\t     * This internal function is like {safeTransferFrom} in the sense that it invokes\n   340\t     * {IERC721Receiver-onERC721Received} on the receiver, and can be used to e.g.\n   341\t     * implement alternative mechanisms to perform token transfer, such as signature-based.\n   342\t     *\n   343\t     * Requirements:\n   344\t     *\n   345\t     * - `tokenId` token must exist and be owned by `from`.\n   346\t     * - `to` cannot be the zero address.\n   347\t     * - `from` cannot be the zero address.\n   348\t     * - If `to` refers to a smart contract, it must implement {IERC721Receiver-onERC721Received}, which is called upon a safe transfer.\n   349\t     *\n   350\t     * Emits a {Transfer} event.\n   351\t     */\n   352\t    function _safeTransfer(address from, address to, uint256 tokenId) internal {\n   353\t        _safeTransfer(from, to, tokenId, \"\");\n   354\t    }\n   355\t\n   356\t    /**\n   357\t     * @dev Same as {xref-ERC721-_safeTransfer-address-address-uint256-}[`_safeTransfer`], with an additional `data` parameter which is\n   358\t     * forwarded in {IERC721Receiver-onERC721Received} to contract recipients.\n   359\t     */\n   360\t    function _safeTransfer(address from, address to, uint256 tokenId, bytes memory data) internal virtual {\n   361\t        _transfer(from, to, tokenId);\n   362\t        ERC721Utils.checkOnERC721Received(_msgSender(), from, to, tokenId, data);\n   363\t    }\n   364\t\n   365\t    /**\n   366\t     * @dev Approve `to` to operate on `tokenId`\n   367\t     *\n   368\t     * The `auth` argument is optional. If the value passed is non 0, then this function will check that `auth` is\n   369\t     * either the owner of the token, or approved to operate on all tokens held by this owner.\n   370\t     *\n   371\t     * Emits an {Approval} event.\n   372\t     *\n   373\t     * Overrides to this logic should be done to the variant with an additional `bool emitEvent` argument.\n   374\t     */\n   375\t    function _approve(address to, uint256 tokenId, address auth) internal {\n   376\t        _approve(to, tokenId, auth, true);\n   377\t    }\n   378\t\n   379\t    /**\n   380\t     * @dev Variant of `_approve` with an optional flag to enable or disable the {Approval} event. The event is not\n   381\t     * emitted in the context of transfers.\n   382\t     */\n   383\t    function _approve(address to, uint256 tokenId, address auth, bool emitEvent) internal virtual {\n   384\t        // Avoid reading the owner unless necessary\n   385\t        if (emitEvent || auth != address(0)) {\n   386\t            address owner = _requireOwned(tokenId);\n   387\t\n   388\t            // We do not use _isAuthorized because single-token approvals should not be able to call approve\n   389\t            if (auth != address(0) && owner != auth && !isApprovedForAll(owner, auth)) {\n   390\t                revert ERC721InvalidApprover(auth);\n{\n  \"name\": \"@raffle-fun/contracts\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.13 <23\"\n  },\n  \"scripts\": {\n    \"build\": \"hardhat compile && forge build\",\n    \"compile\": \"hardhat compile\",\n    \"test\": \"pnpm test:foundry && pnpm test:hardhat\",\n    \"test:foundry\": \"forge test\",\n    \"test:hardhat\": \"hardhat test nodejs\",\n    \"coverage\": \"forge coverage --report lcov --no-match-coverage '^(script/|src/mocks/|test/)' && node scripts/check-coverage.mjs\",\n    \"gas\": \"forge snapshot --check -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"gas:update\": \"forge snapshot -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"fmt\": \"forge fmt\",\n    \"fmt:check\": \"forge fmt --check\",\n    \"lint\": \"solhint 'src/**/*.sol' 'test/**/*.sol'\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"slither\": \"slither . --config-file slither.config.json\",\n    \"deploy:sepolia\": \"hardhat ignition deploy ignition/modules/RaffleFun.ts --network sepolia\",\n    \"verify:sepolia\": \"hardhat ignition verify chain-11155111\",\n    \"deployment:write\": \"tsx scripts/write-deployment.ts\"\n  },\n  \"dependencies\": {\n    \"@chainlink/contracts\": \"1.5.0\",\n    \"@openzeppelin/contracts\": \"5.6.1\"\n  },\n  \"devDependencies\": {\n    \"@nomicfoundation/hardhat-ignition\": \"3.1.8\",\n    \"@nomicfoundation/hardhat-ignition-viem\": \"3.1.6\",\n    \"@nomicfoundation/hardhat-toolbox-viem\": \"5.0.7\",\n    \"@types/node\": \"26.1.2\",\n    \"dotenv\": \"17.4.2\",\n    \"hardhat\": \"3.11.1\",\n    \"solhint\": \"6.2.3\",\n    \"tsx\": \"4.23.1\",\n    \"typescript\": \"6.0.3\",\n    \"viem\": \"2.55.10\",\n    \"zod\": \"4.4.3\"\n  }\n}\n[profile.default]\nsrc = \"src\"\ntest = \"test/foundry\"\nscript = \"script\"\nout = \"out\"\nlibs = [\"lib\", \"node_modules\"]\nsolc_version = \"0.8.36\"\nevm_version = \"cancun\"\noptimizer = true\noptimizer_runs = 200\nvia_ir = false\nfuzz = { runs = 1_000, seed = \"0x524146464c45\" }\ninvariant = { runs = 256, depth = 64, fail_on_revert = false }\ngas_reports = [\"Raffle\", \"RaffleFactory\"]\n\n[profile.ci]\nfuzz = { runs = 10_000 }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit]\nfuzz = { runs = 100_000, seed = \"0x41554449545f46555a5a\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = false }\n\n[profile.audit_strict]\nfuzz = { runs = 10_000, seed = \"0x41554449545f535452494354\" }\ninvariant = { runs = 1_000, depth = 256, fail_on_revert = true }\n\n[profile.audit_release]\nfuzz = { runs = 100_000, seed = \"0x52454c454153455f43414d504149474e\" }\ninvariant = { runs = 5_000, depth = 512, fail_on_revert = true, timeout = 3_600 }\n\n[profile.coverage]\nvia_ir = false\noptimizer = false\n\n[profile.comparison]\nvia_ir = true\noptimizer = true\noptimizer_runs = 1_000\n\n[fmt]\nline_length = 120\ntab_width = 4\nbracket_spacing = true\nint_types = \"long\"\nquote_style = \"double\"\nnumber_underscore = \"thousands\"\nsort_imports = true\n# Clean design specification\nEthereum NFT raffle; immutable factory, ERC-1167 clones with immutable implementation. One entry costs 1,000,000 units of canonical six-decimal USDC. One purchase mints a transferable ERC721 ticket representing a contiguous inclusive range. Exactly one ERC721 prize is escrowed atomically at creation. Reserve met awards NFT and 95% sponsor / 5% treasury. Reserve missed awards 80% gross to winner, 15% sponsor, 5% treasury. Refund outcome pays 100% per entry and returns prize. Rounding is floor on aggregate protocol fee; remainder must be allocated without loss. No administrator, mutable configuration or upgrade. Request window [sale end, end+2days); callback accepted strictly before request timestamp+2days. Refunds open at deadline. Callback records result only. Settlement is permissionless, storage-only; redemption requires current ticket owner, burns claim atomically, and must revert all effects on delivery failure. Sponsor and treasury can claim independently after settlement. Never move assets between raffle clones. Quote token and Chainlink wrapper are trusted canonical dependencies; arbitrary prize contracts and ticket recipients are untrusted. Frontend discovery is advisory; transaction decisions must reread current chain state.\n\nThis specification was composed before scanner results and historical findings. Source, not design prose, determines actual behavior. No tests, audit history, accepted-risk lists or scanner results are provided.\n","exit_code":0,"status":"completed"}}
