ol:26:        /// @notice A Chainlink VRF request was accepted and its callback window is open.\npackages/contracts/src/interfaces/IRaffle.sol:88:    /// @param callbackDeadline Exclusive Unix-timestamp deadline for accepting the authenticated callback.\npackages/contracts/src/interfaces/IRaffle.sol:95:        uint256 callbackDeadline\npackages/contracts/src/interfaces/IRaffle.sol:98:    /// @notice Emitted when an authenticated, ABI-decodable callback cannot resolve the raffle.\npackages/contracts/src/interfaces/IRaffle.sol:99:    /// @param receivedRequestId Request ID supplied by the wrapper callback.\npackages/contracts/src/interfaces/IRaffle.sol:101:    /// @param status Current raffle status when the callback is ignored.\npackages/contracts/src/interfaces/IRaffle.sol:104:    /// @notice Emitted when an authenticated callback selects the winning entry and final result.\npackages/contracts/src/interfaces/IRaffle.sol:197:    /// @notice Raised when an ERC-721 receiver callback does not exactly match the configured factory prize deposit.\npackages/contracts/src/interfaces/IRaffle.sol:198:    /// @param token ERC-721 contract that invoked the receiver callback.\npackages/contracts/src/interfaces/IRaffle.sol:199:    /// @param tokenId Token ID supplied by the callback.\npackages/contracts/src/interfaces/IRaffle.sol:314:    function buyEntries(address recipient, uint128 entryCount) external returns (uint256 ticketId);\npackages/contracts/src/interfaces/IRaffle.sol:318:    ///      value above the wrapper's actual fee is returned to the caller atomically.\npackages/contracts/src/interfaces/IRaffle.sol:322:    /// @notice Enables full refunds after the sold-raffle request deadline or an accepted request's callback deadline.\npackages/contracts/src/interfaces/IRaffle.sol:333:    /// @notice Lets the current winning-ticket owner atomically burn the ticket and receive the NFT or cash prize.\npackages/contracts/src/interfaces/IRaffle.sol:359:    /// @notice Returns the wrapper's current native direct-funding price for the configured callback.\npackages/contracts/src/interfaces/IRaffle.sol:365:    /// @return fee Estimated native-token wei for the configured callback and one random word.\npackages/contracts/src/interfaces/IRaffle.sol:379:    /// @notice Returns the exclusive deadline for accepting the authenticated callback.\npackages/contracts/src/interfaces/IRaffle.sol:381:    function callbackDeadline() external view returns (uint256 deadline);\npackages/contracts/src/interfaces/IRaffle.sol:398:    /// @notice Returns the fixed Chainlink callback execution limit.\npackages/contracts/src/interfaces/IRaffle.sol:400:    function callbackGasLimit() external view returns (uint32 gasLimit);\npackages/contracts/src/interfaces/IRaffle.sol:403:    /// @return confirmations Blocks requested before callback fulfillment.\npackages/contracts/src/interfaces/IRaffle.sol:490:    /// @notice Returns when an authenticated callback resolved the raffle.\npackages/contracts/src/interfaces/IRaffleFactory.sol:6:/// @notice Defines atomic ERC-1167 raffle creation for one immutable USDC, treasury, and Chainlink configuration.\npackages/contracts/src/interfaces/IRaffleFactory.sol:17:    /// @param prizeTokenId Token ID to escrow atomically during creation.\npackages/contracts/src/interfaces/IRaffleFactory.sol:101:    /// @notice Creates, initializes, registers, and funds one autonomous fixed-target raffle clone atomically.\npackages/contracts/src/interfaces/IRaffleFactory.sol:120:    /// @notice Returns the fixed Chainlink callback execution limit used by every raffle.\npackages/contracts/src/interfaces/IRaffleFactory.sol:122:    function callbackGasLimit() external view returns (uint32 gasLimit);\npackages/contracts/src/interfaces/IRaffleFactory.sol:125:    /// @return confirmations Blocks requested before callback fulfillment.\npackages/contracts/src/Raffle.sol:23:///      callbacks, and winner proofs are O(1) in entry count. Tickets remain transferable bearer claims until their\npackages/contracts/src/Raffle.sol:26:///      atomically burns the ticket while receiving the NFT or cash prize.\npackages/contracts/src/Raffle.sol:47:    uint32 public constant override callbackGasLimit = RaffleConstants.VRF_CALLBACK_GAS_LIMIT;\npackages/contracts/src/Raffle.sol:141:    /// @dev True only while the wrapper request call is executing, so a synchronous callback cannot resolve early.\npackages/contracts/src/Raffle.sol:209:    function buyEntries(address recipient, uint128 entryCount)\npackages/contracts/src/Raffle.sol:235:        _safeMint(recipient, ticketId);\npackages/contracts/src/Raffle.sol:257:        (requestId, paidPrice) = requestRandomnessPayInNative(callbackGasLimit, requestConfirmations, 1, extraArgs);\npackages/contracts/src/Raffle.sol:272:        emit DrawRequested(requestId, msg.sender, paidPrice, excess, drawRequestedAt, callbackDeadline());\npackages/contracts/src/Raffle.sol:290:            deadline = callbackDeadline();\npackages/contracts/src/Raffle.sol:415:    /// @return selector ERC-721 receiver acceptance selector.\npackages/contracts/src/Raffle.sol:437:        fee = i_vrfV2PlusWrapper.calculateRequestPriceNative(callbackGasLimit, 1);\npackages/contracts/src/Raffle.sol:442:        fee = i_vrfV2PlusWrapper.estimateRequestPriceNative(callbackGasLimit, 1, requestGasPriceWei);\npackages/contracts/src/Raffle.sol:463:    function callbackDeadline() public view override returns (uint256 deadline) {\npackages/contracts/src/Raffle.sol:505:    ///      occurs. In-flight, late, wrong-request, duplicate, and ABI-decodable wrong-length callbacks are ignored for\npackages/contracts/src/Raffle.sol:507:    /// @param requestId Wrapper-authenticated request identifier supplied by the callback.\npackages/contracts/src/Raffle.sol:512:                || block.timestamp >= callbackDeadline()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/src/RaffleFactory.sol | sed -n '1,260p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/ERC721.sol | sed -n '1,220p;270,390p'; cat packages/contracts/package.json; cat packages/contracts/foundry.toml; cat DESIGN.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/contracts/src/RaffleFactory.sol | sed -n '1,260p'; nl -ba packages/contracts/node_modules/@openzeppelin/contracts/token/ERC721/ERC721.sol | sed -n '1,220p;270,390p'; cat packages/contracts/package.json; cat packages/contracts/foundry.toml; cat DESIGN.md\"","aggregated_output":"     1\t// SPDX-License-Identifier: MIT\n     2\tpragma solidity 0.8.36;\n     3\t\n     4\timport { Clones } from \"@openzeppelin/contracts/proxy/Clones.sol\";\n     5\timport { IERC20Metadata } from \"@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol\";\n     6\timport { IERC721 } from \"@openzeppelin/contracts/token/ERC721/IERC721.sol\";\n     7\timport { ReentrancyGuard } from \"@openzeppelin/contracts/utils/ReentrancyGuard.sol\";\n     8\timport { IERC165 } from \"@openzeppelin/contracts/utils/introspection/IERC165.sol\";\n     9\t\n    10\timport { Raffle } from \"./Raffle.sol\";\n    11\timport { IRaffle } from \"./interfaces/IRaffle.sol\";\n    12\timport { IRaffleFactory } from \"./interfaces/IRaffleFactory.sol\";\n    13\timport { RaffleConstants } from \"./libraries/RaffleConstants.sol\";\n    14\t\n    15\t/// @title raffle.fun Canonical USDC Raffle Factory\n    16\t/// @author heesho\n    17\t/// @notice Atomically creates, funds, and registers autonomous fixed-implementation raffle clones.\n    18\t/// @dev The implementation, canonical six-decimal USDC, treasury, fee, and Chainlink configuration are immutable. The\n    19\t///      factory has no owner, pause, upgrade, rescue, or mutable protocol configuration.\n    20\t/// @custom:version 1.0.0\n    21\tcontract RaffleFactory is IRaffleFactory, ReentrancyGuard {\n    22\t    // Constants\n    23\t\n    24\t    /// @inheritdoc IRaffleFactory\n    25\t    uint32 public constant override callbackGasLimit = RaffleConstants.VRF_CALLBACK_GAS_LIMIT;\n    26\t\n    27\t    /// @inheritdoc IRaffleFactory\n    28\t    uint16 public constant override requestConfirmations = RaffleConstants.VRF_REQUEST_CONFIRMATIONS;\n    29\t\n    30\t    // Immutables and state\n    31\t\n    32\t    /// @inheritdoc IRaffleFactory\n    33\t    address public immutable override quoteToken;\n    34\t\n    35\t    /// @inheritdoc IRaffleFactory\n    36\t    address public immutable override vrfWrapper;\n    37\t\n    38\t    /// @inheritdoc IRaffleFactory\n    39\t    address public immutable override protocolTreasury;\n    40\t\n    41\t    /// @inheritdoc IRaffleFactory\n    42\t    address public immutable override raffleImplementation;\n    43\t\n    44\t    /// @inheritdoc IRaffleFactory\n    45\t    uint256 public override raffleCount;\n    46\t\n    47\t    /// @inheritdoc IRaffleFactory\n    48\t    mapping(uint256 raffleId => address raffle) public override raffleById;\n    49\t\n    50\t    /// @inheritdoc IRaffleFactory\n    51\t    mapping(address raffle => uint256 raffleId) public override idByRaffle;\n    52\t\n    53\t    /// @inheritdoc IRaffleFactory\n    54\t    mapping(address raffle => bool registered) public override isRaffle;\n    55\t\n    56\t    // Constructor\n    57\t\n    58\t    /// @notice Deploys the ownerless factory and its locked raffle implementation with one immutable configuration.\n    59\t    /// @dev The quote token must report exactly six decimals; the wrapper and quote token must contain deployed code.\n    60\t    ///      Deployment tooling must supply and verify the target chain's official USDC address because the constructor\n    61\t    ///      cannot prove token identity from metadata.\n    62\t    /// @param quoteToken_ Target chain's official six-decimal USDC contract trusted by every raffle.\n    63\t    /// @param vrfWrapper_ Official Chainlink VRF v2.5 native direct-funding wrapper for the target chain.\n    64\t    /// @param protocolTreasury_ Immutable protocol-fee recipient used by every raffle.\n    65\t    constructor(address quoteToken_, address vrfWrapper_, address protocolTreasury_) {\n    66\t        _requireContract(quoteToken_);\n    67\t        _requireContract(vrfWrapper_);\n    68\t        if (protocolTreasury_ == address(0)) revert ZeroAddress();\n    69\t\n    70\t        uint8 quoteDecimals = 0;\n    71\t        try IERC20Metadata(quoteToken_).decimals() returns (uint8 decimals_) {\n    72\t            quoteDecimals = decimals_;\n    73\t        } catch {\n    74\t            revert UnsupportedQuoteToken(quoteToken_);\n    75\t        }\n    76\t        if (quoteDecimals != RaffleConstants.QUOTE_TOKEN_DECIMALS) {\n    77\t            revert InvalidQuoteTokenDecimals(quoteDecimals, RaffleConstants.QUOTE_TOKEN_DECIMALS);\n    78\t        }\n    79\t\n    80\t        if (protocolTreasury_ == address(this) || protocolTreasury_ == quoteToken_ || protocolTreasury_ == vrfWrapper_)\n    81\t        {\n    82\t            revert UnsafeProtocolDestination(protocolTreasury_);\n    83\t        }\n    84\t\n    85\t        quoteToken = quoteToken_;\n    86\t        vrfWrapper = vrfWrapper_;\n    87\t        protocolTreasury = protocolTreasury_;\n    88\t\n    89\t        address implementation = address(new Raffle(quoteToken_, vrfWrapper_));\n    90\t        if (protocolTreasury_ == implementation) revert UnsafeProtocolDestination(protocolTreasury_);\n    91\t        raffleImplementation = implementation;\n    92\t    }\n    93\t\n    94\t    // External state-changing functions\n    95\t\n    96\t    /// @inheritdoc IRaffleFactory\n    97\t    function createRaffle(CreateRaffleParams calldata params) external override nonReentrant returns (address raffle) {\n    98\t        _validateCreateParams(params);\n    99\t        uint256 currentTime = block.timestamp;\n   100\t        if (params.endTime <= currentTime) revert InvalidEndTime(currentTime, params.endTime);\n   101\t        uint256 saleDuration = uint256(params.endTime) - currentTime;\n   102\t        if (saleDuration > RaffleConstants.M