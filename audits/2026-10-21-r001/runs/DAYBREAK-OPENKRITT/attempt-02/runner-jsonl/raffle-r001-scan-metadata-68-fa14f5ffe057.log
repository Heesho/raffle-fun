 100\t    }\n   101\t\n   102\t    function _nonReentrantAfter() private {\n   103\t        // By storing the original value once again, a refund is triggered (see\n   104\t        // https://eips.ethereum.org/EIPS/eip-2200)\n   105\t        _reentrancyGuardStorageSlot().getUint256Slot().value = NOT_ENTERED;\n   106\t    }\n   107\t\n   108\t    /**\n   109\t     * @dev Returns true if the reentrancy guard is currently set to \"entered\", which indicates there is a\n   110\t     * `nonReentrant` function in the call stack.\n# Dependency Workspace\n\nCurrent working directory / primary repository root: /workspace\nWorkspace manifest: WORKSPACE.json\nDependency repositories are checked out as top-level directories inside the same workspace root.\nWhen reporting file_path for dependency code, prefix it with the dependency alias directory.\nPrimary repository: clean-context @ LOCAL_SNAPSHOT\nNo dependency checkouts are listed in WORKSPACE.json.\n\nPath guidance:\n- Reference primary repo files relative to the workspace root.\n- Reference dependency files with their dependency directory prefix, e.g. `agave/...`.\n{\n  \"name\": \"@raffle-fun/contracts\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.13 <23\"\n  },\n  \"scripts\": {\n    \"build\": \"hardhat compile && forge build\",\n    \"compile\": \"hardhat compile\",\n    \"test\": \"pnpm test:foundry && pnpm test:hardhat\",\n    \"test:foundry\": \"forge test\",\n    \"test:hardhat\": \"hardhat test nodejs\",\n    \"coverage\": \"forge coverage --report lcov --no-match-coverage '^(script/|src/mocks/|test/)' && node scripts/check-coverage.mjs\",\n    \"gas\": \"forge snapshot --check -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"gas:update\": \"forge snapshot -j 1 --no-match-test '^(testFuzz|invariant)'\",\n    \"fmt\": \"forge fmt\",\n    \"fmt:check\": \"forge fmt --check\",\n    \"lint\": \"solhint 'src/**/*.sol' 'test/**/*.sol'\",\n    \