Added tests/gas-reports-compatibility.test.ts:
import { test } from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { setup } from './helpers.ts';
import { snapshot, diagnose } from '../packages/core/src/intake.ts';
test('copied controller preserves gas_reports and rejects malformed settings', () => {
  const c = setup();
  try {
    const file = join(c.root, 'foundry.toml');
    const original = readFileSync(file, 'utf8');
    for (const [value, supported] of [
      ['[\"Raffle\", \"RaffleFactory\"]', true],
      ['[1]', false],
    ] as const) {
      writeFileSync(file, original + '\ngas_reports = ' + value + '\n');
      const snap = snapshot(
        c.store,
        c.root,
        ['src', 'test', 'foundry.toml'],
        [],
        'Fixture',
        'owned',
      );
      const diagnosis = diagnose(c.store, snap);
      assert.equal(diagnosis.supported, supported);
      if (supported) assert.deepEqual(diagnosis.settings.gas_reports, ['Raffle', 'RaffleFactory']);
    }
  } finally {
    c.cleanup();
  }
});
